{
  "title": "VOLUME AND SURFACE AREA,\n(SURFACE AREA OF PRISMS)",
  "objective": "LO: I can calculate the surface area of prisms by finding the area of each face.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Surface area of prisms",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">prism</span> has a uniform cross-section. Its <span class=\"ul-k\">surface area</span> is the total area of all faces: two identical end faces plus rectangular side faces."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Method:</span> Draw the net. Find the area of each face. Add them all together."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "Cuboid SA = 2(lw + lh + wh)",
          "desc": "three pairs of faces"
        },
        {
          "correct": true,
          "expr": "Triangular prism: 2 triangles + 3 rectangles",
          "desc": "5 faces total"
        },
        {
          "correct": true,
          "expr": "SA = 2 &times; cross-section + perimeter &times; length",
          "desc": "general formula"
        },
        {
          "correct": false,
          "expr": "SA = cross-section &times; length",
          "desc": "that is volume"
        },
        {
          "correct": false,
          "expr": "All faces of a prism are rectangles",
          "desc": "end faces match cross-section"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "SA = 2 &times; (area of cross-section) + (perimeter of cross-section) &times; length.",
      "equation": "SA = <span class=\"ov\">2A</span> + <span class=\"ovr\">P &times; l</span>",
      "caption": "A = cross-section area, P = perimeter, l = length"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; cuboid",
      "question": "Find the SA of a cuboid 5 cm &times; 3 cm &times; 4 cm.",
      "steps": [
        "SA = 2(5&times;3 + 5&times;4 + 3&times;4)",
        "= 2(15 + 20 + 12)",
        "= 2 &times; 47 = 94 cm&sup2;"
      ],
      "answer": "94 cm&sup2;",
      "explanation": "A cuboid has 3 pairs of rectangular faces."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; triangular prism",
      "question": "Find SA: triangle base 6, height 4, slant sides 5, length 10.",
      "steps": [
        "2 triangles: 2 &times; &frac{1}{2}(6)(4) = 24",
        "3 rectangles: 6&times;10 + 5&times;10 + 5&times;10 = 160",
        "Total = 24 + 160 = 184 cm&sup2;"
      ],
      "answer": "184 cm&sup2;",
      "explanation": "Find area of each face and add."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; L-shaped prism",
      "question": "An L-shape cross-section has area 20 cm&sup2; and perimeter 24 cm. Length = 8 cm.",
      "steps": [
        "End faces: 2 &times; 20 = 40",
        "Side faces: 24 &times; 8 = 192",
        "Total = 232 cm&sup2;"
      ],
      "answer": "232 cm&sup2;",
      "explanation": "Use the general formula for any prism."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; hexagonal prism",
      "question": "Regular hexagon: side 3 cm, area 23.4 cm&sup2;. Length 7 cm.",
      "steps": [
        "2 hexagons: 2 &times; 23.4 = 46.8",
        "Perimeter = 6 &times; 3 = 18; sides: 18 &times; 7 = 126",
        "Total = 172.8 cm&sup2;"
      ],
      "answer": "172.8 cm&sup2;",
      "explanation": "Perimeter of hexagon = 6 &times; side."
    }
  ],
