{
  "title": "ALGEBRAIC FRACTIONS,\n(ADDING AND SUBTRACTING ALGEBRAIC FRACTIONS)",
  "objective": "LO: I can add and subtract algebraic fractions by finding a common denominator.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What are algebraic fractions?",
      "content": [
        {
          "type": "paragraph",
          "text": "An <span class=\"ul-b\">algebraic fraction</span> has a variable (letter) in the numerator, denominator, or both. To <span class=\"ul-k\">add or subtract</span> them, we need a common denominator, just like with number fractions."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Find the LCM of the denominators, convert each fraction, then add or subtract the numerators."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&frac{1}{x} + &frac{2}{x} = &frac{3}{x}",
          "desc": "same denominator"
        },
        {
          "correct": true,
          "expr": "&frac{1}{x} + &frac{1}{y} = &frac{y + x}{xy}",
          "desc": "different denominators"
        },
        {
          "correct": true,
          "expr": "&frac{2}{x+1} + &frac{3}{x+2} = &frac{2(x+2)+3(x+1)}{(x+1)(x+2)}",
          "desc": "linear denominators"
        },
        {
          "correct": false,
          "expr": "&frac{1}{x} + &frac{1}{y} = &frac{2}{x+y}",
          "desc": "cannot add denominators"
        },
        {
          "correct": false,
          "expr": "&frac{2}{x} + &frac{3}{x} = &frac{5}{2x}",
          "desc": "denominator stays the same"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Find the lowest common denominator (LCD), rewrite each fraction over the LCD, then combine the numerators.",
      "equation": "&frac{a}{x} + &frac{b}{y} = <span class=\"ov\">&frac{ay + bx}{xy}</span>",
      "caption": "Cross-multiply to find common denominator xy"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; same denominator",
      "question": "Simplify &frac{3}{x} + &frac{5}{x}",
      "steps": [
        "Denominators are the same: x",
        "Add numerators: 3 + 5 = 8",
        "Answer: &frac{8}{x}"
      ],
      "answer": "&frac{8}{x}",
      "explanation": "When denominators match, simply add the numerators."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; different single-term denominators",
      "question": "Simplify &frac{2}{x} + &frac{3}{y}",
      "steps": [
        "LCD = xy",
        "Rewrite: &frac{2y}{xy} + &frac{3x}{xy}",
        "Combine: &frac{2y + 3x}{xy}"
      ],
      "answer": "&frac{2y + 3x}{xy}",
      "explanation": "Multiply each fraction by the other denominator over itself."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; linear denominators",
      "question": "Simplify &frac{1}{x + 1} + &frac{2}{x + 3}",
      "steps": [
        "LCD = (x + 1)(x + 3)",
        "Rewrite: &frac{1(x+3) + 2(x+1)}{(x+1)(x+3)}",
        "Expand: &frac{x + 3 + 2x + 2}{(x+1)(x+3)} = &frac{3x + 5}{(x+1)(x+3)}"
      ],
      "answer": "&frac{3x + 5}{(x+1)(x+3)}",
      "explanation": "Expand the numerators carefully, then collect like terms."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; subtraction",
      "question": "Simplify &frac{5}{x+2} &minus; &frac{3}{x+1}",
      "steps": [
        "LCD = (x+2)(x+1)",
        "Rewrite: &frac{5(x+1) &minus; 3(x+2)}{(x+2)(x+1)}",
        "Expand: &frac{5x+5 &minus; 3x &minus; 6}{(x+2)(x+1)} = &frac{2x &minus; 1}{(x+2)(x+1)}"
      ],
      "answer": "&frac{2x &minus; 1}{(x+2)(x+1)}",
      "explanation": "With subtraction, distribute the minus sign carefully."
    }
  ],
