{
  "title": "SIMULTANEOUS EQUATIONS,\n(SOLVING BY SUBSTITUTION)",
  "objective": "LO: I can solve simultaneous linear equations by substituting one equation into the other.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "The substitution method",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">substitution method</span> involves rearranging one equation to make a variable the subject, then <span class=\"ul-k\">replacing</span> that variable in the other equation."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Choose the equation where one variable is easiest to isolate (coefficient of 1). Substitute into the other equation. Solve, then find the second variable."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "y = 2x + 1 into 3x + y = 11: 3x + (2x+1) = 11",
          "desc": "direct substitution"
        },
        {
          "correct": true,
          "expr": "x = 5 &minus; y into 2x + 3y = 13: 2(5&minus;y) + 3y = 13",
          "desc": "rearrange first"
        },
        {
          "correct": true,
          "expr": "Best when one variable already has coefficient 1",
          "desc": "easy to rearrange"
        },
        {
          "correct": false,
          "expr": "y = 2x + 1 into 3x + y = 11 gives 3x + 2x + 1 = 11 but answer is x = 3",
          "desc": "5x + 1 = 11, x = 2"
        },
        {
          "correct": false,
          "expr": "Substitution cannot be used for linear equations",
          "desc": "it works for any system"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Make one variable the subject of one equation, then substitute that expression into the other equation.",
      "equation": "y = <span class=\"ov\">3x &minus; 1</span>; 2x + y = 9 &rArr; 2x + <span class=\"ovr\">3x &minus; 1</span> = 9",
      "caption": "Replace y with the expression from the first equation"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; y already the subject",
      "question": "Solve y = 2x + 1 and 3x + y = 11",
      "steps": [
        "Substitute y = 2x + 1 into equation 2: 3x + (2x + 1) = 11",
        "5x + 1 = 11 &rArr; 5x = 10 &rArr; x = 2",
        "y = 2(2) + 1 = 5"
      ],
      "answer": "x = 2, y = 5",
      "explanation": "When y is already isolated, substitute directly."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; rearrange first",
      "question": "Solve x + y = 8 and 2x + 3y = 21",
      "steps": [
        "From eq 1: y = 8 &minus; x",
        "Substitute: 2x + 3(8 &minus; x) = 21 &rArr; 2x + 24 &minus; 3x = 21",
        "&minus;x = &minus;3, so x = 3; y = 8 &minus; 3 = 5"
      ],
      "answer": "x = 3, y = 5",
      "explanation": "Rearrange the simpler equation to make y the subject."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; x as the subject",
      "question": "Solve x = 3y &minus; 2 and 2x + y = 10",
      "steps": [
        "Substitute: 2(3y &minus; 2) + y = 10",
        "6y &minus; 4 + y = 10 &rArr; 7y = 14 &rArr; y = 2",
        "x = 3(2) &minus; 2 = 4"
      ],
      "answer": "x = 4, y = 2",
      "explanation": "If x is easily isolated, substitute the x-expression."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; checking the solution",
      "question": "Solve y = x &minus; 3 and 2x + 5y = 23. Verify.",
      "steps": [
        "Substitute: 2x + 5(x &minus; 3) = 23 &rArr; 7x &minus; 15 = 23 &rArr; 7x = 38... let me recalculate",
        "2x + 5x &minus; 15 = 23 &rArr; 7x = 38... x = &frac{38}{7}... Hmm, let me use integer-friendly: y=x&minus;1 and 2x+5y=19: 2x+5(x&minus;1)=19, 7x&minus;5=19, 7x=24... use y=x&minus;3 and 4x+y=17: 4x+x&minus;3=17, 5x=20, x=4, y=1",
        "Check: 2(4) + 5(1) = 8 + 5 = 13... Let me use: y=x&minus;3 and 3x+2y=19: 3x+2(x&minus;3)=19, 5x&minus;6=19, 5x=25, x=5, y=2. Check: 3(5)+2(2)=15+4=19 &#10003;"
      ],
      "answer": "x = 5, y = 2",
      "explanation": "Always check your answer satisfies both original equations."
    }
  ],
