{
  "title": "DECIMALS,\n(ROUNDING DECIMALS TO DECIMAL PLACES)",
  "objective": "LO: I can round decimal numbers to a given number of decimal places.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Rounding to decimal places",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Rounding</span> to decimal places (d.p.) means shortening a decimal to a given number of digits after the <span class=\"ul-k\">decimal point</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Rule:</span> Look at the NEXT digit. If it is 5 or more, round up. If less than 5, round down (keep the same)."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Examples",
      "examples": [
        {
          "correct": true,
          "expr": "3.147 to 1 d.p. = 3.1",
          "desc": "4 &lt; 5, round down"
        },
        {
          "correct": true,
          "expr": "3.147 to 2 d.p. = 3.15",
          "desc": "7 &ge; 5, round up"
        },
        {
          "correct": true,
          "expr": "6.998 to 2 d.p. = 7.00",
          "desc": "rounds up to 7.00"
        },
        {
          "correct": false,
          "expr": "3.147 to 1 d.p. = 3.2",
          "desc": "look at 4, not 7"
        },
        {
          "correct": false,
          "expr": "6.998 to 2 d.p. = 6.10",
          "desc": "should be 7.00"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Look at the digit AFTER the one you want. 5 or above: round up. Below 5: round down.",
      "equation": "<span class=\"ov\">3.147</span> to 2 d.p. &rarr; look at 7 (third d.p.) &ge; 5 &rarr; <span class=\"ovr\">3.15</span>",
      "caption": "Critical digit decides"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; rounding to 1 d.p.",
      "question": "Round 4.63 to 1 decimal place.",
      "steps": [
        "We want 1 d.p.: keep one digit after the point",
        "Look at the 2nd d.p.: 3",
        "3 &lt; 5, so round down: 4.6"
      ],
      "answer": "= 4.6",
      "explanation": "The digit after is 3 (less than 5), so we keep 4.6."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; rounding to 2 d.p.",
      "question": "Round 7.386 to 2 decimal places.",
      "steps": [
        "We want 2 d.p.: keep two digits after the point",
        "Look at the 3rd d.p.: 6",
        "6 &ge; 5, so round up: 7.39"
      ],
      "answer": "= 7.39",
      "explanation": "The 6 forces the previous digit (8) to round up to 9."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; rounding up carries",
      "question": "Round 2.997 to 2 decimal places.",
      "steps": [
        "Look at 3rd d.p.: 7 &ge; 5, round up",
        "2.99 rounds up to 3.00",
        "= 3.00"
      ],
      "answer": "= 3.00",
      "explanation": "Rounding can carry through: 2.99 + 0.01 = 3.00."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; to 3 d.p.",
      "question": "Round 0.12345 to 3 decimal places.",
      "steps": [
        "Want 3 d.p.: look at 4th digit: 4",
        "4 &lt; 5, round down",
        "= 0.123"
      ],
      "answer": "= 0.123",
      "explanation": "The fourth decimal digit (4) is less than 5."
    }
  ],
