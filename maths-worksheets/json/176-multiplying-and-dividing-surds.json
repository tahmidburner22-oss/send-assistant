{
  "title": "SURDS,\n(MULTIPLYING AND DIVIDING SURDS)",
  "objective": "LO: I can multiply and divide surds, simplifying where possible.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Multiplying and dividing surds",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"ul-b\">multiply</span> surds: &radic;a &times; &radic;b = &radic;(ab). To <span class=\"ul-b\">divide</span>: &radic;a &divide; &radic;b = &radic;(a/b). Always <span class=\"ul-k\">simplify</span> the result."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Key fact:</span> &radic;a &times; &radic;a = a. This is useful for rationalising and expanding brackets."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&radic;3 &times; &radic;5 = &radic;15",
          "desc": "multiply radicands"
        },
        {
          "correct": true,
          "expr": "&radic;6 &times; &radic;6 = 6",
          "desc": "same surd squared"
        },
        {
          "correct": true,
          "expr": "&radic;20 &divide; &radic;5 = &radic;4 = 2",
          "desc": "divide radicands"
        },
        {
          "correct": false,
          "expr": "&radic;3 &times; &radic;5 = &radic;8",
          "desc": "multiply, not add: &radic;15"
        },
        {
          "correct": false,
          "expr": "2&radic;3 &times; 4&radic;3 = 8&radic;9",
          "desc": "= 8 &times; 3 = 24"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiply: &radic;a &times; &radic;b = &radic;(ab). Divide: &radic;a &divide; &radic;b = &radic;(a/b). Simplify the result.",
      "equation": "&radic;a &times; &radic;b = <span class=\"ov\">&radic;(ab)</span> | &radic;a &divide; &radic;b = <span class=\"ovr\">&radic;(a/b)</span>",
      "caption": "Always simplify the final answer"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; multiplying surds",
      "question": "Simplify &radic;3 &times; &radic;12.",
      "steps": [
        "&radic;3 &times; &radic;12 = &radic;(3 &times; 12)",
        "= &radic;36",
        "= 6"
      ],
      "answer": "6",
      "explanation": "Multiply the numbers under the root, then simplify."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; with coefficients",
      "question": "Simplify 2&radic;5 &times; 3&radic;2.",
      "steps": [
        "Multiply coefficients: 2 &times; 3 = 6",
        "Multiply surds: &radic;5 &times; &radic;2 = &radic;10",
        "= 6&radic;10"
      ],
      "answer": "6&radic;10",
      "explanation": "Multiply the numbers outside together and the surds together."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; dividing surds",
      "question": "Simplify &radic;72 &divide; &radic;2.",
      "steps": [
        "&radic;72 &divide; &radic;2 = &radic;(72/2)",
        "= &radic;36",
        "= 6"
      ],
      "answer": "6",
      "explanation": "Divide the radicands, then simplify."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; expanding brackets",
      "question": "Expand and simplify &radic;3(2 + &radic;3).",
      "steps": [
        "&radic;3 &times; 2 = 2&radic;3",
        "&radic;3 &times; &radic;3 = 3",
        "= 2&radic;3 + 3"
      ],
      "answer": "2&radic;3 + 3",
      "explanation": "Distribute the surd across the bracket."
    }
  ],
