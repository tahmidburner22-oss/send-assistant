{
  "title": "FRACTIONS (SECONDARY),\n(MULTIPLYING FRACTIONS)",
  "objective": "LO: I can multiply fractions and mixed numbers, simplifying my answers.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Multiplying fractions",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"ul-b\">multiply fractions</span>, multiply the <span class=\"ul-k\">numerators</span> together and the <span class=\"ul-k\">denominators</span> together. Simplify at the end (or cancel first)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Tip:</span> Cross-cancel before multiplying to keep numbers small. Convert mixed numbers to improper fractions first."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key method",
      "examples": [
        {
          "correct": true,
          "expr": "&frac{2}{3} &times; &frac{4}{5} = &frac{8}{15}",
          "desc": "multiply across"
        },
        {
          "correct": true,
          "expr": "&frac{3}{4} &times; &frac{2}{3} = &frac{1}{2}",
          "desc": "cancel 3s first"
        },
        {
          "correct": true,
          "expr": "1&frac{1}{2} &times; &frac{2}{3} = &frac{3}{2} &times; &frac{2}{3} = 1",
          "desc": "convert then multiply"
        },
        {
          "correct": false,
          "expr": "&frac{2}{3} &times; &frac{4}{5} = &frac{6}{8}",
          "desc": "added instead of multiplied"
        },
        {
          "correct": false,
          "expr": "&frac{2}{3} &times; &frac{4}{5} = &frac{8}{5}",
          "desc": "only multiplied tops"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiply tops together, multiply bottoms together. Cancel common factors for simpler working.",
      "equation": "<span class=\"ov\">&frac{a}{b}</span> &times; <span class=\"ov\">&frac{c}{d}</span> = <span class=\"ovr\">&frac{a&times;c}{b&times;d}</span>",
      "caption": "Straight across: top &times; top, bottom &times; bottom"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; simple multiplication",
      "question": "Calculate &frac{2}{5} &times; &frac{3}{4}",
      "steps": [
        "Multiply numerators: 2 &times; 3 = 6",
        "Multiply denominators: 5 &times; 4 = 20",
        "&frac{6}{20} = &frac{3}{10}"
      ],
      "answer": "= &frac{3}{10}",
      "explanation": "Simplify by dividing top and bottom by 2."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; cancelling first",
      "question": "Calculate &frac{3}{8} &times; &frac{4}{9}",
      "steps": [
        "Cancel: 3 and 9 share factor 3; 4 and 8 share factor 4",
        "&frac{1}{2} &times; &frac{1}{3}",
        "= &frac{1}{6}"
      ],
      "answer": "= &frac{1}{6}",
      "explanation": "Cross-cancel before multiplying keeps numbers small."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; fraction of a whole number",
      "question": "Calculate &frac{3}{4} &times; 20",
      "steps": [
        "Write 20 as &frac{20}{1}",
        "Cancel: 20 and 4 share factor 4 &rarr; &frac{3}{1} &times; &frac{5}{1}",
        "= 15"
      ],
      "answer": "= 15",
      "explanation": "3/4 of 20: divide by 4 (=5), multiply by 3 (=15)."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; mixed numbers",
      "question": "Calculate 1&frac{2}{3} &times; 2&frac{1}{4}",
      "steps": [
        "Convert: &frac{5}{3} &times; &frac{9}{4}",
        "Cancel: 9 and 3 share 3 &rarr; &frac{5}{1} &times; &frac{3}{4}",
        "= &frac{15}{4} = 3&frac{3}{4}"
      ],
      "answer": "= 3&frac{3}{4}",
      "explanation": "Always convert mixed numbers to improper fractions before multiplying."
    }
  ],
