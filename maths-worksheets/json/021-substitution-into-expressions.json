{
  "title": "ALGEBRAIC EXPRESSIONS,\n(SUBSTITUTION INTO EXPRESSIONS)",
  "objective": "LO: I can substitute given values into algebraic expressions and evaluate the result.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What does &lsquo;substitute&rsquo; mean?",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Substitution</span> means replacing a <span class=\"ul-k\">letter</span> with a given number, then working out the value of the expression."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Remember:</span> 2x means 2 &times; x. When we write letters next to numbers or other letters, multiplication is implied."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "If x = 3, then 2x = 6",
          "desc": "2 &times; 3"
        },
        {
          "correct": true,
          "expr": "If a = 4, then a + 7 = 11",
          "desc": "4 + 7"
        },
        {
          "correct": true,
          "expr": "If x = 5, then x&sup2; = 25",
          "desc": "5 &times; 5"
        },
        {
          "correct": false,
          "expr": "If x = 3, then 2x = 23",
          "desc": "not joining digits"
        },
        {
          "correct": false,
          "expr": "If x = 4, then x&sup2; = 8",
          "desc": "squared means &times; itself, not &times; 2"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Replace the letter with the number. Use BIDMAS to work out the answer in the correct order.",
      "equation": "If x = 4: <span class=\"ov\">3x + 1</span> = 3 &times; 4 + 1 = <span class=\"ovr\">13</span>",
      "caption": "Substitute then calculate"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; single variable",
      "question": "Find the value of 4x + 3 when x = 5",
      "steps": [
        "Replace x with 5: 4 &times; 5 + 3",
        "Work out the multiplication: 20 + 3",
        "Add: 23"
      ],
      "answer": "= 23",
      "explanation": "Multiply first (BIDMAS), then add."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; two variables",
      "question": "Find the value of 3a + 2b when a = 4 and b = 5",
      "steps": [
        "Replace a with 4 and b with 5: 3 &times; 4 + 2 &times; 5",
        "Work out each multiplication: 12 + 10",
        "Add: 22"
      ],
      "answer": "= 22",
      "explanation": "Substitute both letters, then follow BIDMAS."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; with powers",
      "question": "Find the value of x&sup2; + 3x when x = 4",
      "steps": [
        "Replace x with 4: 4&sup2; + 3 &times; 4",
        "Work out the power: 16 + 3 &times; 4",
        "Multiply then add: 16 + 12 = 28"
      ],
      "answer": "= 28",
      "explanation": "Powers first, then multiplication, then addition."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; negative values",
      "question": "Find the value of 2x&sup2; &minus; 3x when x = &minus;2",
      "steps": [
        "Replace x with &minus;2: 2 &times; (&minus;2)&sup2; &minus; 3 &times; (&minus;2)",
        "Work out (&minus;2)&sup2; = 4, so 2 &times; 4 = 8",
        "Work out &minus;3 &times; (&minus;2) = 6, so 8 + 6 = 14"
      ],
      "answer": "= 14",
      "explanation": "(&minus;2)&sup2; = 4, not &minus;4. A negative squared gives a positive."
    }
  ],
