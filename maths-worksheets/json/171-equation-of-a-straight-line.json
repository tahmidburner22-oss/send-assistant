{
  "title": "STRAIGHT-LINE GRAPHS,\n(EQUATION OF A STRAIGHT LINE)",
  "objective": "LO: I can find and use the equation of a straight line in the form y = mx + c.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "y = mx + c",
      "content": [
        {
          "type": "paragraph",
          "text": "The equation of a straight line is <span class=\"ul-b\">y = mx + c</span>, where <span class=\"ul-k\">m</span> is the gradient (slope) and <span class=\"ul-k\">c</span> is the y-intercept (where the line crosses the y-axis)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Gradient:</span> m = rise &divide; run = change in y &divide; change in x between any two points on the line."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "y = 2x + 3: gradient 2, y-intercept 3",
          "desc": "read m and c"
        },
        {
          "correct": true,
          "expr": "y = &minus;x + 5: gradient &minus;1, y-intercept 5",
          "desc": "negative gradient"
        },
        {
          "correct": true,
          "expr": "m = (y2 &minus; y1)/(x2 &minus; x1)",
          "desc": "gradient formula"
        },
        {
          "correct": false,
          "expr": "y = 2x + 3 has gradient 3",
          "desc": "gradient is 2, not 3"
        },
        {
          "correct": false,
          "expr": "y = 4 &minus; 2x has positive gradient",
          "desc": "gradient is &minus;2"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Every straight line can be written as y = mx + c. Find m from two points, then substitute a point to find c.",
      "equation": "m = <span class=\"ov\">(y&sub2; &minus; y&sub1;)</span> &divide; <span class=\"ovr\">(x&sub2; &minus; x&sub1;)</span>",
      "caption": "Then use y = mx + c with a known point to find c"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; reading from equation",
      "question": "State the gradient and y-intercept of y = 3x &minus; 2.",
      "steps": [
        "Compare with y = mx + c",
        "m = 3 (gradient)",
        "c = &minus;2 (y-intercept)"
      ],
      "answer": "Gradient = 3, y-intercept = &minus;2",
      "explanation": "The coefficient of x is m; the constant is c."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; finding equation from graph",
      "question": "A line passes through (0, 4) and (2, 10). Find its equation.",
      "steps": [
        "c = 4 (y-intercept)",
        "m = (10 &minus; 4)/(2 &minus; 0) = 6/2 = 3",
        "Equation: y = 3x + 4"
      ],
      "answer": "y = 3x + 4",
      "explanation": "Use the y-intercept for c and calculate m from two points."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; two points",
      "question": "Find the equation of the line through (1, 5) and (3, 11).",
      "steps": [
        "m = (11 &minus; 5)/(3 &minus; 1) = 6/2 = 3",
        "Using (1, 5): 5 = 3(1) + c, c = 2",
        "Equation: y = 3x + 2"
      ],
      "answer": "y = 3x + 2",
      "explanation": "Find gradient first, then substitute a point to find c."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; rearranging",
      "question": "Write 2x + 3y = 12 in the form y = mx + c.",
      "steps": [
        "3y = 12 &minus; 2x",
        "3y = &minus;2x + 12",
        "y = &minus;&frac{2}{3}x + 4"
      ],
      "answer": "y = &minus;&frac{2}{3}x + 4",
      "explanation": "Rearrange to isolate y on the left-hand side."
    }
  ],
