{
  "title": "STRAIGHT-LINE GRAPHS,\n(EQUATION OF A STRAIGHT LINE)",
  "objective": "LO: I can identify and write the equation of a straight line in the form y = mx + c.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Equation of a straight line",
      "content": [
        {
          "type": "paragraph",
          "text": "Every straight line can be written as <span class=\"ul-b\">y = mx + c</span>, where <span class=\"ul-k\">m</span> is the gradient (slope) and <span class=\"ul-k\">c</span> is the y-intercept."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Reading from a graph:</span> The y-intercept is where the line crosses the y-axis. The gradient is the steepness, calculated as rise &divide; run."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "y = 2x + 3 has gradient 2 and y-intercept 3",
          "desc": "m = 2, c = 3"
        },
        {
          "correct": true,
          "expr": "y = -x + 5 has gradient -1",
          "desc": "line slopes downward"
        },
        {
          "correct": true,
          "expr": "y = &frac{1}{2}x has gradient &frac{1}{2} and y-intercept 0",
          "desc": "passes through origin"
        },
        {
          "correct": false,
          "expr": "y = 3x + 2 has gradient 2",
          "desc": "gradient is 3, not 2"
        },
        {
          "correct": false,
          "expr": "y = 4 - 2x has positive gradient",
          "desc": "gradient is -2 (negative)"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "In y = mx + c, m is the gradient (how steep) and c is where the line crosses the y-axis.",
      "equation": "y = <span class=\"ov\">m</span>x + <span class=\"ovr\">c</span>",
      "caption": "m = gradient, c = y-intercept"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; identifying m and c",
      "question": "State the gradient and y-intercept of y = 3x - 2.",
      "steps": [
        "Compare with y = mx + c",
        "m = 3 (gradient)",
        "c = -2 (y-intercept)"
      ],
      "answer": "Gradient = 3, y-intercept = -2",
      "explanation": "Read m and c directly from the equation."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; writing the equation",
      "question": "A line has gradient 4 and y-intercept -1. Write its equation.",
      "steps": [
        "Use y = mx + c",
        "Substitute m = 4 and c = -1",
        "y = 4x - 1"
      ],
      "answer": "y = 4x - 1",
      "explanation": "Plug the gradient and y-intercept into the formula."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; rearranging to y = mx + c",
      "question": "Write 2x + y = 7 in the form y = mx + c.",
      "steps": [
        "Subtract 2x from both sides",
        "y = -2x + 7",
        "Gradient = -2, y-intercept = 7"
      ],
      "answer": "y = -2x + 7",
      "explanation": "Rearrange so y is the subject."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; finding equation from two points",
      "question": "Find the equation of the line through (0, 3) and (2, 7).",
      "steps": [
        "Gradient = (7 - 3) &divide; (2 - 0) = 4 &divide; 2 = 2",
        "y-intercept = 3 (the point where x = 0)",
        "y = 2x + 3"
      ],
      "answer": "y = 2x + 3",
      "explanation": "Use two points to find gradient, then identify c."
    }
  ],
