{
  "title": "SEQUENCES,\n(QUADRATIC SEQUENCES)",
  "objective": "LO: I can find the nth term of a quadratic sequence.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What is a quadratic sequence?",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">quadratic sequence</span> has a constant <span class=\"ul-k\">second difference</span>. The nth term has the form an&sup2; + bn + c."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Find first differences, then second differences. If the second difference is constant (= 2a), the sequence is quadratic. Then find a, b, c."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "1, 4, 9, 16, 25, ... has nth term n&sup2;",
          "desc": "second diff = 2"
        },
        {
          "correct": true,
          "expr": "3, 8, 15, 24, 35, ... has 2nd diff = 2",
          "desc": "quadratic"
        },
        {
          "correct": true,
          "expr": "Second difference = 2a, so if 2nd diff = 6 then a = 3",
          "desc": "finding a"
        },
        {
          "correct": false,
          "expr": "2, 5, 8, 11, ... is quadratic",
          "desc": "constant first diff = arithmetic"
        },
        {
          "correct": false,
          "expr": "Second difference = a",
          "desc": "second difference = 2a"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Find second differences (= 2a). Subtract an&sup2; from each term to get a linear sequence, then find b and c.",
      "equation": "u<sub>n</sub> = <span class=\"ov\">a</span>n&sup2; + <span class=\"ovr\">b</span>n + c",
      "caption": "2a = second difference; then find b and c from the remainder"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; finding the nth term",
      "question": "Find the nth term of 3, 8, 15, 24, 35, ...",
      "steps": [
        "First differences: 5, 7, 9, 11. Second differences: 2, 2, 2. So 2a = 2, a = 1",
        "Subtract n&sup2;: 3&minus;1=2, 8&minus;4=4, 15&minus;9=6, 24&minus;16=8. Linear sequence: 2, 4, 6, 8 = 2n",
        "nth term = n&sup2; + 2n"
      ],
      "answer": "n&sup2; + 2n",
      "explanation": "Check: when n=1: 1+2=3. When n=2: 4+4=8. Correct!"
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; second difference not 2",
      "question": "Find the nth term of 2, 8, 18, 32, 50, ...",
      "steps": [
        "First diff: 6, 10, 14, 18. Second diff: 4, 4, 4. So 2a = 4, a = 2",
        "Subtract 2n&sup2;: 2&minus;2=0, 8&minus;8=0, 18&minus;18=0. All zeros!",
        "nth term = 2n&sup2;"
      ],
      "answer": "2n&sup2;",
      "explanation": "When subtracting an&sup2; gives all zeros, b = c = 0."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; with a constant",
      "question": "Find the nth term of 4, 7, 12, 19, 28, ...",
      "steps": [
        "First diff: 3, 5, 7, 9. Second diff: 2, 2, 2. a = 1",
        "Subtract n&sup2;: 4&minus;1=3, 7&minus;4=3, 12&minus;9=3, 19&minus;16=3. Constant = 3",
        "nth term = n&sup2; + 3"
      ],
      "answer": "n&sup2; + 3",
      "explanation": "The remainder is a constant, so b = 0 and c = 3."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; full quadratic",
      "question": "Find the nth term of 2, 9, 20, 35, 54, ...",
      "steps": [
        "First diff: 7, 11, 15, 19. Second diff: 4, 4, 4. a = 2",
        "Subtract 2n&sup2;: 2&minus;2=0, 9&minus;8=1, 20&minus;18=2, 35&minus;32=3. Linear: 0, 1, 2, 3 = n &minus; 1",
        "nth term = 2n&sup2; + n &minus; 1"
      ],
      "answer": "2n&sup2; + n &minus; 1",
      "explanation": "Check: n=1: 2+1&minus;1=2. n=2: 8+2&minus;1=9. Correct!"
    }
  ],
