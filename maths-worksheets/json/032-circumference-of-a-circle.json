{
  "title": "AREA AND PERIMETER,\n(CIRCUMFERENCE OF A CIRCLE)",
  "objective": "LO: I can calculate the circumference of a circle using C = &pi;d or C = 2&pi;r.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Circumference",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">circumference</span> is the distance around a circle. The <span class=\"ul-k\">diameter</span> goes across through the centre; the <span class=\"ul-k\">radius</span> is half the diameter."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Formulae:</span> C = &pi;d or C = 2&pi;r (same thing because d = 2r). Use &pi; = 3.14159... or the &pi; button on a calculator."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "d = 10 &rarr; C = 10&pi; &approx; 31.4 cm",
          "desc": "C = &pi;d"
        },
        {
          "correct": true,
          "expr": "r = 7 &rarr; C = 14&pi; &approx; 44.0 cm",
          "desc": "C = 2&pi;r"
        },
        {
          "correct": true,
          "expr": "&pi; &approx; 3.14159...",
          "desc": "irrational number"
        },
        {
          "correct": false,
          "expr": "C = &pi;r (not &pi;d)",
          "desc": "that halves the answer"
        },
        {
          "correct": false,
          "expr": "C = &pi;r&sup2;",
          "desc": "that is the area formula"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Circumference = &pi; &times; diameter. If given the radius, double it first (or use C = 2&pi;r).",
      "equation": "C = <span class=\"ov\">&pi;</span> &times; <span class=\"ovr\">d</span>",
      "caption": "&pi; is approximately 3.14"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; given diameter",
      "question": "Find the circumference of a circle with diameter 8 cm.",
      "steps": [
        "C = &pi;d",
        "C = &pi; &times; 8",
        "C = 25.1 cm (1 d.p.)"
      ],
      "answer": "= 25.1 cm",
      "explanation": "Multiply &pi; by the diameter."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; given radius",
      "question": "Find the circumference of a circle with radius 5 cm.",
      "steps": [
        "C = 2&pi;r",
        "C = 2 &times; &pi; &times; 5",
        "C = 31.4 cm (1 d.p.)"
      ],
      "answer": "= 31.4 cm",
      "explanation": "Double the radius to get the diameter, then multiply by &pi;."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; finding diameter",
      "question": "A circle has circumference 50 cm. Find the diameter.",
      "steps": [
        "C = &pi;d, so d = C &divide; &pi;",
        "d = 50 &divide; &pi;",
        "d = 15.9 cm (1 d.p.)"
      ],
      "answer": "d = 15.9 cm",
      "explanation": "Rearrange: divide circumference by &pi;."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; semicircle perimeter",
      "question": "Find the perimeter of a semicircle with diameter 12 cm.",
      "steps": [
        "Curved part = &frac{1}{2} &times; &pi; &times; 12 = 6&pi; = 18.85 cm",
        "Straight edge = 12 cm",
        "Total perimeter = 18.85 + 12 = 30.85 cm"
      ],
      "answer": "= 30.8 cm (1 d.p.)",
      "explanation": "Semicircle perimeter = half circumference + diameter."
    }
  ],
