{
  "title": "VOLUME AND SURFACE AREA,\n(VOLUME OF PYRAMIDS, CONES AND SPHERES)",
  "objective": "LO: I can calculate the volume of pyramids, cones and spheres.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Volume formulae",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Pyramid</span> V = &frac{1}{3} &times; base area &times; height. <span class=\"ul-b\">Cone</span> V = &frac{1}{3}&pi;r&sup2;h. <span class=\"ul-b\">Sphere</span> V = &frac{4}{3}&pi;r&sup3;."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Key pattern:</span> Pyramids and cones are &frac{1}{3} of the equivalent prism/cylinder."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key formulae",
      "examples": [
        {
          "correct": true,
          "expr": "Cone V = &frac{1}{3}&pi;r&sup2;h",
          "desc": "third of cylinder"
        },
        {
          "correct": true,
          "expr": "Sphere V = &frac{4}{3}&pi;r&sup3;",
          "desc": "four-thirds pi r cubed"
        },
        {
          "correct": true,
          "expr": "Pyramid V = &frac{1}{3} &times; base &times; h",
          "desc": "third of prism"
        },
        {
          "correct": false,
          "expr": "Cone V = &pi;r&sup2;h",
          "desc": "that is cylinder volume"
        },
        {
          "correct": false,
          "expr": "Sphere V = 4&pi;r&sup3;",
          "desc": "must be &frac{4}{3}&pi;r&sup3;"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Pyramids and cones = &frac{1}{3} of the prism/cylinder. Sphere = &frac{4}{3}&pi;r&sup3;.",
      "equation": "Cone: <span class=\"ov\">&frac{1}{3}&pi;r&sup2;h</span> | Sphere: <span class=\"ovr\">&frac{4}{3}&pi;r&sup3;</span>",
      "caption": "Remember the &frac{1}{3} for pointed shapes"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; cone",
      "question": "Find the volume of a cone with r=3, h=8.",
      "steps": [
        "V = &frac{1}{3}&pi;r&sup2;h",
        "= &frac{1}{3} &times; &pi; &times; 9 &times; 8",
        "= 24&pi; = 75.4 cm&sup3;"
      ],
      "answer": "75.4 cm&sup3;",
      "explanation": "One-third of the equivalent cylinder."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; sphere",
      "question": "Find the volume of a sphere with r=6.",
      "steps": [
        "V = &frac{4}{3}&pi;r&sup3;",
        "= &frac{4}{3} &times; &pi; &times; 216",
        "= 288&pi; = 904.8 cm&sup3;"
      ],
      "answer": "904.8 cm&sup3;",
      "explanation": "Cube the radius, multiply by 4/3 and &pi;."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; pyramid",
      "question": "Square-based pyramid: base 10&times;10, height 12.",
      "steps": [
        "Base area = 100",
        "V = &frac{1}{3} &times; 100 &times; 12",
        "= 400 cm&sup3;"
      ],
      "answer": "400 cm&sup3;",
      "explanation": "One-third of base area times height."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; hemisphere",
      "question": "Find the volume of a hemisphere with r=5.",
      "steps": [
        "V = &frac{1}{2} &times; &frac{4}{3}&pi;r&sup3;",
        "= &frac{2}{3}&pi; &times; 125",
        "= &frac{250}{3}&pi; = 261.8 cm&sup3;"
      ],
      "answer": "261.8 cm&sup3;",
      "explanation": "Half of a full sphere volume."
    }
  ],
