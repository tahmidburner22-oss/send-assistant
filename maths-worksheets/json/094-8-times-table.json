{
  "title": "MULTIPLICATION,\n(EIGHT TIMES TABLE)",
  "objective": "LO: I can recall and use the 8 times table to multiply and divide.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What is the 8 times table?",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">8 times table</span> is a list of <span class=\"ul-k\">multiples</span> of 8: numbers we get when we count in 8s. Multiples of 8 are always even, and you can find them by doubling the 4 times table."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Skip-count in 8s on your fingers, or use a number line. Each jump adds 8."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Multiples of 8",
      "examples": [
        {
          "correct": true,
          "expr": "1 &times; 8 = 8",
          "desc": "starting point"
        },
        {
          "correct": true,
          "expr": "2 &times; 8 = 16",
          "desc": "double"
        },
        {
          "correct": true,
          "expr": "5 &times; 8 = 40",
          "desc": "halfway to 10"
        },
        {
          "correct": false,
          "expr": "3 &times; 8 = 25",
          "desc": "wrong"
        },
        {
          "correct": false,
          "expr": "8 &times; 0 = 8",
          "desc": "any &times; 0 = 0"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiplication is repeated addition. 8 &times; 4 means &lsquo;4 groups of 8&rsquo;. You can also think of it as &lsquo;8 groups of 4&rsquo; — the answer is the same.",
      "equation": "<span class=\"ov\">8</span> + <span class=\"ov\">8</span> + <span class=\"ov\">8</span> + <span class=\"ov\">8</span> = <span class=\"ovr\">8&times;4 = 32</span>",
      "caption": "Four groups of 8"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; single multiplication",
      "question": "Calculate 4 &times; 8",
      "steps": [
        "4 groups of 8",
        "8 + 8 + 8 + 8",
        "= 32"
      ],
      "answer": "= 32",
      "explanation": "Skip-count in 8s 4 times to reach 32."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; missing factor",
      "question": "Solve: ___ &times; 8 = 48",
      "steps": [
        "How many 8s in 48?",
        "Count up: 8, 16, 24, ...",
        "= 6"
      ],
      "answer": "= 6",
      "explanation": "Divide: 48 &divide; 8 = 6."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; division by sharing",
      "question": "Calculate 56 &divide; 8",
      "steps": [
        "How many groups of 8 fit in 56?",
        "8 &times; ___ = 56",
        "= 7"
      ],
      "answer": "= 7",
      "explanation": "Division is the inverse of multiplication."
    },
