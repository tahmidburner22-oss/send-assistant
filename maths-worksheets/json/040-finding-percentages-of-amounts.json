{
  "title": "FRACTIONS, DECIMALS AND PERCENTAGES,\n(FINDING PERCENTAGES OF AMOUNTS)",
  "objective": "LO: I can calculate a percentage of a given amount using mental and written methods.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Percentages of amounts",
      "content": [
        {
          "type": "paragraph",
          "text": "Finding a <span class=\"ul-b\">percentage of an amount</span> means finding that <span class=\"ul-k\">fraction</span> of the total. 'Of' means multiply."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Method:</span> Divide by 100, then multiply by the percentage. Or find 10% first and build up."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key methods",
      "examples": [
        {
          "correct": true,
          "expr": "50% of 80 = 40",
          "desc": "half"
        },
        {
          "correct": true,
          "expr": "10% of 250 = 25",
          "desc": "&divide; 10"
        },
        {
          "correct": true,
          "expr": "25% of 60 = 15",
          "desc": "&divide; 4"
        },
        {
          "correct": false,
          "expr": "10% of 80 = 8.0 (move 2 places)",
          "desc": "only move 1 place"
        },
        {
          "correct": false,
          "expr": "30% of 50 = 30 &times; 50 = 1500",
          "desc": "must divide by 100 too"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "To find x% of an amount: divide by 100, multiply by x. Or use 10% building blocks.",
      "equation": "<span class=\"ov\">x%</span> of A = <span class=\"ovr\">A &times; x &divide; 100</span>",
      "caption": "Percentage means per hundred"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; simple percentage",
      "question": "Find 20% of &pound;150.",
      "steps": [
        "10% of 150 = 15",
        "20% = 2 &times; 10% = 2 &times; 15",
        "= &pound;30"
      ],
      "answer": "= &pound;30",
      "explanation": "Find 10% first, then double it."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; using division",
      "question": "Find 35% of 200.",
      "steps": [
        "200 &divide; 100 = 2 (this is 1%)",
        "2 &times; 35 = 70",
        "35% of 200 = 70"
      ],
      "answer": "= 70",
      "explanation": "Divide by 100 to get 1%, then multiply."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; non-calculator",
      "question": "Find 15% of &pound;80.",
      "steps": [
        "10% of 80 = 8",
        "5% = half of 10% = 4",
        "15% = 8 + 4 = &pound;12"
      ],
      "answer": "= &pound;12",
      "explanation": "Build up from 10% and 5%."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; applied",
      "question": "A coat costs &pound;120. There is a 30% discount. How much is the discount?",
      "steps": [
        "Find 30% of 120",
        "10% = 12, so 30% = 3 &times; 12 = 36",
        "Discount = &pound;36"
      ],
      "answer": "= &pound;36",
      "explanation": "The discount means you save &pound;36; sale price = &pound;84."
    }
  ],
