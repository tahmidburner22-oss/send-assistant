{
  "title": "VECTORS,\n(ADDING AND SUBTRACTING VECTORS)",
  "objective": "LO: I can add and subtract column vectors and represent the results geometrically.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Vector addition and subtraction",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">vector</span> has both magnitude and direction. <span class=\"ul-k\">Column vectors</span> are written as (x, y) where x is horizontal and y is vertical movement."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Rules:</span> To add vectors, add corresponding components. To subtract, subtract components. a + b means 'go along a then along b'."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "(2,3) + (4,1) = (6,4)",
          "desc": "add components"
        },
        {
          "correct": true,
          "expr": "(5,2) &minus; (3,1) = (2,1)",
          "desc": "subtract components"
        },
        {
          "correct": true,
          "expr": "&minus;a is vector a reversed",
          "desc": "negate both parts"
        },
        {
          "correct": false,
          "expr": "(2,3) + (4,1) = (8,3)",
          "desc": "add each part separately"
        },
        {
          "correct": false,
          "expr": "Vectors can only be positive",
          "desc": "can have negative components"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Add or subtract the x-components and y-components separately.",
      "equation": "(a,b) + (c,d) = <span class=\"ov\">(a+c, b+d)</span>",
      "caption": "Component-wise addition"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; adding vectors",
      "question": "Find (3,2) + (4,&minus;1).",
      "steps": [
        "Add x: 3 + 4 = 7",
        "Add y: 2 + (&minus;1) = 1",
        "Result: (7, 1)"
      ],
      "answer": "(7, 1)",
      "explanation": "Add each component separately."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; subtracting vectors",
      "question": "Find (5,3) &minus; (2,7).",
      "steps": [
        "Subtract x: 5 &minus; 2 = 3",
        "Subtract y: 3 &minus; 7 = &minus;4",
        "Result: (3, &minus;4)"
      ],
      "answer": "(3, &minus;4)",
      "explanation": "Subtract each component."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; negative vector",
      "question": "If a = (4, &minus;2), find &minus;a.",
      "steps": [
        "Negate x: &minus;4",
        "Negate y: 2",
        "Result: (&minus;4, 2)"
      ],
      "answer": "(&minus;4, 2)",
      "explanation": "Reverse both components."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; resultant vector",
      "question": "Go from A to B using a = (3,1) then b = (2,4). Find the resultant.",
      "steps": [
        "Resultant = a + b",
        "= (3+2, 1+4)",
        "= (5, 5)"
      ],
      "answer": "(5, 5)",
      "explanation": "The resultant goes directly from start to finish."
    }
  ],
