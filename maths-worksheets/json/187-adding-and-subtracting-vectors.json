{
  "title": "VECTORS,\n(ADDING AND SUBTRACTING VECTORS)",
  "objective": "LO: I can add and subtract column vectors and represent the results on a grid.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Adding and subtracting vectors",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">vector</span> has magnitude and direction, written as a column vector. To <span class=\"ul-k\">add vectors</span>, add the corresponding components. To subtract, subtract components."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Geometrically:</span> Adding vectors places them end to end (triangle rule). The resultant goes from the start of the first to the end of the last."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "(3, 2) + (1, 4) = (4, 6)",
          "desc": "add components"
        },
        {
          "correct": true,
          "expr": "(5, 3) - (2, 1) = (3, 2)",
          "desc": "subtract components"
        },
        {
          "correct": true,
          "expr": "a + b means travel along a then along b",
          "desc": "triangle rule"
        },
        {
          "correct": false,
          "expr": "(3, 2) + (1, 4) = (4, 8)",
          "desc": "add each component separately"
        },
        {
          "correct": false,
          "expr": "(5, 3) - (2, 1) = (3, 4)",
          "desc": "subtract y from y, not add"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Add or subtract the x-components and y-components separately.",
      "equation": "<span class=\"ov\">(a, b)</span> + <span class=\"ovr\">(c, d)</span> = (a+c, b+d)",
      "caption": "Component-wise addition"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; adding two vectors",
      "question": "Find (3, 2) + (4, -1).",
      "steps": [
        "Add x-components: 3 + 4 = 7",
        "Add y-components: 2 + (-1) = 1",
        "Result: (7, 1)"
      ],
      "answer": "(7, 1)",
      "explanation": "Add each component separately."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; subtracting vectors",
      "question": "Find (5, 6) - (2, 4).",
      "steps": [
        "Subtract x-components: 5 - 2 = 3",
        "Subtract y-components: 6 - 4 = 2",
        "Result: (3, 2)"
      ],
      "answer": "(3, 2)",
      "explanation": "Subtract each component separately."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; adding multiple vectors",
      "question": "Find (1, 3) + (2, -1) + (-4, 5).",
      "steps": [
        "x: 1 + 2 + (-4) = -1",
        "y: 3 + (-1) + 5 = 7",
        "Result: (-1, 7)"
      ],
      "answer": "(-1, 7)",
      "explanation": "Add all x-components, then all y-components."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; finding a vector",
      "question": "If a + b = (7, 3) and a = (4, 1), find b.",
      "steps": [
        "b = (7, 3) - (4, 1)",
        "x: 7 - 4 = 3",
        "y: 3 - 1 = 2, so b = (3, 2)"
      ],
      "answer": "b = (3, 2)",
      "explanation": "Rearrange: b = resultant - a."
    }
  ],
