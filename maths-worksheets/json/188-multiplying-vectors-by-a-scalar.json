{
  "title": "VECTORS,\n(MULTIPLYING VECTORS BY A SCALAR)",
  "objective": "LO: I can multiply a vector by a scalar and understand the geometric effect.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Scalar multiplication",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">scalar</span> is just a number (no direction). Multiplying a vector by a scalar <span class=\"ul-k\">scales</span> its magnitude. The direction stays the same (or reverses if negative)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Rule:</span> k(a, b) = (ka, kb). Multiply each component by the scalar."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "3(2, 4) = (6, 12)",
          "desc": "multiply both by 3"
        },
        {
          "correct": true,
          "expr": "&minus;2(1, 3) = (&minus;2, &minus;6)",
          "desc": "reverses direction"
        },
        {
          "correct": true,
          "expr": "&frac{1}{2}(6, 4) = (3, 2)",
          "desc": "halves the vector"
        },
        {
          "correct": false,
          "expr": "3(2, 4) = (6, 4)",
          "desc": "must multiply both"
        },
        {
          "correct": false,
          "expr": "&minus;1(3, 2) = (3, 2)",
          "desc": "should be (&minus;3, &minus;2)"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "k(a, b) = (ka, kb). Positive k keeps direction; negative k reverses it.",
      "equation": "k<span class=\"ov\">(a, b)</span> = <span class=\"ovr\">(ka, kb)</span>",
      "caption": "Scale both components by the same factor"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; positive scalar",
      "question": "Find 3(2, 5).",
      "steps": [
        "Multiply x: 3 &times; 2 = 6",
        "Multiply y: 3 &times; 5 = 15",
        "= (6, 15)"
      ],
      "answer": "(6, 15)",
      "explanation": "Multiply each component by the scalar."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; negative scalar",
      "question": "Find &minus;2(4, &minus;1).",
      "steps": [
        "&minus;2 &times; 4 = &minus;8",
        "&minus;2 &times; (&minus;1) = 2",
        "= (&minus;8, 2)"
      ],
      "answer": "(&minus;8, 2)",
      "explanation": "Negative scalar reverses direction."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; fractional scalar",
      "question": "Find &frac{1}{2}(8, &minus;6).",
      "steps": [
        "&frac{1}{2} &times; 8 = 4",
        "&frac{1}{2} &times; (&minus;6) = &minus;3",
        "= (4, &minus;3)"
      ],
      "answer": "(4, &minus;3)",
      "explanation": "Fractional scalar reduces the magnitude."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; parallel vectors",
      "question": "Show that (4, 6) is parallel to (2, 3).",
      "steps": [
        "(4, 6) = 2(2, 3)",
        "One is a scalar multiple of the other",
        "So they are parallel"
      ],
      "answer": "Parallel: (4,6) = 2 &times; (2,3)",
      "explanation": "Parallel vectors are scalar multiples of each other."
    }
  ],
