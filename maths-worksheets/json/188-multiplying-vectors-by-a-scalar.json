{
  "title": "VECTORS,\n(MULTIPLYING VECTORS BY A SCALAR)",
  "objective": "LO: I can multiply a vector by a scalar and understand its geometric effect.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Scalar multiplication of vectors",
      "content": [
        {
          "type": "paragraph",
          "text": "Multiplying a vector by a <span class=\"ul-b\">scalar</span> (number) multiplies each component by that number. This <span class=\"ul-k\">scales</span> the vector: changing its magnitude but not its direction (unless negative)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Key fact:</span> A negative scalar reverses the direction. Vectors that are scalar multiples of each other are parallel."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "3(2, 4) = (6, 12)",
          "desc": "multiply each component by 3"
        },
        {
          "correct": true,
          "expr": "-2(1, 3) = (-2, -6)",
          "desc": "negative scalar reverses direction"
        },
        {
          "correct": true,
          "expr": "(4, 6) and (2, 3) are parallel",
          "desc": "one is 2 times the other"
        },
        {
          "correct": false,
          "expr": "3(2, 4) = (6, 4)",
          "desc": "must multiply both components"
        },
        {
          "correct": false,
          "expr": "-1(3, 2) = (3, 2)",
          "desc": "should be (-3, -2)"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiply each component by the scalar. Parallel vectors are scalar multiples of each other.",
      "equation": "k<span class=\"ov\">(a, b)</span> = <span class=\"ovr\">(ka, kb)</span>",
      "caption": "Scales magnitude by |k|, reverses direction if k < 0"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; positive scalar",
      "question": "Calculate 4(2, 3).",
      "steps": [
        "Multiply x: 4 &times; 2 = 8",
        "Multiply y: 4 &times; 3 = 12",
        "Result: (8, 12)"
      ],
      "answer": "(8, 12)",
      "explanation": "Each component is multiplied by the scalar."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; negative scalar",
      "question": "Calculate -3(1, -2).",
      "steps": [
        "Multiply x: -3 &times; 1 = -3",
        "Multiply y: -3 &times; (-2) = 6",
        "Result: (-3, 6)"
      ],
      "answer": "(-3, 6)",
      "explanation": "Negative scalar reverses direction."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; showing vectors are parallel",
      "question": "Show that (6, 9) and (2, 3) are parallel.",
      "steps": [
        "Check if one is a scalar multiple of the other",
        "(6, 9) = 3(2, 3)",
        "Since (6, 9) = 3 &times; (2, 3), they are parallel"
      ],
      "answer": "Parallel (scalar factor 3)",
      "explanation": "If a = kb for some scalar k, the vectors are parallel."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; combining scalar and addition",
      "question": "If a = (3, 1) and b = (2, -4), find 2a - 3b.",
      "steps": [
        "2a = 2(3, 1) = (6, 2)",
        "3b = 3(2, -4) = (6, -12)",
        "2a - 3b = (6, 2) - (6, -12) = (0, 14)"
      ],
      "answer": "(0, 14)",
      "explanation": "Scalar multiply first, then subtract."
    }
  ],
