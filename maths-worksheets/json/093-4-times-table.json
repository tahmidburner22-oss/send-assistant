      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; single multiplication",
      "question": "Calculate 6 &times; 4",
      "steps": [
        "6 groups of 4",
        "4 + 4 + 4 + 4  ...",
        "= 24"
      ],
      "answer": "= 24",
      "explanation": "Skip-count in 4s 6 times to reach 24."
    },
