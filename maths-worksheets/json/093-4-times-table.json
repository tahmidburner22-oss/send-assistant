{
  "title": "MULTIPLICATION,\n(FOUR TIMES TABLE)",
  "objective": "LO: I can recall and use the 4 times table to multiply and divide.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What is the 4 times table?",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">4 times table</span> is a list of <span class=\"ul-k\">multiples</span> of 4: numbers we get when we count in 4s. Multiples of 4 are always even, and you can find them by doubling the 2 times table."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Skip-count in 4s on your fingers, or use a number line. Each jump adds 4."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Multiples of 4",
      "examples": [
        {
          "correct": true,
          "expr": "1 &times; 4 = 4",
          "desc": "starting point"
        },
        {
          "correct": true,
          "expr": "2 &times; 4 = 8",
          "desc": "double"
        },
        {
          "correct": true,
          "expr": "5 &times; 4 = 20",
          "desc": "halfway to 10"
        },
        {
          "correct": false,
          "expr": "3 &times; 4 = 13",
          "desc": "wrong"
        },
        {
          "correct": false,
          "expr": "4 &times; 0 = 4",
          "desc": "any &times; 0 = 0"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiplication is repeated addition. 4 &times; 4 means &lsquo;4 groups of 4&rsquo;. You can also think of it as &lsquo;4 groups of 4&rsquo; — the answer is the same.",
      "equation": "<span class=\"ov\">4</span> + <span class=\"ov\">4</span> + <span class=\"ov\">4</span> + <span class=\"ov\">4</span> = <span class=\"ovr\">4&times;4 = 16</span>",
      "caption": "Four groups of 4"
    }
  },
  "modelled_examples": [
