{
  "title": "DECIMALS,\n(MULTIPLYING DECIMALS)",
  "objective": "LO: I can multiply decimal numbers using place value and the column method.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Multiplying decimals",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"ul-b\">multiply decimals</span>, ignore the decimal points, multiply as whole numbers, then put the point back using the total number of <span class=\"ul-k\">decimal places</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Rule:</span> Count the total decimal places in the question. The answer has the same total number of decimal places."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key method",
      "examples": [
        {
          "correct": true,
          "expr": "0.3 &times; 0.4 = 0.12",
          "desc": "1 d.p. + 1 d.p. = 2 d.p."
        },
        {
          "correct": true,
          "expr": "2.5 &times; 4 = 10.0",
          "desc": "1 d.p. + 0 d.p. = 1 d.p."
        },
        {
          "correct": true,
          "expr": "1.2 &times; 0.3 = 0.36",
          "desc": "12 &times; 3 = 36, 2 d.p."
        },
        {
          "correct": false,
          "expr": "0.3 &times; 0.4 = 1.2",
          "desc": "wrong number of d.p."
        },
        {
          "correct": false,
          "expr": "2.5 &times; 4 = 100",
          "desc": "forgot the decimal point"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiply as whole numbers, then place the decimal point so the answer has the correct total number of decimal places.",
      "equation": "<span class=\"ov\">1.2 &times; 0.3</span>: 12 &times; 3 = 36 &rarr; <span class=\"ovr\">0.36</span>",
      "caption": "2 decimal places in total"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; decimal by whole number",
      "question": "Calculate 3.4 &times; 5",
      "steps": [
        "Ignore decimal: 34 &times; 5 = 170",
        "Total d.p. in question: 1",
        "Place point: 17.0"
      ],
      "answer": "= 17.0",
      "explanation": "One decimal place in the question means one in the answer."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; decimal by decimal",
      "question": "Calculate 0.6 &times; 0.7",
      "steps": [
        "Ignore decimals: 6 &times; 7 = 42",
        "Total d.p.: 1 + 1 = 2",
        "Place point: 0.42"
      ],
      "answer": "= 0.42",
      "explanation": "Two decimal places total: answer is 0.42 not 4.2."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; two-digit decimals",
      "question": "Calculate 2.4 &times; 1.3",
      "steps": [
        "Ignore decimals: 24 &times; 13 = 312",
        "Total d.p.: 1 + 1 = 2",
        "Place point: 3.12"
      ],
      "answer": "= 3.12",
      "explanation": "24 &times; 13: 24&times;10 = 240, 24&times;3 = 72, total 312."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; with zeros",
      "question": "Calculate 0.05 &times; 0.4",
      "steps": [
        "Ignore decimals: 5 &times; 4 = 20",
        "Total d.p.: 2 + 1 = 3",
        "Place point: 0.020 = 0.02"
      ],
      "answer": "= 0.02",
      "explanation": "Three decimal places needed; 020 becomes 0.020 = 0.02."
    }
  ],
