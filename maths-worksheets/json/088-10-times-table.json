      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; single multiplication",
      "question": "Calculate 7 &times; 10",
      "steps": [
        "7 groups of 10",
        "10 + 10 + 10 + 10  ...",
        "= 70"
      ],
      "answer": "= 70",
      "explanation": "Skip-count in 10s 7 times to reach 70."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; missing factor",
      "question": "Solve: ___ &times; 10 = 40",
      "steps": [
        "How many 10s in 40?",
        "Count up: 10, 20, 30, ...",
        "= 4"
      ],
      "answer": "= 4",
      "explanation": "Divide: 40 &divide; 10 = 4."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; division by sharing",
      "question": "Calculate 80 &divide; 10",
      "steps": [
        "How many groups of 10 fit in 80?",
        "10 &times; ___ = 80",
        "= 8"
      ],
      "answer": "= 8",
      "explanation": "Division is the inverse of multiplication."
    },
