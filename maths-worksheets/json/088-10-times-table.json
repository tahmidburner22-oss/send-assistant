{
  "title": "MULTIPLICATION,\n(TEN TIMES TABLE)",
  "objective": "LO: I can recall and use the 10 times table to multiply and divide.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What is the 10 times table?",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">10 times table</span> is a list of <span class=\"ul-k\">multiples</span> of 10: numbers we get when we count in 10s. Numbers in the 10 times table always end in 0."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Skip-count in 10s on your fingers, or use a number line. Each jump adds 10."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Multiples of 10",
      "examples": [
        {
          "correct": true,
          "expr": "1 &times; 10 = 10",
          "desc": "starting point"
        },
        {
          "correct": true,
          "expr": "2 &times; 10 = 20",
          "desc": "double"
        },
        {
          "correct": true,
          "expr": "5 &times; 10 = 50",
          "desc": "halfway to 10"
        },
        {
          "correct": false,
          "expr": "3 &times; 10 = 31",
          "desc": "wrong"
        },
        {
          "correct": false,
          "expr": "10 &times; 0 = 10",
          "desc": "any &times; 0 = 0"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiplication is repeated addition. 10 &times; 4 means &lsquo;4 groups of 10&rsquo;. You can also think of it as &lsquo;10 groups of 4&rsquo; — the answer is the same.",
      "equation": "<span class=\"ov\">10</span> + <span class=\"ov\">10</span> + <span class=\"ov\">10</span> + <span class=\"ov\">10</span> = <span class=\"ovr\">10&times;4 = 40</span>",
      "caption": "Four groups of 10"
    }
  },
  "modelled_examples": [
