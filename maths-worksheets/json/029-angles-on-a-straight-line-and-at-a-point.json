    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; angles on a straight line",
      "question": "Angles of 110&deg; and x are on a straight line. Find x.",
      "steps": [
        "Angles on a straight line = 180&deg;",
        "110 + x = 180",
        "x = 180 &minus; 110 = 70&deg;"
      ],
      "answer": "x = 70&deg;",
      "explanation": "Subtract the known angle from 180&deg;."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; three angles on a line",
      "question": "Three angles on a straight line are 40&deg;, 85&deg; and x. Find x.",
      "steps": [
        "40 + 85 + x = 180",
        "125 + x = 180",
        "x = 55&deg;"
      ],
      "answer": "x = 55&deg;",
      "explanation": "Add the known angles, then subtract from 180&deg;."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; angles at a point",
      "question": "Three angles at a point are 120&deg;, 150&deg; and x. Find x.",
      "steps": [
        "Angles at a point = 360&deg;",
        "120 + 150 + x = 360",
        "x = 360 &minus; 270 = 90&deg;"
      ],
      "answer": "x = 90&deg;",
      "explanation": "Subtract total of known angles from 360&deg;."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; vertically opposite",
      "question": "Two lines cross. One angle is 65&deg;. Find all four angles.",
      "steps": [
        "Vertically opposite to 65&deg; is also 65&deg;",
        "Adjacent angle: 180 &minus; 65 = 115&deg;",
        "The four angles: 65&deg;, 115&deg;, 65&deg;, 115&deg;"
      ],
      "answer": "65&deg;, 115&deg;, 65&deg;, 115&deg;",
      "explanation": "Opposite angles equal; adjacent angles sum to 180&deg;."
    }
  ],
