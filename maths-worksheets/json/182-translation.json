{
  "title": "TRANSFORMATIONS,\n(TRANSLATION)",
  "objective": "LO: I can translate shapes using a column vector.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Translation",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">translation</span> slides a shape without rotating or flipping it. It is described by a <span class=\"ul-k\">column vector</span> that shows the horizontal and vertical movement."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Column vector:</span> The top number is the horizontal shift (positive = right) and the bottom number is the vertical shift (positive = up)."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "Vector (3, 2) means 3 right and 2 up",
          "desc": "positive values"
        },
        {
          "correct": true,
          "expr": "Vector (-2, -4) means 2 left and 4 down",
          "desc": "negative values"
        },
        {
          "correct": true,
          "expr": "(5, 1) translated by (3, -2) gives (8, -1)",
          "desc": "add the vector"
        },
        {
          "correct": false,
          "expr": "Vector (3, 2) means 3 up and 2 right",
          "desc": "top is horizontal, bottom is vertical"
        },
        {
          "correct": false,
          "expr": "Translation changes the size of the shape",
          "desc": "shape and size are preserved"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Add the column vector to each vertex: new x = x + horizontal, new y = y + vertical.",
      "equation": "<span class=\"ov\">(x, y)</span> + (a, b) = <span class=\"ovr\">(x+a, y+b)</span>",
      "caption": "Every point moves by the same vector"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; positive translation",
      "question": "Translate (2, 3) by vector (4, 1).",
      "steps": [
        "Add horizontal: 2 + 4 = 6",
        "Add vertical: 3 + 1 = 4",
        "Image: (6, 4)"
      ],
      "answer": "(6, 4)",
      "explanation": "Simply add the vector components to the coordinates."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; negative components",
      "question": "Translate (5, 7) by vector (-3, -2).",
      "steps": [
        "Horizontal: 5 + (-3) = 2",
        "Vertical: 7 + (-2) = 5",
        "Image: (2, 5)"
      ],
      "answer": "(2, 5)",
      "explanation": "Negative values mean left and down."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; finding the vector",
      "question": "A is at (1, 4) and its image A′ is at (5, 2). Find the translation vector.",
      "steps": [
        "Horizontal: 5 - 1 = 4",
        "Vertical: 2 - 4 = -2",
        "Vector = (4, -2)"
      ],
      "answer": "(4, -2)",
      "explanation": "Subtract original from image to find the vector."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; translating a shape",
      "question": "Translate triangle (1,1), (3,1), (2,4) by vector (-2, 3).",
      "steps": [
        "(1,1) + (-2,3) = (-1, 4)",
        "(3,1) + (-2,3) = (1, 4)",
        "(2,4) + (-2,3) = (0, 7)"
      ],
      "answer": "(-1,4), (1,4), (0,7)",
      "explanation": "Apply the same vector to every vertex."
    }
  ],
