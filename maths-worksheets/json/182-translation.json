{
  "title": "TRANSFORMATIONS,\n(TRANSLATION)",
  "objective": "LO: I can translate shapes using column vectors and describe translations.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Translation",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">translation</span> slides every point of a shape the same distance in the same direction. It is described by a <span class=\"ul-k\">column vector</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Column vector:</span> The top number is horizontal movement (+ right, &minus; left). The bottom is vertical (+ up, &minus; down)."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "Vector (3, &minus;2): right 3, down 2",
          "desc": "positive x, negative y"
        },
        {
          "correct": true,
          "expr": "(2,5) translated by (3,1) = (5,6)",
          "desc": "add vector"
        },
        {
          "correct": true,
          "expr": "Translation preserves size, shape and orientation",
          "desc": "no rotation"
        },
        {
          "correct": false,
          "expr": "Vector (3, &minus;2) means left 3, up 2",
          "desc": "positive = right/up"
        },
        {
          "correct": false,
          "expr": "Translation changes the size of the shape",
          "desc": "only position changes"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Add the column vector to each point: new point = original + vector.",
      "equation": "(x, y) + <span class=\"ov\">(a, b)</span> = <span class=\"ovr\">(x+a, y+b)</span>",
      "caption": "a = horizontal shift, b = vertical shift"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; applying a vector",
      "question": "Translate (3, 2) by the vector (4, &minus;1).",
      "steps": [
        "Add horizontal: 3 + 4 = 7",
        "Add vertical: 2 + (&minus;1) = 1",
        "Image: (7, 1)"
      ],
      "answer": "(7, 1)",
      "explanation": "Add each component of the vector to the corresponding coordinate."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; negative vector",
      "question": "Translate (5, 3) by the vector (&minus;2, &minus;4).",
      "steps": [
        "Add horizontal: 5 + (&minus;2) = 3",
        "Add vertical: 3 + (&minus;4) = &minus;1",
        "Image: (3, &minus;1)"
      ],
      "answer": "(3, &minus;1)",
      "explanation": "Negative components move left or down."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; describing a translation",
      "question": "(1, 4) is mapped to (5, 2). Describe the translation.",
      "steps": [
        "Horizontal: 5 &minus; 1 = 4 (right)",
        "Vertical: 2 &minus; 4 = &minus;2 (down)",
        "Vector: (4, &minus;2)"
      ],
      "answer": "Translation by vector (4, &minus;2)",
      "explanation": "Subtract original from image to find the vector."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; translating a shape",
      "question": "Triangle (1,1), (3,1), (2,4) translated by (&minus;3, 2).",
      "steps": [
        "(1,1) &rarr; (&minus;2, 3)",
        "(3,1) &rarr; (0, 3)",
        "(2,4) &rarr; (&minus;1, 6)"
      ],
      "answer": "(&minus;2,3), (0,3), (&minus;1,6)",
      "explanation": "Apply the same vector to every vertex."
    }
  ],
