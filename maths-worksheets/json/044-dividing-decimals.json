{
  "title": "DECIMALS,\n(DIVIDING DECIMALS)",
  "objective": "LO: I can divide decimal numbers by whole numbers and by other decimals.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Dividing decimals",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"ul-b\">divide a decimal</span> by a whole number, use short/long division keeping the <span class=\"ul-k\">decimal point</span> in the same position in the answer."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Dividing by a decimal:</span> Multiply both numbers by 10 (or 100) to make the divisor a whole number, then divide as normal."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key methods",
      "examples": [
        {
          "correct": true,
          "expr": "8.4 &divide; 4 = 2.1",
          "desc": "decimal point stays"
        },
        {
          "correct": true,
          "expr": "3.6 &divide; 0.6 = 36 &divide; 6 = 6",
          "desc": "multiply both by 10"
        },
        {
          "correct": true,
          "expr": "12.5 &divide; 0.5 = 125 &divide; 5 = 25",
          "desc": "equivalent division"
        },
        {
          "correct": false,
          "expr": "8.4 &divide; 4 = 21",
          "desc": "forgot decimal point"
        },
        {
          "correct": false,
          "expr": "3.6 &divide; 0.6: only multiply top by 10",
          "desc": "must multiply both"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "If dividing by a decimal, multiply both numbers by 10 or 100 to make the divisor a whole number.",
      "equation": "<span class=\"ov\">3.6 &divide; 0.6</span> = 36 &divide; 6 = <span class=\"ovr\">6</span>",
      "caption": "Make the divisor whole"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; decimal by whole number",
      "question": "Calculate 9.6 &divide; 4",
      "steps": [
        "Set up short division: 9.6 &divide; 4",
        "9 &divide; 4 = 2 r 1; bring down 16 &divide; 4 = 4",
        "Keep decimal point aligned: 2.4"
      ],
      "answer": "= 2.4",
      "explanation": "The decimal point stays in the same place."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; by a single-digit",
      "question": "Calculate 15.75 &divide; 5",
      "steps": [
        "15 &divide; 5 = 3",
        "7 &divide; 5 = 1 r 2; 25 &divide; 5 = 5",
        "= 3.15"
      ],
      "answer": "= 3.15",
      "explanation": "Work digit by digit; carry remainders."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; dividing by a decimal",
      "question": "Calculate 4.8 &divide; 0.6",
      "steps": [
        "Multiply both by 10: 48 &divide; 6",
        "48 &divide; 6 = 8",
        "= 8"
      ],
      "answer": "= 8",
      "explanation": "Equivalent division: both &times;10 doesn't change the answer."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; dividing by 0.2",
      "question": "Calculate 7.5 &divide; 0.25",
      "steps": [
        "Multiply both by 100: 750 &divide; 25",
        "750 &divide; 25 = 30",
        "= 30"
      ],
      "answer": "= 30",
      "explanation": "Multiply by 100 because the divisor has 2 decimal places."
    }
  ],
