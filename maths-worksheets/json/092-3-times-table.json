{
  "title": "MULTIPLICATION,\n(THREE TIMES TABLE)",
  "objective": "LO: I can recall and use the 3 times table to multiply and divide.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What is the 3 times table?",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">3 times table</span> is a list of <span class=\"ul-k\">multiples</span> of 3: numbers we get when we count in 3s. The digits of every multiple of 3 add up to a multiple of 3 (e.g. 27 &rarr; 2+7 = 9)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Skip-count in 3s on your fingers, or use a number line. Each jump adds 3."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Multiples of 3",
      "examples": [
        {
          "correct": true,
          "expr": "1 &times; 3 = 3",
          "desc": "starting point"
        },
        {
          "correct": true,
          "expr": "2 &times; 3 = 6",
          "desc": "double"
        },
        {
          "correct": true,
          "expr": "5 &times; 3 = 15",
          "desc": "halfway to 10"
        },
        {
          "correct": false,
          "expr": "3 &times; 3 = 10",
          "desc": "wrong"
        },
        {
          "correct": false,
          "expr": "3 &times; 0 = 3",
          "desc": "any &times; 0 = 0"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiplication is repeated addition. 3 &times; 4 means &lsquo;4 groups of 3&rsquo;. You can also think of it as &lsquo;3 groups of 4&rsquo; — the answer is the same.",
      "equation": "<span class=\"ov\">3</span> + <span class=\"ov\">3</span> + <span class=\"ov\">3</span> + <span class=\"ov\">3</span> = <span class=\"ovr\">3&times;4 = 12</span>",
      "caption": "Four groups of 3"
    }
  },
