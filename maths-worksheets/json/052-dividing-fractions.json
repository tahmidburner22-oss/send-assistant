{
  "title": "FRACTIONS (SECONDARY),\n(DIVIDING FRACTIONS)",
  "objective": "LO: I can divide fractions by flipping the second fraction and multiplying (KFC method).",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Dividing fractions",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"ul-b\">divide by a fraction</span>, <span class=\"ul-k\">Keep</span> the first fraction, <span class=\"ul-k\">Flip</span> the second (reciprocal), then <span class=\"ul-k\">Change</span> to multiplication (KFC)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Reciprocal:</span> The reciprocal of &frac{a}{b} is &frac{b}{a}. Flip the fraction upside down."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "KFC method",
      "examples": [
        {
          "correct": true,
          "expr": "&frac{2}{3} &divide; &frac{1}{4} = &frac{2}{3} &times; &frac{4}{1} = &frac{8}{3}",
          "desc": "flip and multiply"
        },
        {
          "correct": true,
          "expr": "&frac{3}{5} &divide; 2 = &frac{3}{5} &times; &frac{1}{2} = &frac{3}{10}",
          "desc": "2 = &frac{2}{1}"
        },
        {
          "correct": true,
          "expr": "Reciprocal of &frac{3}{4} is &frac{4}{3}",
          "desc": "flip"
        },
        {
          "correct": false,
          "expr": "&frac{2}{3} &divide; &frac{1}{4} = &frac{2}{12}",
          "desc": "did not flip"
        },
        {
          "correct": false,
          "expr": "Flip the first fraction",
          "desc": "flip the SECOND"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Keep the first fraction. Flip the second. Change &divide; to &times;.",
      "equation": "<span class=\"ov\">&frac{a}{b}</span> &divide; <span class=\"ov\">&frac{c}{d}</span> = &frac{a}{b} &times; <span class=\"ovr\">&frac{d}{c}</span>",
      "caption": "KFC: Keep, Flip, Change"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; basic division",
      "question": "Calculate &frac{3}{4} &divide; &frac{1}{2}",
      "steps": [
        "Keep: &frac{3}{4}. Flip: &frac{1}{2} becomes &frac{2}{1}",
        "Multiply: &frac{3}{4} &times; &frac{2}{1} = &frac{6}{4}",
        "Simplify: &frac{6}{4} = &frac{3}{2} = 1&frac{1}{2}"
      ],
      "answer": "= 1&frac{1}{2}",
      "explanation": "Flip the second fraction then multiply across."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; dividing by a whole number",
      "question": "Calculate &frac{2}{5} &divide; 3",
      "steps": [
        "Write 3 as &frac{3}{1}",
        "Flip: &frac{3}{1} becomes &frac{1}{3}",
        "Multiply: &frac{2}{5} &times; &frac{1}{3} = &frac{2}{15}"
      ],
      "answer": "= &frac{2}{15}",
      "explanation": "A whole number n = &frac{n}{1}. Its reciprocal is &frac{1}{n}."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; both improper",
      "question": "Calculate &frac{5}{6} &divide; &frac{5}{3}",
      "steps": [
        "Keep &frac{5}{6}. Flip &frac{5}{3} to &frac{3}{5}",
        "Multiply: &frac{5}{6} &times; &frac{3}{5} = &frac{15}{30}",
        "Simplify: &frac{15}{30} = &frac{1}{2}"
      ],
      "answer": "= &frac{1}{2}",
      "explanation": "Cancel before multiplying if possible: &frac{5}{6} &times; &frac{3}{5} = &frac{1}{2}."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; mixed numbers",
      "question": "Calculate 2&frac{1}{2} &divide; 1&frac{1}{4}",
      "steps": [
        "Convert: &frac{5}{2} &divide; &frac{5}{4}",
        "Flip: &frac{5}{2} &times; &frac{4}{5}",
        "= &frac{20}{10} = 2"
      ],
      "answer": "= 2",
      "explanation": "Convert mixed numbers to improper fractions first."
    }
  ],
