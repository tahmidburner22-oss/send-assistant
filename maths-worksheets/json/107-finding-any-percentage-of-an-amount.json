{
  "title": "PERCENTAGES OF AMOUNTS,\n(FINDING ANY PERCENTAGE OF AN AMOUNT)",
  "objective": "LO: I can find any percentage of an amount using a calculator or written method.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Finding any percentage",
      "content": [
        {
          "type": "paragraph",
          "text": "To find <span class=\"\u0001\">any percentage</span> of an amount, write the percentage as a <span class=\"\u0001\">decimal</span> or fraction and multiply. This method works for whole and decimal percentages."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Method:</span> Convert the percentage to a decimal (divide by 100), then multiply by the amount."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "23% of 400 = 0.23 &times; 400 = 92",
          "desc": "decimal multiplier"
        },
        {
          "correct": true,
          "expr": "7.5% of 80 = 0.075 &times; 80 = 6",
          "desc": "decimal percentage"
        },
        {
          "correct": true,
          "expr": "110% of 50 = 1.10 &times; 50 = 55",
          "desc": "more than 100%"
        },
        {
          "correct": false,
          "expr": "23% of 400 = 23 &times; 400",
          "desc": "must divide 23 by 100 first"
        },
        {
          "correct": false,
          "expr": "7.5% of 80 = 7.5 &times; 80 = 600",
          "desc": "forgot to convert to decimal"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Any percentage can be found by converting to a decimal and multiplying.",
      "equation": "<span class=\"\u0001\">P</span>% of n = <span class=\"\u0001\">&frac{P}{100}</span> &times; n",
      "caption": "Works for any P, including decimals and values over 100"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; whole number percentage",
      "question": "Find 37% of 250",
      "steps": [
        "Convert: 37% = 0.37",
        "0.37 &times; 250",
        "= 92.5"
      ],
      "answer": "= 92.5",
      "explanation": "Divide the percentage by 100 to get the decimal multiplier."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; decimal percentage",
      "question": "Find 3.5% of 600",
      "steps": [
        "Convert: 3.5% = 0.035",
        "0.035 &times; 600",
        "= 21"
      ],
      "answer": "= 21",
      "explanation": "Decimal percentages work the same way."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; percentage over 100",
      "question": "Find 125% of 80",
      "steps": [
        "Convert: 125% = 1.25",
        "1.25 &times; 80",
        "= 100"
      ],
      "answer": "= 100",
      "explanation": "Percentages over 100% give values larger than the original."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; real-world context",
      "question": "A phone costs &pound;480. There is 3.5% cashback. How much cashback?",
      "steps": [
        "Convert: 3.5% = 0.035",
        "0.035 &times; 480",
        "= &pound;16.80"
      ],
      "answer": "= &pound;16.80",
      "explanation": "Same decimal multiplier method applied to money."
    }
  ],
