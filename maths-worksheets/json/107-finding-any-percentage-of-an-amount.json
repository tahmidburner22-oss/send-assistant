{
  "title": "PERCENTAGES OF AMOUNTS,\n(FINDING ANY PERCENTAGE OF AN AMOUNT)",
  "objective": "LO: I can find any percentage of an amount using appropriate methods.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Methods for finding percentages",
      "content": [
        {
          "type": "paragraph",
          "text": "To find <span class=\"ul-b\">any percentage</span> of an amount, you can use the <span class=\"ul-k\">decimal method</span> (convert % to a decimal and multiply) or the <span class=\"ul-k\">building-up method</span> (use 10%, 5%, 1% blocks)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Calculator method:</span> amount &times; percentage &divide; 100. Or simply amount &times; decimal."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "23% of 400 = 400 &times; 0.23 = 92",
          "desc": "decimal method"
        },
        {
          "correct": true,
          "expr": "17% of 300 = 30 + 21 = 51",
          "desc": "10% + 7%"
        },
        {
          "correct": true,
          "expr": "8.5% of 200 = 17",
          "desc": "200 &times; 0.085"
        },
        {
          "correct": false,
          "expr": "23% of 400 = 23 &times; 4 = 92 but method was % &divide; amount",
          "desc": "method matters"
        },
        {
          "correct": false,
          "expr": "0.7% of 1000 = 70",
          "desc": "0.7% = 0.007, answer is 7"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Convert the percentage to a decimal by dividing by 100, then multiply by the amount.",
      "equation": "<span class=\"ov\">23%</span> of 400 = 0.23 &times; 400 = <span class=\"ovr\">92</span>",
      "caption": "Percentage &divide; 100 = decimal multiplier"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; decimal method",
      "question": "Find 34% of &pound;650.",
      "steps": [
        "Convert: 34% = 0.34",
        "650 &times; 0.34",
        "= &pound;221"
      ],
      "answer": "&pound;221",
      "explanation": "Convert the percentage to a decimal and multiply."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; building-up method",
      "question": "Find 17% of &pound;400.",
      "steps": [
        "10% of 400 = 40",
        "5% = 20; 2% = 8",
        "17% = 40 + 20 + 8 &minus; 12... Actually: 10% + 5% + 2% = 40 + 20 + 8 = 68"
      ],
      "answer": "&pound;68",
      "explanation": "Build percentages from 10%, 5%, and 1% blocks."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; small percentage",
      "question": "Find 3.5% of &pound;2000.",
      "steps": [
        "1% of 2000 = 20",
        "3% = 60; 0.5% = 10",
        "3.5% = 60 + 10 = &pound;70"
      ],
      "answer": "&pound;70",
      "explanation": "For decimal percentages, use 1% and halves as building blocks."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; in context",
      "question": "A bank charges 2.8% interest on a &pound;5000 loan. Find the annual interest.",
      "steps": [
        "Convert: 2.8% = 0.028",
        "5000 &times; 0.028",
        "= &pound;140"
      ],
      "answer": "&pound;140",
      "explanation": "Always multiply by the decimal equivalent of the percentage."
    }
  ],
