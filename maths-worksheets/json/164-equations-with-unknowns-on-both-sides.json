  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Unknowns on both sides",
      "content": [
        {
          "type": "paragraph",
          "text": "When <span class=\"ul-b\">x appears on both sides</span> of the equation, collect all x terms on one side and all number terms on the other by using <span class=\"ul-k\">inverse operations</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Move the smaller x term to the other side (to keep x positive), then isolate x."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "5x + 3 = 2x + 12: subtract 2x, get 3x + 3 = 12, x = 3",
          "desc": "collect x terms"
        },
        {
          "correct": true,
          "expr": "7x &minus; 4 = 3x + 8: subtract 3x, get 4x &minus; 4 = 8, x = 3",
          "desc": "move smaller x"
        },
        {
          "correct": true,
          "expr": "Always move the smaller x coefficient to keep x positive",
          "desc": "good practice"
        },
        {
          "correct": false,
          "expr": "5x + 3 = 2x + 12 gives 7x = 15",
          "desc": "cannot add x terms across ="
        },
        {
          "correct": false,
          "expr": "5x + 3 = 2x + 12 gives 3x = 15 directly",
          "desc": "forgot to subtract 3 from both sides"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Collect x terms on one side, number terms on the other, then solve.",
      "equation": "<span class=\"ov\">5x</span> + 3 = <span class=\"ovr\">2x</span> + 12 &rArr; 3x = 9 &rArr; x = 3",
      "caption": "Subtract 2x from both sides, then subtract 3 from both sides"
    }
  },
  "modelled_examples": [
