      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; larger coefficient on right",
      "question": "Solve 2x + 9 = 5x &minus; 3",
      "steps": [
        "Subtract 2x: 9 = 3x &minus; 3",
        "Add 3: 12 = 3x",
        "Divide by 3: x = 4"
      ],
      "answer": "x = 4",
      "explanation": "Move 2x to keep x positive on the right."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; negative terms",
      "question": "Solve 6x &minus; 5 = 4x + 7",
      "steps": [
        "Subtract 4x: 2x &minus; 5 = 7",
        "Add 5: 2x = 12",
        "Divide by 2: x = 6"
      ],
      "answer": "x = 6",
      "explanation": "Subtract the smaller x coefficient from both sides."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; with brackets",
      "question": "Solve 3(x + 2) = x + 14",
      "steps": [
        "Expand: 3x + 6 = x + 14",
        "Subtract x: 2x + 6 = 14",
        "Subtract 6: 2x = 8, x = 4"
      ],
      "answer": "x = 4",
      "explanation": "Expand brackets first, then collect like terms."
    }
  ],
