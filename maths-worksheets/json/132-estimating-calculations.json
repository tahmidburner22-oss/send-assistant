{
  "title": "PLACE VALUE AND ORDERING INTEGERS,\n(ESTIMATING CALCULATIONS)",
  "objective": "LO: I can estimate the answer to calculations by rounding to appropriate values.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Estimation",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Estimating</span> means finding an <span class=\"ul-k\">approximate answer</span> by rounding numbers to 1 significant figure (or to convenient values) before calculating."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Purpose:</span> Estimation helps check calculator answers and gives a quick sense of the size of an answer."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "4.8 &times; 21.3 &asymp; 5 &times; 20 = 100",
          "desc": "round to 1 sf"
        },
        {
          "correct": true,
          "expr": "198 &divide; 4.1 &asymp; 200 &divide; 4 = 50",
          "desc": "round to convenient"
        },
        {
          "correct": true,
          "expr": "&radic;26 &asymp; 5 (since 5&sup2; = 25)",
          "desc": "nearest square"
        },
        {
          "correct": false,
          "expr": "4.8 &times; 21.3 &asymp; 4 &times; 21 = 84",
          "desc": "round to 1 sf not truncate"
        },
        {
          "correct": false,
          "expr": "Estimates must be exact",
          "desc": "they are approximate"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Round each number to 1 significant figure, then calculate. Use &asymp; to show approximation.",
      "equation": "<span class=\"ov\">4.8 &times; 21.3</span> &asymp; <span class=\"ovr\">5 &times; 20 = 100</span>",
      "caption": "Round first, then do the simple calculation"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; multiplication",
      "question": "Estimate 6.2 &times; 48.",
      "steps": [
        "Round: 6.2 &asymp; 6, 48 &asymp; 50",
        "6 &times; 50",
        "= 300"
      ],
      "answer": "&asymp; 300",
      "explanation": "Round to 1 sf then multiply."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; division",
      "question": "Estimate 312 &divide; 5.8.",
      "steps": [
        "Round: 312 &asymp; 300, 5.8 &asymp; 6",
        "300 &divide; 6",
        "= 50"
      ],
      "answer": "&asymp; 50",
      "explanation": "Round to 1 sf then divide."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; combined",
      "question": "Estimate (4.9 &times; 11.2) &divide; 2.3.",
      "steps": [
        "Round: 5 &times; 11 &divide; 2 or 5 &times; 10 &divide; 2",
        "= 50 &divide; 2",
        "= 25"
      ],
      "answer": "&asymp; 25",
      "explanation": "Round all values, then apply BIDMAS."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; square roots",
      "question": "Estimate &radic;85.",
      "steps": [
        "81 = 9&sup2;, 100 = 10&sup2;",
        "85 is between 81 and 100, closer to 81",
        "&asymp; 9.2"
      ],
      "answer": "&asymp; 9.2",
      "explanation": "Find the nearest perfect squares above and below."
    }
