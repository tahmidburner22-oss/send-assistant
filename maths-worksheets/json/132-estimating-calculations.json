{
  "title": "PLACE VALUE AND ORDERING INTEGERS,\n(ESTIMATING CALCULATIONS)",
  "objective": "LO: I can estimate answers to calculations by rounding numbers to one significant figure.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Estimating calculations",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"\u0001\">estimate</span> a calculation, round each number to <span class=\"\u0001\">one significant figure</span> (1 s.f.) first, then perform the calculation with the rounded values."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Why estimate?</span> Estimating checks your answer is sensible and helps spot errors."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "48 &times; 31 &asymp; 50 &times; 30 = 1500",
          "desc": "round to 1 s.f."
        },
        {
          "correct": true,
          "expr": "198 &divide; 4.1 &asymp; 200 &divide; 4 = 50",
          "desc": "round each number"
        },
        {
          "correct": true,
          "expr": "&radic;26 &asymp; &radic;25 = 5",
          "desc": "round to nearest square"
        },
        {
          "correct": false,
          "expr": "48 &times; 31 &asymp; 48 &times; 30 = 1440",
          "desc": "must round both numbers"
        },
        {
          "correct": false,
          "expr": "3.7 rounded to 1 s.f. is 3",
          "desc": "should be 4"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Round every number to 1 significant figure, then calculate. The symbol &asymp; means approximately equal to.",
      "equation": "<span class=\"\u0001\">3.8 &times; 19.6</span> &asymp; <span class=\"\u0001\">4 &times; 20</span> = 80",
      "caption": "Round each value to 1 s.f. before calculating"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; multiplication estimate",
      "question": "Estimate 38 &times; 52",
      "steps": [
        "Round: 38 &asymp; 40, 52 &asymp; 50",
        "40 &times; 50",
        "= 2000"
      ],
      "answer": "&asymp; 2000",
      "explanation": "Both numbers rounded to 1 significant figure."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; division estimate",
      "question": "Estimate 412 &divide; 7.8",
      "steps": [
        "Round: 412 &asymp; 400, 7.8 &asymp; 8",
        "400 &divide; 8",
        "= 50"
      ],
      "answer": "&asymp; 50",
      "explanation": "Choose values that make the division easier."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; combined operations",
      "question": "Estimate (4.9 &times; 21.3) &divide; 0.48",
      "steps": [
        "Round: 4.9 &asymp; 5, 21.3 &asymp; 20, 0.48 &asymp; 0.5",
        "(5 &times; 20) &divide; 0.5 = 100 &divide; 0.5",
        "= 200"
      ],
      "answer": "&asymp; 200",
      "explanation": "Follow BIDMAS after rounding."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; with square roots",
      "question": "Estimate &radic;(63) &times; 4.2",
      "steps": [
        "Round: &radic;63 &asymp; &radic;64 = 8, 4.2 &asymp; 4",
        "8 &times; 4",
        "= 32"
      ],
      "answer": "&asymp; 32",
      "explanation": "For square roots, round to the nearest perfect square."
    }
  ],
