{
  "title": "STRAIGHT-LINE GRAPHS,\n(GRADIENT AND Y-INTERCEPT)",
  "objective": "LO: I can calculate the gradient of a line and identify the y-intercept from a graph or coordinates.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Gradient and y-intercept",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">gradient</span> measures how steep a line is: rise &divide; run. A positive gradient slopes upward; a negative gradient slopes <span class=\"ul-k\">downward</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Y-intercept:</span> The point where the line crosses the y-axis (where x = 0). Written as (0, c)."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "Gradient = (y₂ - y₁) &divide; (x₂ - x₁)",
          "desc": "rise over run"
        },
        {
          "correct": true,
          "expr": "Points (1, 3) and (4, 9): m = 6 &divide; 3 = 2",
          "desc": "change in y over change in x"
        },
        {
          "correct": true,
          "expr": "Horizontal line has gradient 0",
          "desc": "no rise"
        },
        {
          "correct": false,
          "expr": "Gradient = run &divide; rise",
          "desc": "it is rise &divide; run"
        },
        {
          "correct": false,
          "expr": "Vertical line has gradient 0",
          "desc": "it is undefined"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Gradient = change in y divided by change in x. Pick any two points on the line.",
      "equation": "m = <span class=\"ov\">y₂ - y₁</span> &divide; <span class=\"ovr\">x₂ - x₁</span>",
      "caption": "Rise over run"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; from two points",
      "question": "Find the gradient of the line through (2, 3) and (5, 9).",
      "steps": [
        "Rise = 9 - 3 = 6",
        "Run = 5 - 2 = 3",
        "Gradient = 6 &divide; 3 = 2"
      ],
      "answer": "m = 2",
      "explanation": "Subtract y-values for rise, x-values for run."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; negative gradient",
      "question": "Find the gradient of the line through (1, 7) and (4, 1).",
      "steps": [
        "Rise = 1 - 7 = -6",
        "Run = 4 - 1 = 3",
        "Gradient = -6 &divide; 3 = -2"
      ],
      "answer": "m = -2",
      "explanation": "A negative answer means the line slopes downward."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; from a graph",
      "question": "A line passes through (0, 4) and (3, 4). Find the gradient.",
      "steps": [
        "Rise = 4 - 4 = 0",
        "Run = 3 - 0 = 3",
        "Gradient = 0 &divide; 3 = 0"
      ],
      "answer": "m = 0",
      "explanation": "A horizontal line has zero gradient."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; finding the y-intercept",
      "question": "A line has gradient 3 and passes through (2, 8). Find the y-intercept.",
      "steps": [
        "Use y = mx + c: 8 = 3(2) + c",
        "8 = 6 + c",
        "c = 2, so y-intercept is (0, 2)"
      ],
      "answer": "y-intercept = 2",
      "explanation": "Substitute a known point into y = mx + c to find c."
    }
  ],
