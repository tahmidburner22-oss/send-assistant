{
  "title": "STRAIGHT-LINE GRAPHS,\n(GRADIENT AND Y-INTERCEPT)",
  "objective": "LO: I can find the gradient and y-intercept of a line from its graph or equation.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Gradient and y-intercept",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">gradient</span> measures how steep a line is. Positive gradient goes up from left to right; negative goes down. The <span class=\"ul-k\">y-intercept</span> is where the line crosses the y-axis (x = 0)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Reading from a graph:</span> Pick two points, count the rise (up/down) and run (across). Gradient = rise &divide; run."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "Rise 6, run 2 &rarr; gradient = 3",
          "desc": "divide rise by run"
        },
        {
          "correct": true,
          "expr": "Line goes down left to right &rarr; negative gradient",
          "desc": "sign matters"
        },
        {
          "correct": true,
          "expr": "Crosses y-axis at (0, &minus;4) &rarr; c = &minus;4",
          "desc": "read from graph"
        },
        {
          "correct": false,
          "expr": "Rise 2, run 6 &rarr; gradient = 6",
          "desc": "gradient = 2/6 = 1/3"
        },
        {
          "correct": false,
          "expr": "Steeper line has smaller gradient",
          "desc": "steeper = larger |m|"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Gradient = rise &divide; run (vertical change &divide; horizontal change). Read the y-intercept where x = 0.",
      "equation": "gradient = <span class=\"ov\">rise</span> &divide; <span class=\"ovr\">run</span>",
      "caption": "Positive = uphill, negative = downhill (left to right)"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; positive gradient from graph",
      "question": "A line passes through (1, 2) and (4, 8). Find the gradient.",
      "steps": [
        "Rise = 8 &minus; 2 = 6",
        "Run = 4 &minus; 1 = 3",
        "Gradient = 6 &divide; 3 = 2"
      ],
      "answer": "Gradient = 2",
      "explanation": "Count squares up (rise) and across (run) between two clear points."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; negative gradient",
      "question": "A line passes through (0, 6) and (3, 0). Find the gradient.",
      "steps": [
        "Rise = 0 &minus; 6 = &minus;6",
        "Run = 3 &minus; 0 = 3",
        "Gradient = &minus;6 &divide; 3 = &minus;2"
      ],
      "answer": "Gradient = &minus;2",
      "explanation": "The line goes down, so the gradient is negative."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; y-intercept from graph",
      "question": "A line crosses the y-axis at (0, &minus;3). What is c?",
      "steps": [
        "The y-intercept is where x = 0",
        "The line crosses at y = &minus;3",
        "So c = &minus;3"
      ],
      "answer": "c = &minus;3",
      "explanation": "Read the y-coordinate where the line meets the y-axis."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; from equation",
      "question": "Find the gradient and y-intercept of 2y = 6x &minus; 8.",
      "steps": [
        "Divide by 2: y = 3x &minus; 4",
        "Compare with y = mx + c",
        "Gradient = 3, y-intercept = &minus;4"
      ],
      "answer": "Gradient = 3, y-intercept = &minus;4",
      "explanation": "Rearrange to y = mx + c form to read off m and c."
    }
  ],
