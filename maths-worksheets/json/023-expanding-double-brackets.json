{
  "title": "ALGEBRAIC EXPRESSIONS,\n(EXPANDING DOUBLE BRACKETS)",
  "objective": "LO: I can expand the product of two binomials using the FOIL method or grid method.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What does expanding double brackets mean?",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Expanding double brackets</span> means multiplying two expressions like <span class=\"ul-k\">(x + 3)(x + 5)</span> to remove the brackets and write as a single expression."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">FOIL:</span> First, Outside, Inside, Last. Multiply each pair then collect like terms."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "(x + 2)(x + 3) = x&sup2; + 5x + 6",
          "desc": "FOIL"
        },
        {
          "correct": true,
          "expr": "(x + 4)(x &minus; 1) = x&sup2; + 3x &minus; 4",
          "desc": "mixed signs"
        },
        {
          "correct": true,
          "expr": "(x &minus; 3)(x &minus; 2) = x&sup2; &minus; 5x + 6",
          "desc": "both negative"
        },
        {
          "correct": false,
          "expr": "(x + 2)(x + 3) = x&sup2; + 6",
          "desc": "forgot middle term"
        },
        {
          "correct": false,
          "expr": "(x + 4)&sup2; = x&sup2; + 16",
          "desc": "must use FOIL"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiply each term in the first bracket by each term in the second bracket, then simplify by collecting like terms.",
      "equation": "(x + a)(x + b) = x&sup2; + <span class=\"ov\">(a + b)</span>x + <span class=\"ovr\">ab</span>",
      "caption": "Middle term = sum, last term = product"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; both positive",
      "question": "Expand (x + 2)(x + 5)",
      "steps": [
        "F: x &times; x = x&sup2;, O: x &times; 5 = 5x, I: 2 &times; x = 2x, L: 2 &times; 5 = 10",
        "Combine: x&sup2; + 5x + 2x + 10",
        "Simplify: x&sup2; + 7x + 10"
      ],
      "answer": "= x&sup2; + 7x + 10",
      "explanation": "Collect the two middle terms: 5x + 2x = 7x."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; one negative",
      "question": "Expand (x + 4)(x &minus; 3)",
      "steps": [
        "F: x&sup2;, O: &minus;3x, I: 4x, L: 4 &times; (&minus;3) = &minus;12",
        "Combine: x&sup2; &minus; 3x + 4x &minus; 12",
        "Simplify: x&sup2; + x &minus; 12"
      ],
      "answer": "= x&sup2; + x &minus; 12",
      "explanation": "Be careful with signs: +4 &times; &minus;3 = &minus;12."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; both negative",
      "question": "Expand (x &minus; 3)(x &minus; 4)",
      "steps": [
        "F: x&sup2;, O: &minus;4x, I: &minus;3x, L: (&minus;3)(&minus;4) = +12",
        "Combine: x&sup2; &minus; 4x &minus; 3x + 12",
        "Simplify: x&sup2; &minus; 7x + 12"
      ],
      "answer": "= x&sup2; &minus; 7x + 12",
      "explanation": "Negative &times; negative = positive for the last term."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; perfect square",
      "question": "Expand (x + 5)&sup2;",
      "steps": [
        "Write as (x + 5)(x + 5)",
        "F: x&sup2;, O: 5x, I: 5x, L: 25",
        "Simplify: x&sup2; + 10x + 25"
      ],
      "answer": "= x&sup2; + 10x + 25",
      "explanation": "A perfect square always gives x&sup2; + 2ax + a&sup2;."
    }
  ],
