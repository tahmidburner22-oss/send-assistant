{
  "title": "FRACTIONS (SECONDARY),\n(ADDING AND SUBTRACTING FRACTIONS)",
  "objective": "LO: I can add and subtract fractions with different denominators by finding a common denominator.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Adding and subtracting fractions",
      "content": [
        {
          "type": "paragraph",
          "text": "To add or subtract fractions with different <span class=\"ul-b\">denominators</span>, first find a <span class=\"ul-k\">common denominator</span> (usually the LCM), then add/subtract the numerators."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Steps:</span> 1) Find the LCM of denominators. 2) Convert both fractions. 3) Add/subtract numerators. 4) Simplify."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key steps",
      "examples": [
        {
          "correct": true,
          "expr": "&frac{1}{3} + &frac{1}{4} = &frac{4}{12} + &frac{3}{12} = &frac{7}{12}",
          "desc": "LCM = 12"
        },
        {
          "correct": true,
          "expr": "&frac{3}{4} &minus; &frac{1}{2} = &frac{3}{4} &minus; &frac{2}{4} = &frac{1}{4}",
          "desc": "LCM = 4"
        },
        {
          "correct": true,
          "expr": "Always simplify the final answer",
          "desc": "if possible"
        },
        {
          "correct": false,
          "expr": "&frac{1}{3} + &frac{1}{4} = &frac{2}{7}",
          "desc": "cannot add tops and bottoms"
        },
        {
          "correct": false,
          "expr": "&frac{1}{3} + &frac{1}{4} = &frac{1}{7}",
          "desc": "added both top and bottom"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Same denominator: just add/subtract numerators. Different: find the LCM first.",
      "equation": "<span class=\"ov\">&frac{a}{b}</span> + <span class=\"ov\">&frac{c}{d}</span> = <span class=\"ovr\">&frac{ad + bc}{bd}</span>",
      "caption": "Cross-multiply method (or use LCM)"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; same denominator",
      "question": "Calculate &frac{3}{8} + &frac{2}{8}",
      "steps": [
        "Same denominator: add numerators",
        "3 + 2 = 5",
        "&frac{5}{8}"
      ],
      "answer": "= &frac{5}{8}",
      "explanation": "When denominators match, just add the tops."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; different denominators",
      "question": "Calculate &frac{2}{3} + &frac{1}{4}",
      "steps": [
        "LCM of 3 and 4 is 12",
        "&frac{2}{3} = &frac{8}{12}; &frac{1}{4} = &frac{3}{12}",
        "&frac{8}{12} + &frac{3}{12} = &frac{11}{12}"
      ],
      "answer": "= &frac{11}{12}",
      "explanation": "Convert both to twelfths, then add."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; subtraction",
      "question": "Calculate &frac{5}{6} &minus; &frac{1}{4}",
      "steps": [
        "LCM of 6 and 4 is 12",
        "&frac{5}{6} = &frac{10}{12}; &frac{1}{4} = &frac{3}{12}",
        "&frac{10}{12} &minus; &frac{3}{12} = &frac{7}{12}"
      ],
      "answer": "= &frac{7}{12}",
      "explanation": "Same method: common denominator, then subtract numerators."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; mixed numbers",
      "question": "Calculate 1&frac{1}{2} + 2&frac{2}{3}",
      "steps": [
        "Convert: &frac{3}{2} + &frac{8}{3}",
        "LCM = 6: &frac{9}{6} + &frac{16}{6} = &frac{25}{6}",
        "= 4&frac{1}{6}"
      ],
      "answer": "= 4&frac{1}{6}",
      "explanation": "Convert to improper fractions, find common denominator, then convert back."
    }
  ],
