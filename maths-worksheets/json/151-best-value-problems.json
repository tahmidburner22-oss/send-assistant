{
  "title": "RATIO,\n(BEST VALUE PROBLEMS)",
  "objective": "LO: I can compare products using unit pricing to determine the best value.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Best value",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">best value</span> problem asks you to compare products by finding the <span class=\"ul-k\">price per unit</span> (per gram, per ml, per item) or the <span class=\"ul-k\">amount per pound</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Method:</span> Divide the price by the quantity (or vice versa) to find a common rate for comparison."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "500 g for &pound;2.00 = 0.4p/g",
          "desc": "price per gram"
        },
        {
          "correct": true,
          "expr": "750 ml for &pound;1.50 = 0.2p/ml",
          "desc": "price per ml"
        },
        {
          "correct": true,
          "expr": "Lower price per unit = better value",
          "desc": "compare rates"
        },
        {
          "correct": false,
          "expr": "Bigger pack is always better value",
          "desc": "not always true"
        },
        {
          "correct": false,
          "expr": "Cheapest total price = best value",
          "desc": "must compare per unit"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Best value = lowest price per unit. Divide price by quantity to compare.",
      "equation": "Price per unit = <span class=\"ov\">Price</span> &divide; <span class=\"ovr\">Quantity</span>",
      "caption": "The lowest rate is the best deal"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; price per gram",
      "question": "Pack A: 400 g for &pound;2.80. Pack B: 600 g for &pound;3.90. Which is better value?",
      "steps": [
        "A: 280p &divide; 400 = 0.70p per gram",
        "B: 390p &divide; 600 = 0.65p per gram",
        "Pack B is cheaper per gram"
      ],
      "answer": "Pack B (0.65p/g vs 0.70p/g)",
      "explanation": "Compare the price per gram to find the best deal."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; price per item",
      "question": "6-pack of juice for &pound;2.70 or 10-pack for &pound;4.20. Best value?",
      "steps": [
        "6-pack: 270p &divide; 6 = 45p each",
        "10-pack: 420p &divide; 10 = 42p each",
        "10-pack is better value"
      ],
      "answer": "10-pack (42p vs 45p each)",
      "explanation": "Divide total price by number of items."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; amount per pound",
      "question": "Shop A: 250 g of cheese for &pound;2.50. Shop B: 300 g for &pound;2.70.",
      "steps": [
        "A: 250 &divide; 2.50 = 100 g per pound",
        "B: 300 &divide; 2.70 = 111.1 g per pound",
        "Shop B gives more per pound"
      ],
      "answer": "Shop B (111 g/&pound; vs 100 g/&pound;)",
      "explanation": "You can also compare grams per pound."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; with offers",
      "question": "Normal: &pound;1.50 for 330 ml. Offer: 3 for &pound;4.00 (330 ml each). Better value?",
      "steps": [
        "Normal: 150p &divide; 330 = 0.45p/ml",
        "Offer: 400p &divide; 990 = 0.40p/ml",
        "Offer is better value"
      ],
      "answer": "Offer is better (0.40p/ml vs 0.45p/ml)",
      "explanation": "Calculate the total volume in the offer, then find price per ml."
    }
  ],
