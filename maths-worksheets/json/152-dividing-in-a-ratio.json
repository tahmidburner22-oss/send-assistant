{
  "title": "RATIO,\n(DIVIDING IN A RATIO)",
  "objective": "LO: I can divide a quantity in a given ratio.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Dividing in a ratio",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Dividing in a ratio</span> means splitting a total into parts according to a given <span class=\"\u0001\">ratio</span>. Find the total number of parts first."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Method:</span> Add the ratio parts. Divide the total by this sum to find one part. Multiply to find each share."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&pound;20 in ratio 3:2 = &pound;12 and &pound;8",
          "desc": "5 parts, &pound;4 each"
        },
        {
          "correct": true,
          "expr": "Ratio 1:3 means one quarter and three quarters",
          "desc": "fractions of total"
        },
        {
          "correct": true,
          "expr": "Total parts = sum of ratio numbers",
          "desc": "first step"
        },
        {
          "correct": false,
          "expr": "&pound;20 in ratio 3:2 = &pound;10 and &pound;10",
          "desc": "divided equally, not in ratio"
        },
        {
          "correct": false,
          "expr": "Ratio 3:2 means 3 and 2",
          "desc": "must multiply by value per part"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Add ratio parts. Divide total by number of parts. Multiply each ratio number by value of one part.",
      "equation": "<span class=\"\u0001\">Total</span> &divide; (a + b) = <span class=\"\u0001\">1 part</span>",
      "caption": "Then multiply: a parts and b parts"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; simple ratio",
      "question": "Divide &pound;35 in the ratio 3:4.",
      "steps": [
        "Total parts: 3 + 4 = 7",
        "One part: 35 &divide; 7 = &pound;5",
        "3 parts = &pound;15, 4 parts = &pound;20"
      ],
      "answer": "&pound;15 and &pound;20",
      "explanation": "Check: &pound;15 + &pound;20 = &pound;35."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; three-part ratio",
      "question": "Divide 60 kg in the ratio 1:2:3.",
      "steps": [
        "Total parts: 1 + 2 + 3 = 6",
        "One part: 60 &divide; 6 = 10 kg",
        "Shares: 10 kg, 20 kg, 30 kg"
      ],
      "answer": "10 kg, 20 kg, 30 kg",
      "explanation": "Same method works for three or more parts."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; finding the total",
      "question": "Money is shared in ratio 5:3. The larger share is &pound;40. Find the total.",
      "steps": [
        "Larger share = 5 parts = &pound;40",
        "One part = 40 &divide; 5 = &pound;8",
        "Total = 8 &times; 8 = &pound;64"
      ],
      "answer": "Total = &pound;64",
      "explanation": "Work backwards: find one part from the known share."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; finding the difference",
      "question": "Divide 80 in the ratio 7:3. Find the difference between the shares.",
      "steps": [
        "Total parts: 10. One part = 80 &divide; 10 = 8",
        "Shares: 56 and 24",
        "Difference: 56 - 24 = 32"
      ],
      "answer": "Difference = 32",
      "explanation": "Or: difference = (7-3) &times; 8 = 4 &times; 8 = 32."
    }
  ],
