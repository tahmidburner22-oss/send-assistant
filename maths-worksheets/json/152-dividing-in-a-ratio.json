{
  "title": "RATIO,\n(DIVIDING IN A RATIO)",
  "objective": "LO: I can divide a quantity into two or more parts in a given ratio.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Dividing in a ratio",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"ul-b\">divide in a ratio</span>, find the total number of <span class=\"ul-k\">parts</span>, divide the quantity by the total parts to find one part, then multiply each ratio number by the value of one part."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Check:</span> The parts must add back to the original total amount."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&pound;60 in ratio 2:3 = &pound;24 and &pound;36",
          "desc": "5 parts, 12 each"
        },
        {
          "correct": true,
          "expr": "Total parts = sum of ratio numbers",
          "desc": "2 + 3 = 5 parts"
        },
        {
          "correct": true,
          "expr": "One part = total &divide; sum of ratio",
          "desc": "60 &divide; 5 = 12"
        },
        {
          "correct": false,
          "expr": "&pound;60 in 2:3 = &pound;30 and &pound;30",
          "desc": "not equal shares"
        },
        {
          "correct": false,
          "expr": "2:3 means 2 parts out of 3",
          "desc": "it is 2 parts AND 3 parts = 5 total"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Total parts = sum of ratio. One part = amount &divide; total parts. Multiply each ratio number by one part.",
      "equation": "&pound;60 in 2:3 &rarr; one part = <span class=\"ov\">60 &divide; 5</span> = <span class=\"ovr\">12</span>",
      "caption": "Then 2 &times; 12 = 24 and 3 &times; 12 = 36"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; two-part ratio",
      "question": "Share &pound;80 in the ratio 3:5.",
      "steps": [
        "Total parts = 3 + 5 = 8",
        "One part = 80 &divide; 8 = &pound;10",
        "3 parts = &pound;30, 5 parts = &pound;50"
      ],
      "answer": "&pound;30 and &pound;50",
      "explanation": "Check: 30 + 50 = 80."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; three-part ratio",
      "question": "Divide 120 cm in the ratio 1:2:3.",
      "steps": [
        "Total parts = 1 + 2 + 3 = 6",
        "One part = 120 &divide; 6 = 20 cm",
        "Parts: 20, 40, 60 cm"
      ],
      "answer": "20 cm, 40 cm, 60 cm",
      "explanation": "Check: 20 + 40 + 60 = 120."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; find one amount",
      "question": "Ali and Ben share money in ratio 4:7. Ben gets &pound;35. How much does Ali get?",
      "steps": [
        "Ben's 7 parts = &pound;35",
        "One part = 35 &divide; 7 = &pound;5",
        "Ali's 4 parts = 4 &times; 5 = &pound;20"
      ],
      "answer": "Ali gets &pound;20",
      "explanation": "Use the known amount to find one part first."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; find the total",
      "question": "A drink is mixed in ratio 1:4 (concentrate:water). There are 200 ml of concentrate. Find the total.",
      "steps": [
        "1 part = 200 ml (concentrate)",
        "4 parts water = 4 &times; 200 = 800 ml",
        "Total = 200 + 800 = 1000 ml"
      ],
      "answer": "Total = 1000 ml",
      "explanation": "Find what one part equals from the given information."
    }
  ],
