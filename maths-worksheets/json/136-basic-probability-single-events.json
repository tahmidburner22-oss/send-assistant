{
  "title": "PROBABILITY,\n(BASIC PROBABILITY — SINGLE EVENTS)",
  "objective": "LO: I can calculate the probability of single events and place them on a probability scale.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What is probability?",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Probability</span> measures how likely an event is to happen, on a scale from <span class=\"ul-k\">0 (impossible) to 1 (certain)</span>. It can be written as a fraction, decimal or percentage."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Formula:</span> P(event) = number of favourable outcomes &divide; total number of possible outcomes."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "P(heads) = &frac{1}{2}",
          "desc": "one favourable out of two outcomes"
        },
        {
          "correct": true,
          "expr": "P(6 on a die) = &frac{1}{6}",
          "desc": "one out of six"
        },
        {
          "correct": true,
          "expr": "P(red from 3 red, 2 blue) = &frac{3}{5}",
          "desc": "3 out of 5"
        },
        {
          "correct": false,
          "expr": "P(6 on a die) = &frac{1}{3}",
          "desc": "there are 6 outcomes, not 3"
        },
        {
          "correct": false,
          "expr": "P(impossible) = &minus;1",
          "desc": "probability is never negative"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Probability = favourable outcomes divided by total outcomes. All probabilities lie between 0 and 1.",
      "equation": "P(event) = <span class=\"ov\">favourable</span> &divide; <span class=\"ovr\">total</span>",
      "caption": "Always simplify the fraction where possible"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; fair die",
      "question": "A fair die is rolled. Find P(even number).",
      "steps": [
        "Even numbers: 2, 4, 6 = 3 outcomes",
        "Total outcomes = 6",
        "P(even) = 3/6 = &frac{1}{2}"
      ],
      "answer": "P(even) = &frac{1}{2}",
      "explanation": "Count the favourable outcomes and divide by the total."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; bag of counters",
      "question": "A bag has 4 red, 3 blue, 2 green counters. Find P(blue).",
      "steps": [
        "Favourable (blue) = 3",
        "Total = 4 + 3 + 2 = 9",
        "P(blue) = &frac{3}{9} = &frac{1}{3}"
      ],
      "answer": "P(blue) = &frac{1}{3}",
      "explanation": "Add all counters for the total, then simplify."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; complement",
      "question": "P(rain tomorrow) = 0.35. Find P(no rain).",
      "steps": [
        "P(not A) = 1 &minus; P(A)",
        "P(no rain) = 1 &minus; 0.35",
        "= 0.65"
      ],
      "answer": "P(no rain) = 0.65",
      "explanation": "The probabilities of an event and its complement always sum to 1."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; spinner",
      "question": "A spinner has sections: 2 red, 3 blue, 5 yellow. Find P(not yellow).",
      "steps": [
        "Total sections = 2 + 3 + 5 = 10",
        "Not yellow = 2 + 3 = 5",
        "P(not yellow) = &frac{5}{10} = &frac{1}{2}"
      ],
      "answer": "P(not yellow) = &frac{1}{2}",
      "explanation": "P(not yellow) = 1 &minus; P(yellow) = 1 &minus; &frac{1}{2} = &frac{1}{2}."
    }
  ],
