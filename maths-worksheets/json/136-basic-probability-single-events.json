{
  "title": "PROBABILITY,\n(BASIC PROBABILITY SINGLE EVENTS)",
  "objective": "LO: I can calculate the probability of a single event using fractions.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Basic probability",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Probability</span> measures how likely something is to happen, from 0 (impossible) to 1 (certain). It equals <span class=\"\u0001\">favourable outcomes &divide; total outcomes</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Key rule:</span> P(event) = number of ways the event can happen &divide; total number of equally likely outcomes."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "P(heads on a coin) = &frac{1}{2}",
          "desc": "1 out of 2 outcomes"
        },
        {
          "correct": true,
          "expr": "P(6 on a die) = &frac{1}{6}",
          "desc": "1 out of 6 outcomes"
        },
        {
          "correct": true,
          "expr": "P(not A) = 1 - P(A)",
          "desc": "complementary events"
        },
        {
          "correct": false,
          "expr": "P(heads) = &frac{1}{3} because heads, tails, or edge",
          "desc": "edge is not equally likely"
        },
        {
          "correct": false,
          "expr": "P(6 on a die) = &frac{1}{3} because even or odd or 6",
          "desc": "wrong outcomes"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Probability = favourable outcomes divided by total equally likely outcomes.",
      "equation": "P(event) = <span class=\"\u0001\">&frac{favourable}{total}</span>",
      "caption": "Always a value between <span class=\"\u0001\">0</span> and 1"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; single die",
      "question": "A fair six-sided die is rolled. Find P(even number).",
      "steps": [
        "Even numbers: 2, 4, 6 (3 outcomes)",
        "Total outcomes: 6",
        "P(even) = &frac{3}{6} = &frac{1}{2}"
      ],
      "answer": "= &frac{1}{2}",
      "explanation": "Count the favourable outcomes and divide by total."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; bag of sweets",
      "question": "A bag has 3 red, 5 blue, and 2 green sweets. Find P(blue).",
      "steps": [
        "Favourable (blue): 5",
        "Total: 3 + 5 + 2 = 10",
        "P(blue) = &frac{5}{10} = &frac{1}{2}"
      ],
      "answer": "= &frac{1}{2}",
      "explanation": "Add all sweets for the total, then simplify."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; complement",
      "question": "P(rain) = 0.3. Find P(no rain).",
      "steps": [
        "P(no rain) = 1 - P(rain)",
        "= 1 - 0.3",
        "= 0.7"
      ],
      "answer": "= 0.7",
      "explanation": "Complementary probabilities always add up to 1."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; spinner",
      "question": "A spinner has sections labelled 1 to 8. Find P(prime number).",
      "steps": [
        "Prime numbers 1-8: 2, 3, 5, 7 (4 outcomes)",
        "Total: 8",
        "P(prime) = &frac{4}{8} = &frac{1}{2}"
      ],
      "answer": "= &frac{1}{2}",
      "explanation": "List the primes carefully (1 is not prime)."
    }
  ],
