{
  "title": "VECTORS,\n(VECTOR GEOMETRY PROOFS)",
  "objective": "LO: I can use vectors to prove geometric properties such as collinearity and parallelism.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Vector proofs",
      "content": [
        {
          "type": "paragraph",
          "text": "In vector geometry, we prove properties by showing vectors are <span class=\"ul-b\">parallel</span> (scalar multiples) or that points are <span class=\"ul-k\">collinear</span> (lie on the same line)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Key technique:</span> Express vectors in terms of given vectors a and b. If one vector is a scalar multiple of another, they are parallel."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Proof techniques",
      "examples": [
        {
          "correct": true,
          "expr": "If AB = kAC, then A, B, C are collinear",
          "desc": "same direction, common point"
        },
        {
          "correct": true,
          "expr": "If PQ = kRS, then PQ is parallel to RS",
          "desc": "scalar multiple"
        },
        {
          "correct": true,
          "expr": "Midpoint M: OM = &frac{1}{2}(OA + OB)",
          "desc": "midpoint formula"
        },
        {
          "correct": false,
          "expr": "Same magnitude means parallel",
          "desc": "direction must match"
        },
        {
          "correct": false,
          "expr": "AB = BA",
          "desc": "AB = &minus;BA"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Express unknown vectors using known ones. Show scalar multiples for parallel/collinear.",
      "equation": "AB = <span class=\"ov\">OB &minus; OA</span> = <span class=\"ovr\">b &minus; a</span>",
      "caption": "Route from A to B via the origin"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; expressing vectors",
      "question": "OA = a, OB = b. Find AB.",
      "steps": [
        "AB = AO + OB",
        "= &minus;a + b",
        "= b &minus; a"
      ],
      "answer": "AB = b &minus; a",
      "explanation": "Go backwards along a, then forwards along b."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; midpoint",
      "question": "M is the midpoint of AB. OA = a, OB = b. Find OM.",
      "steps": [
        "OM = OA + AM",
        "AM = &frac{1}{2}AB = &frac{1}{2}(b &minus; a)",
        "OM = a + &frac{1}{2}(b &minus; a) = &frac{1}{2}(a + b)"
      ],
      "answer": "OM = &frac{1}{2}(a + b)",
      "explanation": "The midpoint formula in vectors."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; proving parallel",
      "question": "OA = a, OB = b, OC = 3a, OD = 3b. Show AB is parallel to CD.",
      "steps": [
        "AB = b &minus; a",
        "CD = OD &minus; OC = 3b &minus; 3a = 3(b &minus; a)",
        "CD = 3 &times; AB, so parallel"
      ],
      "answer": "CD = 3AB, so AB parallel to CD",
      "explanation": "CD is a scalar multiple of AB."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; proving collinear",
      "question": "OA = 2a + b, OB = 5a + 4b, OC = 8a + 7b. Prove A, B, C collinear.",
      "steps": [
        "AB = OB &minus; OA = 3a + 3b",
        "AC = OC &minus; OA = 6a + 6b = 2(3a + 3b)",
        "AC = 2AB, common point A, so collinear"
      ],
      "answer": "AC = 2AB, collinear",
      "explanation": "AC is a scalar multiple of AB and they share point A."
    }
  ],
