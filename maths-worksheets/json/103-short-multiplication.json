{
  "title": "MULTIPLICATION,\n(SHORT MULTIPLICATION)",
  "objective": "LO: I can multiply a multi-digit number by a single digit using short multiplication.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What is short multiplication?",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Short multiplication</span> is the column method for multi-digit &times; <span class=\"ul-k\">SINGLE</span>-digit. Multiply each digit, carry tens to the next column."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">When to use:</span> multiplying by 2-9. For 10+, use long multiplication."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Examples",
      "examples": [
        {
          "correct": true,
          "expr": "234 &times; 6 = 1404",
          "desc": "with carrying"
        },
        {
          "correct": true,
          "expr": "Carry tens to next column",
          "desc": "left-shift"
        },
        {
          "correct": true,
          "expr": "47 &times; 8 = 376",
          "desc": "2-digit"
        },
        {
          "correct": false,
          "expr": "Forget to add the carry",
          "desc": "answer wrong"
        },
        {
          "correct": false,
          "expr": "Multiply right to left",
          "desc": "actually right-to-left IS correct!"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiply each digit (right to left). If the result is 10+, write the units and CARRY the tens to the next column.",
      "equation": "<span class=\"ov\">47</span> &times; <span class=\"ov\">8</span> = <span class=\"ovr\">376</span>",
      "caption": "8&times;7=56, write 6 carry 5; then 8&times;4+5=37"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; no carry",
      "question": "Calculate 32 &times; 3",
      "steps": [
        "3 &times; 2 = 6 (units)",
        "3 &times; 3 = 9 (tens)",
        "Read off: 96"
      ],
      "answer": "= 96",
      "explanation": "No carrying needed because each multiplication is &lt; 10."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; single carry",
      "question": "Calculate 47 &times; 8",
      "steps": [
        "8 &times; 7 = 56 (write 6, carry 5)",
        "8 &times; 4 = 32, +5 = 37",
        "Read off: 376"
      ],
      "answer": "= 376",
      "explanation": "Always work right to left, carrying any tens."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; 3-digit number",
      "question": "Calculate 234 &times; 6",
      "steps": [
        "6 &times; 4 = 24 (write 4, carry 2)",
        "6 &times; 3 = 18, +2 = 20 (write 0, carry 2)",
        "6 &times; 2 = 12, +2 = 14"
      ],
      "answer": "= 1404",
      "explanation": "Multiple carries: each one adds to the next column."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; with zero",
      "question": "Calculate 305 &times; 7",
      "steps": [
        "7 &times; 5 = 35 (write 5, carry 3)",
        "7 &times; 0 = 0, +3 = 3",
        "7 &times; 3 = 21"
      ],
      "answer": "= 2135",
      "explanation": "Zeros multiply to give 0 — but carries still apply."
    }
  ],
