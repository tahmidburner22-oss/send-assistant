{
  "title": "SURDS,\n(ADDING AND SUBTRACTING SURDS)",
  "objective": "LO: I can add and subtract surds by collecting like surd terms.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Adding and subtracting surds",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">surd</span> is an irrational root such as &radic;2 or &radic;5. We can only <span class=\"ul-k\">add or subtract surds</span> that have the same number under the root sign (like terms)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Simplify first:</span> Sometimes surds need to be simplified before they can be combined. For example, &radic;8 = 2&radic;2."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "3&radic;5 + 2&radic;5 = 5&radic;5",
          "desc": "like surds, add coefficients"
        },
        {
          "correct": true,
          "expr": "&radic;12 + &radic;3 = 2&radic;3 + &radic;3 = 3&radic;3",
          "desc": "simplify first"
        },
        {
          "correct": true,
          "expr": "7&radic;2 - 4&radic;2 = 3&radic;2",
          "desc": "subtract coefficients"
        },
        {
          "correct": false,
          "expr": "&radic;3 + &radic;5 = &radic;8",
          "desc": "cannot add unlike surds under one root"
        },
        {
          "correct": false,
          "expr": "2&radic;3 + 3&radic;2 = 5&radic;5",
          "desc": "different surds cannot be combined"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Only like surds (same radicand) can be added or subtracted. Simplify surds first to reveal like terms.",
      "equation": "a<span class=\"ov\">&radic;n</span> + b<span class=\"ovr\">&radic;n</span> = (a + b)&radic;n",
      "caption": "Collect like surd terms"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; like surds",
      "question": "Simplify 4&radic;3 + 7&radic;3.",
      "steps": [
        "Both terms have &radic;3",
        "Add coefficients: 4 + 7 = 11",
        "= 11&radic;3"
      ],
      "answer": "11&radic;3",
      "explanation": "Treat surds like algebra: add the coefficients of like terms."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; subtraction",
      "question": "Simplify 9&radic;2 - 5&radic;2.",
      "steps": [
        "Both terms have &radic;2",
        "Subtract coefficients: 9 - 5 = 4",
        "= 4&radic;2"
      ],
      "answer": "4&radic;2",
      "explanation": "Same process for subtraction."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; simplify first",
      "question": "Simplify &radic;18 + &radic;2.",
      "steps": [
        "&radic;18 = &radic;(9 &times; 2) = 3&radic;2",
        "3&radic;2 + &radic;2 = 4&radic;2",
        "Coefficients: 3 + 1 = 4"
      ],
      "answer": "4&radic;2",
      "explanation": "Simplify surds before combining."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; mixed expression",
      "question": "Simplify &radic;50 - &radic;8 + &radic;32.",
      "steps": [
        "&radic;50 = 5&radic;2, &radic;8 = 2&radic;2, &radic;32 = 4&radic;2",
        "5&radic;2 - 2&radic;2 + 4&radic;2",
        "= 7&radic;2"
      ],
      "answer": "7&radic;2",
      "explanation": "Simplify each surd, then combine like terms."
    }
  ],
