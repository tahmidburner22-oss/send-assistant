{
  "title": "SURDS,\n(ADDING AND SUBTRACTING SURDS)",
  "objective": "LO: I can add and subtract surds by simplifying and collecting like terms.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Adding and subtracting surds",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">surd</span> is a root that cannot be simplified to a whole number (e.g. &radic;2, &radic;5). We can only add/subtract <span class=\"ul-k\">like surds</span> (same number under the root)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Rule:</span> a&radic;n + b&radic;n = (a + b)&radic;n. Simplify surds first to find like terms."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "3&radic;2 + 5&radic;2 = 8&radic;2",
          "desc": "like surds"
        },
        {
          "correct": true,
          "expr": "&radic;8 + &radic;2 = 2&radic;2 + &radic;2 = 3&radic;2",
          "desc": "simplify first"
        },
        {
          "correct": true,
          "expr": "7&radic;3 &minus; 2&radic;3 = 5&radic;3",
          "desc": "subtract like surds"
        },
        {
          "correct": false,
          "expr": "&radic;2 + &radic;3 = &radic;5",
          "desc": "cannot add unlike surds"
        },
        {
          "correct": false,
          "expr": "3&radic;2 + 4&radic;3 = 7&radic;5",
          "desc": "unlike surds stay separate"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Simplify each surd, then add or subtract the coefficients of like surds.",
      "equation": "a<span class=\"ov\">&radic;n</span> + b<span class=\"ov\">&radic;n</span> = <span class=\"ovr\">(a + b)&radic;n</span>",
      "caption": "Only like surds can be combined"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; like surds",
      "question": "Simplify 4&radic;5 + 7&radic;5.",
      "steps": [
        "Same surd (&radic;5)",
        "Add coefficients: 4 + 7 = 11",
        "= 11&radic;5"
      ],
      "answer": "11&radic;5",
      "explanation": "Add the numbers in front of the same surd."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; simplify then add",
      "question": "Simplify &radic;12 + &radic;27.",
      "steps": [
        "&radic;12 = &radic;(4&times;3) = 2&radic;3",
        "&radic;27 = &radic;(9&times;3) = 3&radic;3",
        "2&radic;3 + 3&radic;3 = 5&radic;3"
      ],
      "answer": "5&radic;3",
      "explanation": "Simplify each surd first to reveal like terms."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; subtraction",
      "question": "Simplify &radic;50 &minus; &radic;18.",
      "steps": [
        "&radic;50 = &radic;(25&times;2) = 5&radic;2",
        "&radic;18 = &radic;(9&times;2) = 3&radic;2",
        "5&radic;2 &minus; 3&radic;2 = 2&radic;2"
      ],
      "answer": "2&radic;2",
      "explanation": "Simplify, then subtract coefficients of like surds."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; mixed expression",
      "question": "Simplify 2&radic;3 + &radic;48 &minus; &radic;12.",
      "steps": [
        "&radic;48 = 4&radic;3; &radic;12 = 2&radic;3",
        "2&radic;3 + 4&radic;3 &minus; 2&radic;3",
        "= 4&radic;3"
      ],
      "answer": "4&radic;3",
      "explanation": "Simplify all surds, then collect like terms."
    }
  ],
