  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Ordering integers",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Integers</span> are whole numbers including negatives: ... &minus;3, &minus;2, &minus;1, 0, 1, 2, 3 ... On a number line, numbers <span class=\"ul-k\">increase to the right</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Key rule:</span> All negative numbers are less than zero. A larger negative magnitude means a smaller value: &minus;5 < &minus;2."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&minus;3 < 2",
          "desc": "negatives are less than positives"
        },
        {
          "correct": true,
          "expr": "&minus;7 < &minus;2",
          "desc": "further from zero = smaller"
        },
        {
          "correct": true,
          "expr": "0 > &minus;4",
          "desc": "zero is greater than any negative"
        },
        {
          "correct": false,
          "expr": "&minus;5 > &minus;2",
          "desc": "&minus;5 is further left, so smaller"
        },
        {
          "correct": false,
          "expr": "&minus;1 < &minus;8",
          "desc": "&minus;1 is closer to zero, so larger"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "On a number line, left is smaller. For negatives, bigger digit = smaller value.",
      "equation": "&minus;5 < &minus;3 < <span class=\"ov\">0</span> < 2 < <span class=\"ovr\">5</span>",
      "caption": "Further left = smaller value"
    }
  },
