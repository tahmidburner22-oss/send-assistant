{
  "title": "PLACE VALUE AND ORDERING INTEGERS,\n(ORDERING POSITIVE AND NEGATIVE INTEGERS)",
  "objective": "LO: I can order and compare positive and negative integers using a number line.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Ordering integers",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Integers</span> are whole numbers including negatives, zero, and positives. On a number line, numbers increase from <span class=\"\u0001\">left to right</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Key rule:</span> A negative number is always less than a positive number. The further left on the number line, the smaller the value."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "-5 < -2 < 0 < 3 < 7",
          "desc": "ordered smallest to largest"
        },
        {
          "correct": true,
          "expr": "-10 is less than -3",
          "desc": "further from zero = smaller"
        },
        {
          "correct": true,
          "expr": "0 is greater than any negative number",
          "desc": "zero is not negative"
        },
        {
          "correct": false,
          "expr": "-5 > -2 because 5 > 2",
          "desc": "ignore the sign is wrong"
        },
        {
          "correct": false,
          "expr": "-3 is greater than 0",
          "desc": "all negatives are less than 0"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Picture a number line: numbers to the right are always bigger. Negative numbers are to the left of zero.",
      "equation": "<span class=\"\u0001\">-8</span> < <span class=\"\u0001\">-3</span> < <span class=\"\u0001\">0</span> < 4 < 9",
      "caption": "Left = smaller, Right = bigger"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; ordering negatives",
      "question": "Put these in order from smallest to largest: -3, 5, -7, 2, -1",
      "steps": [
        "Most negative = smallest: -7",
        "Then -3, -1, 2, 5",
        "-7, -3, -1, 2, 5"
      ],
      "answer": "-7, -3, -1, 2, 5",
      "explanation": "The more negative a number, the smaller it is."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; comparing two integers",
      "question": "Which is greater: -4 or -9?",
      "steps": [
        "-4 is closer to zero than -9",
        "On the number line, -4 is to the right of -9",
        "-4 > -9"
      ],
      "answer": "-4 is greater",
      "explanation": "Closer to zero means bigger for negative numbers."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; using inequality symbols",
      "question": "Insert < or >: -6 ___ -2",
      "steps": [
        "On the number line, -6 is to the left of -2",
        "Left means smaller",
        "-6 < -2"
      ],
      "answer": "-6 < -2",
      "explanation": "The open end of < points to the bigger number."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; temperature context",
      "question": "Order these temperatures from coldest to warmest: 3&deg;C, -5&deg;C, -1&deg;C, 8&deg;C, -8&deg;C",
      "steps": [
        "Most negative = coldest: -8&deg;C",
        "Then -5&deg;C, -1&deg;C, 3&deg;C, 8&deg;C",
        "Coldest to warmest: -8, -5, -1, 3, 8"
      ],
      "answer": "-8&deg;C, -5&deg;C, -1&deg;C, 3&deg;C, 8&deg;C",
      "explanation": "Same as ordering on a number line."
    }
  ],
