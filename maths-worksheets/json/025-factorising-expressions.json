{
  "title": "ALGEBRAIC EXPRESSIONS,\n(FACTORISING EXPRESSIONS)",
  "objective": "LO: I can factorise algebraic expressions by taking out common factors.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What is factorising?",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Factorising</span> is the reverse of expanding. We find a <span class=\"ul-k\">common factor</span> and write the expression as a product of terms."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Find the HCF of all terms (both numbers and letters), then divide each term by it."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "6x + 9 = 3(2x + 3)",
          "desc": "HCF is 3"
        },
        {
          "correct": true,
          "expr": "x&sup2; + 5x = x(x + 5)",
          "desc": "HCF is x"
        },
        {
          "correct": true,
          "expr": "4x&sup2; + 8x = 4x(x + 2)",
          "desc": "HCF is 4x"
        },
        {
          "correct": false,
          "expr": "6x + 9 = 6(x + 3)",
          "desc": "6 is not a factor of 9"
        },
        {
          "correct": false,
          "expr": "x&sup2; + 5x = x(x + 5x)",
          "desc": "divided only first term"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Find the highest common factor (HCF) of all terms. Write it outside the bracket. Divide each term by the HCF to get what goes inside.",
      "equation": "<span class=\"ov\">4x&sup2; + 8x</span> = <span class=\"ovr\">4x(x + 2)</span>",
      "caption": "HCF = 4x; divide each term by 4x"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; number HCF",
      "question": "Factorise 6x + 9",
      "steps": [
        "HCF of 6 and 9 is 3",
        "6x &divide; 3 = 2x; 9 &divide; 3 = 3",
        "Write: 3(2x + 3)"
      ],
      "answer": "= 3(2x + 3)",
      "explanation": "Check by expanding: 3 &times; 2x + 3 &times; 3 = 6x + 9 &check;"
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; letter HCF",
      "question": "Factorise x&sup2; + 5x",
      "steps": [
        "Both terms contain x",
        "x&sup2; &divide; x = x; 5x &divide; x = 5",
        "Write: x(x + 5)"
      ],
      "answer": "= x(x + 5)",
      "explanation": "Take out the lowest power of x from each term."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; number and letter",
      "question": "Factorise 4x&sup2; + 8x",
      "steps": [
        "HCF of 4 and 8 is 4; both have x: HCF = 4x",
        "4x&sup2; &divide; 4x = x; 8x &divide; 4x = 2",
        "Write: 4x(x + 2)"
      ],
      "answer": "= 4x(x + 2)",
      "explanation": "Always take the highest common factor, including letters."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; three terms",
      "question": "Factorise 6x&sup2; + 12x + 18",
      "steps": [
        "HCF of 6, 12, 18 is 6",
        "6x&sup2; &divide; 6 = x&sup2;; 12x &divide; 6 = 2x; 18 &divide; 6 = 3",
        "Write: 6(x&sup2; + 2x + 3)"
      ],
      "answer": "= 6(x&sup2; + 2x + 3)",
      "explanation": "When all coefficients share a common factor, take it out."
    }
  ],
