{
  "title": "SEQUENCES,\n(GEOMETRIC SEQUENCES)",
  "objective": "LO: I can identify, generate, and find the nth term of geometric sequences.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What is a geometric sequence?",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">geometric sequence</span> has a constant <span class=\"ul-k\">common ratio</span> (r) between consecutive terms. Each term is found by multiplying the previous term by r."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Formula:</span> The nth term is u<sub>n</sub> = ar<sup>n&minus;1</sup>, where a is the first term and r is the common ratio."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "2, 6, 18, 54, ... (r = 3)",
          "desc": "multiply by 3"
        },
        {
          "correct": true,
          "expr": "100, 50, 25, 12.5, ... (r = 0.5)",
          "desc": "multiply by &frac{1}{2}"
        },
        {
          "correct": true,
          "expr": "u<sub>n</sub> = 3 &times; 2<sup>n&minus;1</sup> gives 3, 6, 12, 24, ...",
          "desc": "a=3, r=2"
        },
        {
          "correct": false,
          "expr": "2, 4, 6, 8, ... is geometric",
          "desc": "that is arithmetic (+2)"
        },
        {
          "correct": false,
          "expr": "u<sub>n</sub> = ar<sup>n</sup> (should be n&minus;1)",
          "desc": "exponent is n&minus;1"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Divide consecutive terms to find r. The nth term formula is u<sub>n</sub> = ar<sup>n&minus;1</sup>.",
      "equation": "u<sub>n</sub> = <span class=\"ov\">a</span> &times; <span class=\"ovr\">r<sup>n&minus;1</sup></span>",
      "caption": "a = first term, r = common ratio, n = term number"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; finding the common ratio",
      "question": "Find the common ratio of 5, 15, 45, 135, ...",
      "steps": [
        "r = second &divide; first = 15 &divide; 5 = 3",
        "Check: 45 &divide; 15 = 3, 135 &divide; 45 = 3",
        "Common ratio r = 3"
      ],
      "answer": "r = 3",
      "explanation": "Divide any term by the previous term to find r."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; finding the nth term",
      "question": "Find the 8th term of 2, 6, 18, 54, ...",
      "steps": [
        "a = 2, r = 3",
        "u<sub>8</sub> = 2 &times; 3<sup>7</sup>",
        "u<sub>8</sub> = 2 &times; 2187 = 4374"
      ],
      "answer": "u<sub>8</sub> = 4374",
      "explanation": "Use u<sub>n</sub> = ar<sup>n&minus;1</sup> with careful power calculation."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; fractional ratio",
      "question": "Find the 5th term of 64, 32, 16, 8, ...",
      "steps": [
        "a = 64, r = 32 &divide; 64 = &frac{1}{2}",
        "u<sub>5</sub> = 64 &times; (&frac{1}{2})<sup>4</sup>",
        "u<sub>5</sub> = 64 &times; &frac{1}{16} = 4"
      ],
      "answer": "u<sub>5</sub> = 4",
      "explanation": "When r is a fraction, terms decrease."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; writing the nth term formula",
      "question": "Write the nth term formula for 3, 12, 48, 192, ...",
      "steps": [
        "a = 3, r = 12 &divide; 3 = 4",
        "u<sub>n</sub> = 3 &times; 4<sup>n&minus;1</sup>",
        "Check: u<sub>3</sub> = 3 &times; 16 = 48 &#10003;"
      ],
      "answer": "u<sub>n</sub> = 3 &times; 4<sup>n&minus;1</sup>",
      "explanation": "Substitute a and r into the formula u<sub>n</sub> = ar<sup>n&minus;1</sup>."
    }
  ],
