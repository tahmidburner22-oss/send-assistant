{
  "title": "NUMBER OPERATIONS,\n(BIDMAS / BODMAS)",
  "objective": "LO: I can apply the correct order of operations (BIDMAS) to evaluate expressions.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Order of operations",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">BIDMAS</span> tells us the order: <span class=\"ul-k\">B</span>rackets, <span class=\"ul-k\">I</span>ndices, <span class=\"ul-k\">D</span>ivision/<span class=\"ul-k\">M</span>ultiplication, <span class=\"ul-k\">A</span>ddition/<span class=\"ul-k\">S</span>ubtraction."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Key point:</span> Division and multiplication are equal priority (left to right). Addition and subtraction are equal priority (left to right)."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "BIDMAS in action",
      "examples": [
        {
          "correct": true,
          "expr": "3 + 4 &times; 2 = 11",
          "desc": "multiply first"
        },
        {
          "correct": true,
          "expr": "(3 + 4) &times; 2 = 14",
          "desc": "brackets first"
        },
        {
          "correct": true,
          "expr": "2&sup2; + 3 = 7",
          "desc": "indices before addition"
        },
        {
          "correct": false,
          "expr": "3 + 4 &times; 2 = 14",
          "desc": "left-to-right is wrong here"
        },
        {
          "correct": false,
          "expr": "8 &divide; 2(2+2) = 1",
          "desc": "common viral debate"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Always follow BIDMAS: Brackets first, then Indices (powers), then Division/Multiplication (L to R), then Addition/Subtraction (L to R).",
      "equation": "<span class=\"ov\">B</span> &rarr; I &rarr; DM &rarr; <span class=\"ovr\">AS</span>",
      "caption": "Brackets, Indices, Divide/Multiply, Add/Subtract"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; multiplication before addition",
      "question": "Calculate 5 + 3 &times; 4",
      "steps": [
        "Multiplication first: 3 &times; 4 = 12",
        "Then add: 5 + 12",
        "= 17"
      ],
      "answer": "= 17",
      "explanation": "Without brackets, &times; and &divide; always come before + and &minus;."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; brackets first",
      "question": "Calculate (8 + 2) &times; 3",
      "steps": [
        "Brackets first: 8 + 2 = 10",
        "Then multiply: 10 &times; 3",
        "= 30"
      ],
      "answer": "= 30",
      "explanation": "Brackets override the normal priority."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; indices",
      "question": "Calculate 4 + 3&sup2; &times; 2",
      "steps": [
        "Indices first: 3&sup2; = 9",
        "Multiply: 9 &times; 2 = 18",
        "Add: 4 + 18 = 22"
      ],
      "answer": "= 22",
      "explanation": "Indices before multiplication, multiplication before addition."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; complex expression",
      "question": "Calculate 20 &minus; 2 &times; (3 + 4)&sup2; &divide; 7",
      "steps": [
        "Brackets: 3 + 4 = 7",
        "Indices: 7&sup2; = 49",
        "Left to right: 2 &times; 49 = 98; 98 &divide; 7 = 14; 20 &minus; 14 = 6"
      ],
      "answer": "= 6",
      "explanation": "Work through BIDMAS step by step."
    }
  ],
