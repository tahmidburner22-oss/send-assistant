{
  "title": "SURDS,\n(RATIONALISING THE DENOMINATOR)",
  "objective": "LO: I can rationalise the denominator of a surd fraction.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Rationalising",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Rationalising</span> means removing the surd from the <span class=\"ul-k\">denominator</span> (bottom) of a fraction by multiplying top and bottom by an appropriate expression."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Methods:</span> For &frac{a}{&radic;b}, multiply by &frac{&radic;b}{&radic;b}. For &frac{a}{c + &radic;d}, multiply by &frac{c &minus; &radic;d}{c &minus; &radic;d} (conjugate)."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&frac{1}{&radic;2} = &frac{&radic;2}{2}",
          "desc": "multiply by &radic;2/&radic;2"
        },
        {
          "correct": true,
          "expr": "&frac{6}{&radic;3} = &frac{6&radic;3}{3} = 2&radic;3",
          "desc": "simplify after"
        },
        {
          "correct": true,
          "expr": "&frac{1}{2+&radic;3} uses conjugate 2&minus;&radic;3",
          "desc": "difference of squares"
        },
        {
          "correct": false,
          "expr": "&frac{1}{&radic;5} = &frac{1}{5}",
          "desc": "must multiply properly"
        },
        {
          "correct": false,
          "expr": "&frac{3}{&radic;2} = 3&radic;2",
          "desc": "= &frac{3&radic;2}{2}"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiply numerator and denominator by the surd (or conjugate) to eliminate the irrational denominator.",
      "equation": "&frac{a}{&radic;b} &times; <span class=\"ov\">&frac{&radic;b}{&radic;b}</span> = <span class=\"ovr\">&frac{a&radic;b}{b}</span>",
      "caption": "The denominator becomes rational"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; simple rationalising",
      "question": "Rationalise &frac{5}{&radic;3}.",
      "steps": [
        "Multiply by &frac{&radic;3}{&radic;3}",
        "= &frac{5&radic;3}{&radic;3 &times; &radic;3}",
        "= &frac{5&radic;3}{3}"
      ],
      "answer": "&frac{5&radic;3}{3}",
      "explanation": "Multiply top and bottom by &radic;3."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; simplify after",
      "question": "Rationalise &frac{6}{&radic;2}.",
      "steps": [
        "Multiply by &frac{&radic;2}{&radic;2}: &frac{6&radic;2}{2}",
        "Simplify: 6/2 = 3",
        "= 3&radic;2"
      ],
      "answer": "3&radic;2",
      "explanation": "Always simplify the fraction after rationalising."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; conjugate method",
      "question": "Rationalise &frac{1}{3 + &radic;2}.",
      "steps": [
        "Multiply by &frac{3 &minus; &radic;2}{3 &minus; &radic;2}",
        "Numerator: 3 &minus; &radic;2",
        "Denominator: 9 &minus; 2 = 7"
      ],
      "answer": "&frac{3 &minus; &radic;2}{7}",
      "explanation": "Use the conjugate: (a + b)(a &minus; b) = a&sup2; &minus; b&sup2;."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; harder conjugate",
      "question": "Rationalise &frac{4}{&radic;5 &minus; 1}.",
      "steps": [
        "Multiply by &frac{&radic;5 + 1}{&radic;5 + 1}",
        "Num: 4(&radic;5 + 1) = 4&radic;5 + 4",
        "Den: 5 &minus; 1 = 4"
      ],
      "answer": "&radic;5 + 1",
      "explanation": "Simplify the fraction: &frac{4&radic;5 + 4}{4} = &radic;5 + 1."
    }
  ],
