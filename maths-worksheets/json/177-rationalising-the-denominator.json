{
  "title": "SURDS,\n(RATIONALISING THE DENOMINATOR)",
  "objective": "LO: I can rationalise the denominator of a fraction containing surds.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Rationalising the denominator",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Rationalising</span> means removing the surd from the denominator. Multiply top and bottom by the <span class=\"ul-k\">surd in the denominator</span> (or its conjugate)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Conjugate:</span> For denominators like a + &radic;b, multiply by a - &radic;b (the conjugate) to eliminate the surd."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&frac{1}{&radic;3} = &frac{&radic;3}{3}",
          "desc": "multiply top and bottom by &radic;3"
        },
        {
          "correct": true,
          "expr": "&frac{4}{&radic;2} = &frac{4&radic;2}{2} = 2&radic;2",
          "desc": "then simplify"
        },
        {
          "correct": true,
          "expr": "&frac{1}{1+&radic;2} &times; &frac{1-&radic;2}{1-&radic;2}",
          "desc": "use the conjugate"
        },
        {
          "correct": false,
          "expr": "&frac{1}{&radic;3} = &frac{1}{3}",
          "desc": "must multiply both top and bottom"
        },
        {
          "correct": false,
          "expr": "&frac{3}{&radic;5} = &frac{3}{5}",
          "desc": "denominator becomes 5, but numerator becomes 3&radic;5"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiply numerator and denominator by the surd (or conjugate) to make the denominator rational.",
      "equation": "&frac{a}{<span class=\"ov\">&radic;b</span>} = &frac{a &times; &radic;b}{<span class=\"ovr\">b</span>}",
      "caption": "Since &radic;b &times; &radic;b = b"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; simple rationalisation",
      "question": "Rationalise &frac{1}{&radic;5}.",
      "steps": [
        "Multiply top and bottom by &radic;5",
        "&frac{1 &times; &radic;5}{&radic;5 &times; &radic;5} = &frac{&radic;5}{5}",
        "Denominator is now rational"
      ],
      "answer": "&frac{&radic;5}{5}",
      "explanation": "Multiply by &radic;5 over &radic;5 (which equals 1)."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; with a coefficient",
      "question": "Rationalise &frac{6}{&radic;3}.",
      "steps": [
        "Multiply top and bottom by &radic;3",
        "&frac{6&radic;3}{3}",
        "Simplify: = 2&radic;3"
      ],
      "answer": "2&radic;3",
      "explanation": "After rationalising, simplify the fraction."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; using the conjugate",
      "question": "Rationalise &frac{3}{2 + &radic;5}.",
      "steps": [
        "Conjugate of 2 + &radic;5 is 2 - &radic;5",
        "Multiply: &frac{3(2 - &radic;5)}{(2 + &radic;5)(2 - &radic;5)} = &frac{6 - 3&radic;5}{4 - 5}",
        "= &frac{6 - 3&radic;5}{-1} = -6 + 3&radic;5"
      ],
      "answer": "3&radic;5 - 6",
      "explanation": "The denominator becomes (a+b)(a-b) = a² - b²."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; harder conjugate",
      "question": "Rationalise &frac{4}{&radic;7 - &radic;3}.",
      "steps": [
        "Conjugate: &radic;7 + &radic;3",
        "Denominator: (&radic;7)² - (&radic;3)² = 7 - 3 = 4",
        "= &frac{4(&radic;7 + &radic;3)}{4} = &radic;7 + &radic;3"
      ],
      "answer": "&radic;7 + &radic;3",
      "explanation": "Difference of two surds: use the sum as conjugate."
    }
  ],
