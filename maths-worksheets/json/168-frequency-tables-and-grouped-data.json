{
  "title": "STATISTICS,\n(FREQUENCY TABLES AND GROUPED DATA)",
  "objective": "LO: I can calculate averages and other statistics from frequency tables and grouped frequency tables.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Averages from frequency tables",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">frequency table</span> shows how often each value (or group of values) occurs. For grouped data, use the <span class=\"ul-k\">midpoint</span> of each class to estimate the mean."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Mean = &Sigma;fx &divide; &Sigma;f. For grouped data, x is the class midpoint. The modal class has the highest frequency."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "Mean = &Sigma;fx &divide; &Sigma;f",
          "desc": "total of fx divided by total frequency"
        },
        {
          "correct": true,
          "expr": "Midpoint of 10&ndash;20 is 15",
          "desc": "(10 + 20) &divide; 2"
        },
        {
          "correct": true,
          "expr": "Modal class = class with highest frequency",
          "desc": "not the midpoint"
        },
        {
          "correct": false,
          "expr": "Mean of grouped data uses class boundaries",
          "desc": "use midpoints"
        },
        {
          "correct": false,
          "expr": "You can find the exact mean from grouped data",
          "desc": "only an estimate"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "For grouped data: estimate mean = sum of (frequency &times; midpoint) divided by total frequency.",
      "equation": "Estimated mean = <span class=\"ov\">&Sigma;fx</span> &divide; <span class=\"ovr\">&Sigma;f</span>",
      "caption": "x = midpoint of each class; f = frequency"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; ungrouped frequency table",
      "question": "Scores: 1(f=3), 2(f=5), 3(f=7), 4(f=4), 5(f=1). Find the mean.",
      "steps": [
        "&Sigma;fx = 1&times;3 + 2&times;5 + 3&times;7 + 4&times;4 + 5&times;1 = 3+10+21+16+5 = 55",
        "&Sigma;f = 3+5+7+4+1 = 20",
        "Mean = 55 &divide; 20 = 2.75"
      ],
      "answer": "Mean = 2.75",
      "explanation": "Multiply each value by its frequency, sum, then divide by total frequency."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; grouped data mean",
      "question": "Heights (cm): 140&ndash;150 (f=4), 150&ndash;160 (f=10), 160&ndash;170 (f=8), 170&ndash;180 (f=3). Estimate the mean.",
      "steps": [
        "Midpoints: 145, 155, 165, 175",
        "&Sigma;fx = 145&times;4 + 155&times;10 + 165&times;8 + 175&times;3 = 580+1550+1320+525 = 3975",
        "Mean = 3975 &divide; 25 = 159"
      ],
      "answer": "Estimated mean = 159 cm",
      "explanation": "Use midpoints because we do not know exact values within groups."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; modal class and median class",
      "question": "Classes: 0&ndash;10 (f=5), 10&ndash;20 (f=12), 20&ndash;30 (f=8), 30&ndash;40 (f=5). Find the modal class and the class containing the median.",
      "steps": [
        "Modal class: 10&ndash;20 (highest frequency = 12)",
        "Total n = 30; median at &frac{30}{2} = 15th value",
        "CF: 5, 17, ... The 15th value is in the 10&ndash;20 class"
      ],
      "answer": "Modal class: 10&ndash;20; Median class: 10&ndash;20",
      "explanation": "The modal class has the highest frequency. Count up CFs to find the median class."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; range from grouped data",
      "question": "Smallest possible value: 0 (from class 0&ndash;10). Largest possible: 40 (from class 30&ndash;40). Find the estimated range.",
      "steps": [
        "Minimum could be anywhere in 0&ndash;10",
        "Maximum could be anywhere in 30&ndash;40",
        "Estimated range = 40 &minus; 0 = 40 (maximum possible)"
      ],
      "answer": "Estimated range = 40",
      "explanation": "From grouped data, we can only estimate the range using class boundaries."
    }
  ],
