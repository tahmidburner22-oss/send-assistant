      "label": "Example 1 &ndash; large numbers",
      "question": "Round 4728 to 2 sf.",
      "steps": [
        "1st sf = 4, 2nd sf = 7",
        "Look at next digit: 2 (less than 5)",
        "Round down: 4700"
      ],
      "answer": "4700",
      "explanation": "The 3rd digit (2) tells us to round down."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; decimals",
      "question": "Round 0.003856 to 2 sf.",
      "steps": [
        "Leading zeros not significant",
        "1st sf = 3, 2nd sf = 8",
        "Next digit = 5, round up: 0.0039"
      ],
      "answer": "0.0039",
      "explanation": "Start counting from the first non-zero digit."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; one sf",
      "question": "Round 67.3 to 1 sf.",
      "steps": [
        "1st sf = 6",
        "Next digit = 7 (5 or more)",
        "Round up: 70"
      ],
      "answer": "70",
      "explanation": "One significant figure means one meaningful digit."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; trailing zeros",
      "question": "Round 0.05049 to 3 sf.",
      "steps": [
        "1st sf = 5, 2nd = 0, 3rd = 4",
        "Next digit = 9 (round up)",
        "0.0505"
      ],
      "answer": "0.0505",
      "explanation": "The zero between 5 and 4 IS significant."
    }
  ],
