{
  "title": "PLACE VALUE AND ORDERING INTEGERS,\n(ROUNDING TO SIGNIFICANT FIGURES)",
  "objective": "LO: I can round numbers to a given number of significant figures.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Significant figures",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Significant figures</span> (sf) are the meaningful digits in a number. The first sf is the first <span class=\"ul-k\">non-zero digit</span>. Count from there."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Leading zeros</span> are not significant. Trailing zeros after a decimal point ARE significant."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "3456 to 2 sf = 3500",
          "desc": "round at 2nd digit"
        },
        {
          "correct": true,
          "expr": "0.00347 to 2 sf = 0.0035",
          "desc": "leading zeros not significant"
        },
        {
          "correct": true,
          "expr": "45.83 to 1 sf = 50",
          "desc": "round up"
        },
        {
          "correct": false,
          "expr": "0.0034 has 4 sf",
          "desc": "only 2 sf (3 and 4)"
        },
        {
          "correct": false,
          "expr": "3456 to 1 sf = 3",
          "desc": "should be 3000"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Find the first significant (non-zero) digit. Count the required number of digits from there. Round using the next digit.",
      "equation": "<span class=\"ov\">3</span>456 to 1 sf = <span class=\"ovr\">3000</span>",
      "caption": "Keep 1 digit, replace rest with zeros"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
