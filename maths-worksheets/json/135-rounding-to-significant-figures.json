{
  "title": "PLACE VALUE AND ORDERING INTEGERS,\n(ROUNDING TO SIGNIFICANT FIGURES)",
  "objective": "LO: I can round numbers to a given number of significant figures.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Significant figures",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Significant figures</span> (s.f.) are counted from the first non-zero digit. Leading zeros are <span class=\"\u0001\">not significant</span> but trailing zeros after a decimal point are."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Rule:</span> Find the digit at the required position, look at the next digit. If it is 5 or more, round up."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "3462 to 2 s.f. = 3500",
          "desc": "round up (6 &ge; 5)"
        },
        {
          "correct": true,
          "expr": "0.00587 to 2 s.f. = 0.0059",
          "desc": "leading zeros not significant"
        },
        {
          "correct": true,
          "expr": "45.83 to 1 s.f. = 50",
          "desc": "round up (5 &ge; 5)"
        },
        {
          "correct": false,
          "expr": "0.00587 to 2 s.f. = 0.01",
          "desc": "counted the zeros as significant"
        },
        {
          "correct": false,
          "expr": "3462 to 2 s.f. = 3400",
          "desc": "should round up, not down"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Count significant figures from the first non-zero digit. Round using normal rounding rules.",
      "equation": "<span class=\"\u0001\">0.004</span><span class=\"\u0001\">73</span> to 2 s.f. = 0.0047",
      "caption": "Leading zeros are placeholders, not significant"
    }
