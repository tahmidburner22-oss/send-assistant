      "label": "Example 1 &ndash; reading a large number",
      "question": "Write 4,250,000 in words.",
      "steps": [
        "4 is in the millions column",
        "250 is in the thousands",
        "Four million two hundred and fifty thousand"
      ],
      "answer": "= Four million two hundred and fifty thousand",
      "explanation": "Read from left to right using place value."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; writing in figures",
      "question": "Write seven hundred and thirty-two thousand in figures.",
      "steps": [
        "Seven hundred and thirty-two thousand = 732 thousand",
        "= 732,000",
        "Add three zeros for thousands"
      ],
      "answer": "= 732,000",
      "explanation": "Match each word to its place value position."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; identifying digit value",
      "question": "What is the value of the 6 in 3,604,500?",
      "steps": [
        "Position: millions column has 3, hundred-thousands has 6",
        "The 6 is in the hundred-thousands column",
        "Value = 600,000"
      ],
      "answer": "= 600,000",
      "explanation": "The position of the digit determines its value."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; comparing large numbers",
      "question": "Which is larger: 2,450,000 or 2,540,000?",
      "steps": [
        "Both have 2 million",
        "Compare hundred-thousands: 4 vs 5",
        "5 > 4, so 2,540,000 is larger"
      ],
      "answer": "2,540,000 is larger",
      "explanation": "Compare digits from left to right until they differ."
    }
