  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Large integers",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Place value</span> tells us the value of each digit based on its position. Large numbers use <span class=\"\u0001\">thousands, millions, and billions</span> columns."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Commas:</span> We use commas (or spaces) to separate groups of three digits from the right, making large numbers easier to read."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "3,500,000 = three million five hundred thousand",
          "desc": "reading correctly"
        },
        {
          "correct": true,
          "expr": "45,000 has 4 in the ten-thousands column",
          "desc": "place value"
        },
        {
          "correct": true,
          "expr": "1,000,000 = one million",
          "desc": "six zeros"
        },
        {
          "correct": false,
          "expr": "3,500,000 = thirty-five thousand",
          "desc": "wrong place value"
        },
        {
          "correct": false,
          "expr": "1,000,000 has 5 zeros",
          "desc": "it has 6 zeros"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Use place value columns: ones, tens, hundreds, thousands, ten-thousands, hundred-thousands, millions.",
      "equation": "<span class=\"\u0001\">2</span>,<span class=\"\u0001\">456</span>,789",
      "caption": "2 millions, 456 thousands, 789 ones"
    }
  },
