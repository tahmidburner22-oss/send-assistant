      "question": "What is the value of the digit 6 in 2,600,450?",
      "steps": [
        "Position the digit: 2, 6 0 0, 4 5 0",
        "6 is in the hundred-thousands column",
        "Value = 6 &times; 100,000 = 600,000"
      ],
      "answer": "600,000 (six hundred thousand)",
      "explanation": "The value of a digit depends on its position in the number."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; ordering large numbers",
      "question": "Write these in ascending order: 1,450,000; 1,045,000; 1,500,000; 1,405,000.",
      "steps": [
        "Compare millions: all are 1 million",
        "Compare hundred-thousands: 0, 4, 4, 5",
        "Refine: 1,045,000 &lt; 1,405,000 &lt; 1,450,000 &lt; 1,500,000"
      ],
      "answer": "1,045,000; 1,405,000; 1,450,000; 1,500,000",
      "explanation": "When millions are equal, compare the next place value column."
    }
  ],
