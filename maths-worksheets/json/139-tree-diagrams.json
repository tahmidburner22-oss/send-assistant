{
  "title": "PROBABILITY,\n(TREE DIAGRAMS)",
  "objective": "LO: I can use tree diagrams to find probabilities of combined events.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Tree diagrams",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">tree diagram</span> shows all possible outcomes of two or more events. Each <span class=\"ul-k\">branch</span> represents one outcome and is labelled with its probability."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Rules:</span> Multiply along branches (AND). Add between paths (OR). Branches from one point always sum to 1."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "P(A and B) = P(A) &times; P(B)",
          "desc": "multiply along branches"
        },
        {
          "correct": true,
          "expr": "P(A or B) = add separate paths",
          "desc": "add outcomes"
        },
        {
          "correct": true,
          "expr": "Branches from a node sum to 1",
          "desc": "all possibilities covered"
        },
        {
          "correct": false,
          "expr": "P(A and B) = P(A) + P(B)",
          "desc": "should multiply for AND"
        },
        {
          "correct": false,
          "expr": "Each branch has probability &frac{1}{2}",
          "desc": "only if equally likely"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiply along branches for combined events. Add between separate paths for 'or' questions.",
      "equation": "P(A then B) = <span class=\"ov\">P(A)</span> &times; <span class=\"ovr\">P(B)</span>",
      "caption": "AND = multiply; OR = add"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; two coins",
      "question": "A coin is flipped twice. Find P(two heads).",
      "steps": [
        "P(H) = &frac{1}{2} for each flip",
        "P(HH) = &frac{1}{2} &times; &frac{1}{2}",
        "= &frac{1}{4}"
      ],
      "answer": "P(two heads) = &frac{1}{4}",
      "explanation": "Multiply along the HH branch."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; with replacement",
      "question": "A bag has 3 red, 2 blue counters. One is drawn, replaced, then another drawn. Find P(both red).",
      "steps": [
        "P(red) = &frac{3}{5} each time (replaced)",
        "P(RR) = &frac{3}{5} &times; &frac{3}{5}",
        "= &frac{9}{25}"
      ],
      "answer": "P(both red) = &frac{9}{25}",
      "explanation": "With replacement, probabilities stay the same."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; without replacement",
      "question": "Same bag (3R, 2B). Without replacement, find P(both red).",
      "steps": [
        "First pick: P(R) = &frac{3}{5}",
        "Second pick (one red gone): P(R) = &frac{2}{4} = &frac{1}{2}",
        "P(RR) = &frac{3}{5} &times; &frac{1}{2} = &frac{3}{10}"
      ],
      "answer": "P(both red) = &frac{3}{10}",
      "explanation": "Without replacement, the second probability changes."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; at least one",
      "question": "Two coins are flipped. Find P(at least one head).",
      "steps": [
        "P(no heads) = P(TT) = &frac{1}{2} &times; &frac{1}{2} = &frac{1}{4}",
        "P(at least one H) = 1 &minus; P(TT)",
        "= 1 &minus; &frac{1}{4} = &frac{3}{4}"
      ],
      "answer": "P(at least one head) = &frac{3}{4}",
      "explanation": "Use the complement: 1 &minus; P(none)."
    }
  ],
