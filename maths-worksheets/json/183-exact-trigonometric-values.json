{
  "title": "TRIGONOMETRY,\n(EXACT TRIGONOMETRIC VALUES)",
  "objective": "LO: I can recall and use exact trigonometric values for 0, 30, 45, 60 and 90 degrees.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Exact trig values",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">exact trigonometric values</span> for common angles (0&deg;, 30&deg;, 45&deg;, 60&deg;, 90&deg;) can be expressed as <span class=\"ul-k\">fractions and surds</span> rather than decimals."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Key values:</span> sin 30&deg; = &frac{1}{2}, cos 60&deg; = &frac{1}{2}, tan 45&deg; = 1, sin 45&deg; = &frac{&radic;2}{2}."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Values to memorise",
      "examples": [
        {
          "correct": true,
          "expr": "sin 30&deg; = &frac{1}{2}",
          "desc": "from 30-60-90 triangle"
        },
        {
          "correct": true,
          "expr": "cos 45&deg; = &frac{&radic;2}{2}",
          "desc": "from 45-45-90 triangle"
        },
        {
          "correct": true,
          "expr": "tan 60&deg; = &radic;3",
          "desc": "sin 60 / cos 60"
        },
        {
          "correct": false,
          "expr": "sin 45&deg; = &frac{1}{2}",
          "desc": "sin 45 = &radic;2/2"
        },
        {
          "correct": false,
          "expr": "cos 90&deg; = 1",
          "desc": "cos 90 = 0"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Learn the exact values from the 30-60-90 and 45-45-90 triangles.",
      "equation": "sin 60&deg; = <span class=\"ov\">&frac{&radic;3}{2}</span> | cos 30&deg; = <span class=\"ovr\">&frac{&radic;3}{2}</span>",
      "caption": "sin and cos are complementary: sin x = cos(90 &minus; x)"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; sin values",
      "question": "State the exact value of sin 60&deg;.",
      "steps": [
        "From the 30-60-90 triangle",
        "Opposite = &radic;3, hypotenuse = 2",
        "sin 60&deg; = &frac{&radic;3}{2}"
      ],
      "answer": "sin 60&deg; = &frac{&radic;3}{2}",
      "explanation": "The 30-60-90 triangle has sides 1, &radic;3, 2."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; cos values",
      "question": "Find the exact value of cos 30&deg;.",
      "steps": [
        "From the 30-60-90 triangle",
        "Adjacent = &radic;3, hypotenuse = 2",
        "cos 30&deg; = &frac{&radic;3}{2}"
      ],
      "answer": "cos 30&deg; = &frac{&radic;3}{2}",
      "explanation": "cos 30 = sin 60 (complementary angles)."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; tan values",
      "question": "Find the exact value of tan 45&deg;.",
      "steps": [
        "From the 45-45-90 triangle",
        "Opposite = adjacent = 1",
        "tan 45&deg; = 1/1 = 1"
      ],
      "answer": "tan 45&deg; = 1",
      "explanation": "In a 45-45-90 triangle, the two legs are equal."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; using exact values",
      "question": "Find the hypotenuse when the opposite is 8 and angle is 30&deg;.",
      "steps": [
        "sin 30&deg; = opp/hyp = 8/hyp",
        "&frac{1}{2} = 8/hyp",
        "hyp = 16"
      ],
      "answer": "Hypotenuse = 16",
      "explanation": "Substitute the exact value of sin 30&deg; = &frac{1}{2}."
    }
  ],
