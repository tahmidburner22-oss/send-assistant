{
  "title": "ANGLES AND GEOMETRY,\n(ANGLES IN POLYGONS)",
  "objective": "LO: I can find interior and exterior angles of regular and irregular polygons.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Polygon angle rules",
      "content": [
        {
          "type": "paragraph",
          "text": "The sum of <span class=\"ul-b\">interior angles</span> of a polygon with n sides is <span class=\"ul-k\">(n &minus; 2) &times; 180&deg;</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Exterior angles:</span> The exterior angles of any convex polygon always sum to 360&deg;. Each exterior angle of a regular polygon = 360&deg; &divide; n."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key facts",
      "examples": [
        {
          "correct": true,
          "expr": "Triangle: (3&minus;2)&times;180 = 180&deg;",
          "desc": "angle sum"
        },
        {
          "correct": true,
          "expr": "Quadrilateral: (4&minus;2)&times;180 = 360&deg;",
          "desc": "angle sum"
        },
        {
          "correct": true,
          "expr": "Pentagon: (5&minus;2)&times;180 = 540&deg;",
          "desc": "angle sum"
        },
        {
          "correct": false,
          "expr": "Hexagon interior sum = 600&deg;",
          "desc": "should be 720&deg;"
        },
        {
          "correct": false,
          "expr": "Exterior angles sum to 180&deg;",
          "desc": "always 360&deg;"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Interior angle sum = (n &minus; 2) &times; 180&deg;. Exterior angles always sum to 360&deg;.",
      "equation": "Sum = (<span class=\"ov\">n &minus; 2</span>) &times; <span class=\"ovr\">180&deg;</span>",
      "caption": "n = number of sides"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; interior angle sum",
      "question": "Find the sum of interior angles of a hexagon.",
      "steps": [
        "A hexagon has 6 sides, so n = 6",
        "(6 &minus; 2) &times; 180 = 4 &times; 180",
        "= 720&deg;"
      ],
      "answer": "= 720&deg;",
      "explanation": "Always subtract 2 from the number of sides first."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; one interior angle (regular)",
      "question": "Find one interior angle of a regular octagon.",
      "steps": [
        "Sum = (8 &minus; 2) &times; 180 = 1080&deg;",
        "Regular: all angles equal",
        "1080 &divide; 8 = 135&deg;"
      ],
      "answer": "= 135&deg;",
      "explanation": "For regular polygons, divide the total by the number of sides."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; exterior angle",
      "question": "Find one exterior angle of a regular pentagon.",
      "steps": [
        "Exterior angles sum to 360&deg;",
        "Regular: all exterior angles equal",
        "360 &divide; 5 = 72&deg;"
      ],
      "answer": "= 72&deg;",
      "explanation": "Exterior angle + interior angle = 180&deg; (check: 108 + 72 = 180)."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; finding missing angle",
      "question": "A pentagon has angles 100&deg;, 120&deg;, 130&deg;, 90&deg; and x. Find x.",
      "steps": [
        "Sum = (5 &minus; 2) &times; 180 = 540&deg;",
        "100 + 120 + 130 + 90 = 440&deg;",
        "x = 540 &minus; 440 = 100&deg;"
      ],
      "answer": "x = 100&deg;",
      "explanation": "Subtract the known angles from the total angle sum."
    }
  ],
