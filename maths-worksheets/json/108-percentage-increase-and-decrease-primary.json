{
  "title": "PERCENTAGES OF AMOUNTS,\n(PERCENTAGE INCREASE AND DECREASE)",
  "objective": "LO: I can solve problems involving percentage increase and decrease of amounts.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Increasing and decreasing",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"ul-b\">increase</span> by a percentage: find the percentage of the amount and <span class=\"ul-k\">add</span> it to the original. To <span class=\"ul-b\">decrease</span>: find the percentage and <span class=\"ul-k\">subtract</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Quick method:</span> Use a single calculation. Increase by 20% &rarr; multiply by 1.2. Decrease by 20% &rarr; multiply by 0.8."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&pound;50 increased by 10% = &pound;55",
          "desc": "add 10% of 50"
        },
        {
          "correct": true,
          "expr": "&pound;80 decreased by 25% = &pound;60",
          "desc": "subtract 25% of 80"
        },
        {
          "correct": true,
          "expr": "&pound;120 increased by 50% = &pound;180",
          "desc": "add half"
        },
        {
          "correct": false,
          "expr": "&pound;50 increased by 10% = &pound;60",
          "desc": "10% of 50 is 5, not 10"
        },
        {
          "correct": false,
          "expr": "&pound;80 decreased by 25% = &pound;55",
          "desc": "25% of 80 is 20"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Find the percentage, then add (increase) or subtract (decrease) from the original.",
      "equation": "Increase: <span class=\"ov\">Original + %</span> | Decrease: <span class=\"ovr\">Original &minus; %</span>",
      "caption": "Or use the single multiplier method"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; increase (add)",
      "question": "Increase &pound;60 by 15%.",
      "steps": [
        "15% of 60: 10% = 6, 5% = 3",
        "15% = 6 + 3 = 9",
        "60 + 9 = &pound;69"
      ],
      "answer": "&pound;69",
      "explanation": "Find 15% then add it to the original."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; decrease (subtract)",
      "question": "Decrease &pound;240 by 35%.",
      "steps": [
        "10% of 240 = 24",
        "30% = 72; 5% = 12; 35% = 84",
        "240 &minus; 84 = &pound;156"
      ],
      "answer": "&pound;156",
      "explanation": "Find 35% then subtract from the original."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; single multiplier increase",
      "question": "A &pound;450 TV increases by 8%. Find the new price.",
      "steps": [
        "Multiplier = 1.08",
        "450 &times; 1.08",
        "= &pound;486"
      ],
      "answer": "&pound;486",
      "explanation": "Multiply by 1.08 in one step for speed."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; single multiplier decrease",
      "question": "A &pound;320 bike is reduced by 12.5% in a sale.",
      "steps": [
        "Multiplier = 1 &minus; 0.125 = 0.875",
        "320 &times; 0.875",
        "= &pound;280"
      ],
      "answer": "&pound;280",
      "explanation": "Multiplier = 1 &minus; 0.125 = 0.875."
    }
  ],
