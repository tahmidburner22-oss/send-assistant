{
  "title": "PERCENTAGES OF AMOUNTS,\n(PERCENTAGE INCREASE AND DECREASE)",
  "objective": "LO: I can find a percentage increase or decrease and express a change as a percentage.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Percentage change",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"\u0001\">percentage change</span> tells you how much something has gone up or down compared to the <span class=\"\u0001\">original</span> amount, expressed as a percentage."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Formula:</span> Percentage change = (change &divide; original) &times; 100%"
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "20 to 25: change = 5, % = 5/20 &times; 100 = 25%",
          "desc": "increase"
        },
        {
          "correct": true,
          "expr": "80 to 60: change = 20, % = 20/80 &times; 100 = 25%",
          "desc": "decrease"
        },
        {
          "correct": true,
          "expr": "Always divide by the ORIGINAL amount",
          "desc": "key rule"
        },
        {
          "correct": false,
          "expr": "20 to 25: % change = 5/25 &times; 100 = 20%",
          "desc": "divided by new, not original"
        },
        {
          "correct": false,
          "expr": "Change from 80 to 60 = 20%",
          "desc": "must divide by original (80)"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Percentage change = (difference &divide; original) &times; 100. Always divide by the ORIGINAL value.",
      "equation": "% change = <span class=\"\u0001\">&frac{change}{original}</span> &times; <span class=\"\u0001\">100</span>",
      "caption": "Divide by the starting value, not the new value"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; percentage increase",
      "question": "A price goes from &pound;40 to &pound;52. Find the percentage increase.",
      "steps": [
        "Change = 52 - 40 = 12",
        "% change = 12 &divide; 40 &times; 100",
        "= 30% increase"
      ],
      "answer": "= 30% increase",
      "explanation": "Divide the change by the original amount."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; percentage decrease",
      "question": "A weight drops from 80 kg to 68 kg. Find the percentage decrease.",
      "steps": [
        "Change = 80 - 68 = 12",
        "% change = 12 &divide; 80 &times; 100",
        "= 15% decrease"
      ],
      "answer": "= 15% decrease",
      "explanation": "Same formula, but the answer is a decrease."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; with decimals",
      "question": "A bill goes from &pound;120 to &pound;135. Find the percentage change.",
      "steps": [
        "Change = 135 - 120 = 15",
        "% change = 15 &divide; 120 &times; 100",
        "= 12.5% increase"
      ],
      "answer": "= 12.5% increase",
      "explanation": "The answer can be a decimal percentage."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; comparing changes",
      "question": "Shop A: &pound;50 to &pound;60. Shop B: &pound;80 to &pound;92. Which has the bigger % increase?",
      "steps": [
        "Shop A: 10/50 &times; 100 = 20%",
        "Shop B: 12/80 &times; 100 = 15%",
        "Shop A has the bigger percentage increase"
      ],
      "answer": "Shop A = 20%, Shop B = 15%",
      "explanation": "Compare percentage changes, not absolute changes."
    }
  ],
