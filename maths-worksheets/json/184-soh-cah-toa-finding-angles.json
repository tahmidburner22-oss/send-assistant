{
  "title": "TRIGONOMETRY,\n(SOH CAH TOA — FINDING ANGLES)",
  "objective": "LO: I can use inverse trigonometric functions to find missing angles in right-angled triangles.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Finding angles",
      "content": [
        {
          "type": "paragraph",
          "text": "To find a missing <span class=\"ul-b\">angle</span> in a right-angled triangle, use the <span class=\"ul-k\">inverse trig functions</span>: sin⁻¹, cos⁻¹, or tan⁻¹."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">SOH CAH TOA:</span> Choose the ratio that uses the two known sides. Then apply the inverse function to find the angle."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "sin x = 5/10 &rarr; x = sin&minus;&sup1;(0.5) = 30&deg;",
          "desc": "inverse sin"
        },
        {
          "correct": true,
          "expr": "cos x = 8/10 &rarr; x = cos&minus;&sup1;(0.8) = 36.9&deg;",
          "desc": "inverse cos"
        },
        {
          "correct": true,
          "expr": "tan x = 7/4 &rarr; x = tan&minus;&sup1;(1.75) = 60.3&deg;",
          "desc": "inverse tan"
        },
        {
          "correct": false,
          "expr": "sin x = 5/10 means x = 0.5&deg;",
          "desc": "must use inverse sin"
        },
        {
          "correct": false,
          "expr": "Use sin when you have adj and hyp",
          "desc": "that needs cos"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Identify which sides you know (O, A, H), choose the correct ratio, then use the inverse function.",
      "equation": "&theta; = <span class=\"ov\">sin&minus;&sup1;</span>(<span class=\"ovr\">O/H</span>)",
      "caption": "SOH: sin = Opp/Hyp, CAH: cos = Adj/Hyp, TOA: tan = Opp/Adj"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; using sin",
      "question": "Find angle x. Opposite = 6 cm, hypotenuse = 12 cm.",
      "steps": [
        "Opp and Hyp: use sin",
        "sin x = 6/12 = 0.5",
        "x = sin&minus;&sup1;(0.5) = 30&deg;"
      ],
      "answer": "x = 30&deg;",
      "explanation": "Label the sides relative to the angle, then choose the correct ratio."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; using cos",
      "question": "Find angle x. Adjacent = 8 cm, hypotenuse = 10 cm.",
      "steps": [
        "Adj and Hyp: use cos",
        "cos x = 8/10 = 0.8",
        "x = cos&minus;&sup1;(0.8) = 36.9&deg;"
      ],
      "answer": "x = 36.9&deg;",
      "explanation": "CAH: cos = adjacent / hypotenuse."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; using tan",
      "question": "Find angle x. Opposite = 9 cm, adjacent = 5 cm.",
      "steps": [
        "Opp and Adj: use tan",
        "tan x = 9/5 = 1.8",
        "x = tan&minus;&sup1;(1.8) = 60.9&deg;"
      ],
      "answer": "x = 60.9&deg;",
      "explanation": "TOA: tan = opposite / adjacent."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; third angle",
      "question": "In a right triangle, one angle is 53.1&deg;. Find the other acute angle.",
      "steps": [
        "Angles sum to 180&deg;",
        "Third = 180 &minus; 90 &minus; 53.1",
        "= 36.9&deg;"
      ],
      "answer": "36.9&deg;",
      "explanation": "Angles in a triangle sum to 180&deg;."
    }
  ],
