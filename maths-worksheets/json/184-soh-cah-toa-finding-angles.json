{
  "title": "TRIGONOMETRY,\n(SOH CAH TOA FINDING ANGLES)",
  "objective": "LO: I can use inverse trigonometric functions to find unknown angles in right-angled triangles.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Finding angles with trigonometry",
      "content": [
        {
          "type": "paragraph",
          "text": "To find an <span class=\"ul-b\">unknown angle</span>, use the inverse trig functions: sin⁻¹, cos⁻¹, or tan⁻¹. Choose which ratio to use based on which <span class=\"ul-k\">two sides</span> are known."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">SOH CAH TOA:</span> Sin = Opposite/Hypotenuse, Cos = Adjacent/Hypotenuse, Tan = Opposite/Adjacent."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "opp = 3, hyp = 6: angle = sin⁻¹(3/6) = 30°",
          "desc": "use SOH"
        },
        {
          "correct": true,
          "expr": "adj = 4, hyp = 8: angle = cos⁻¹(4/8) = 60°",
          "desc": "use CAH"
        },
        {
          "correct": true,
          "expr": "opp = 5, adj = 5: angle = tan⁻¹(1) = 45°",
          "desc": "use TOA"
        },
        {
          "correct": false,
          "expr": "Use sin when you have adjacent and hypotenuse",
          "desc": "that is cos (CAH)"
        },
        {
          "correct": false,
          "expr": "sin⁻¹(0.5) = 60°",
          "desc": "sin⁻¹(0.5) = 30°"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Identify the two known sides, choose the correct ratio, then apply the inverse function.",
      "equation": "θ = <span class=\"ov\">sin⁻¹</span>(<span class=\"ovr\">opp &divide; hyp</span>)",
      "caption": "Or cos⁻¹(adj/hyp) or tan⁻¹(opp/adj)"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; using sin inverse",
      "question": "Find angle x: opposite = 4, hypotenuse = 8.",
      "steps": [
        "Have opposite and hypotenuse: use sin",
        "sin x = 4/8 = 0.5",
        "x = sin⁻¹(0.5) = 30°"
      ],
      "answer": "x = 30°",
      "explanation": "Opposite and hypotenuse means SOH."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; using cos inverse",
      "question": "Find angle x: adjacent = 5, hypotenuse = 10.",
      "steps": [
        "Have adjacent and hypotenuse: use cos",
        "cos x = 5/10 = 0.5",
        "x = cos⁻¹(0.5) = 60°"
      ],
      "answer": "x = 60°",
      "explanation": "Adjacent and hypotenuse means CAH."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; using tan inverse",
      "question": "Find angle x: opposite = 7, adjacent = 7.",
      "steps": [
        "Have opposite and adjacent: use tan",
        "tan x = 7/7 = 1",
        "x = tan⁻¹(1) = 45°"
      ],
      "answer": "x = 45°",
      "explanation": "Opposite and adjacent means TOA."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; decimal answer",
      "question": "Find angle x: opposite = 6, hypotenuse = 9.",
      "steps": [
        "sin x = 6/9 = 0.667...",
        "x = sin⁻¹(0.667)",
        "x = 41.8° (1 dp)"
      ],
      "answer": "x = 41.8°",
      "explanation": "Round to 1 decimal place unless told otherwise."
    }
  ],
