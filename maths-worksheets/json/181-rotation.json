{
  "title": "TRANSFORMATIONS,\n(ROTATION)",
  "objective": "LO: I can rotate shapes about a given centre and describe rotations.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Rotation",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">rotation</span> turns a shape about a fixed point called the <span class=\"ul-k\">centre of rotation</span>. You need to know the centre, the <span class=\"ul-k\">angle</span> and the <span class=\"ul-k\">direction</span> (clockwise or anticlockwise)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Key rotations:</span> 90&deg; CW: (x,y)&rarr;(y,&minus;x). 90&deg; ACW: (x,y)&rarr;(&minus;y,x). 180&deg;: (x,y)&rarr;(&minus;x,&minus;y). All about the origin."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "90&deg; CW about (0,0): (3,1) &rarr; (1,&minus;3)",
          "desc": "(x,y)&rarr;(y,&minus;x)"
        },
        {
          "correct": true,
          "expr": "180&deg; about (0,0): (3,1) &rarr; (&minus;3,&minus;1)",
          "desc": "negate both"
        },
        {
          "correct": true,
          "expr": "90&deg; ACW about (0,0): (3,1) &rarr; (&minus;1,3)",
          "desc": "(x,y)&rarr;(&minus;y,x)"
        },
        {
          "correct": false,
          "expr": "90&deg; CW: (3,1) &rarr; (&minus;3,&minus;1)",
          "desc": "that is 180&deg;"
        },
        {
          "correct": false,
          "expr": "Rotation changes the size of the shape",
          "desc": "size stays the same"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "To describe a rotation: state the centre, angle, and direction. Size and shape are preserved.",
      "equation": "90&deg; CW: (x,y) &rarr; <span class=\"ov\">(y, &minus;x)</span> about origin",
      "caption": "Every point stays the same distance from the centre"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; 90 CW about origin",
      "question": "Rotate (2, 5) by 90&deg; clockwise about (0,0).",
      "steps": [
        "Rule: (x, y) &rarr; (y, &minus;x)",
        "(2, 5) &rarr; (5, &minus;2)",
        "Image is (5, &minus;2)"
      ],
      "answer": "(5, &minus;2)",
      "explanation": "Apply the 90&deg; CW rule: swap and negate the new y."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; 180 about origin",
      "question": "Rotate (&minus;3, 4) by 180&deg; about (0,0).",
      "steps": [
        "Rule: (x, y) &rarr; (&minus;x, &minus;y)",
        "(&minus;3, 4) &rarr; (3, &minus;4)",
        "Image is (3, &minus;4)"
      ],
      "answer": "(3, &minus;4)",
      "explanation": "180&deg; rotation negates both coordinates."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; 90 ACW about origin",
      "question": "Rotate (4, &minus;1) by 90&deg; anticlockwise about (0,0).",
      "steps": [
        "Rule: (x, y) &rarr; (&minus;y, x)",
        "(4, &minus;1) &rarr; (1, 4)",
        "Image is (1, 4)"
      ],
      "answer": "(1, 4)",
      "explanation": "90&deg; ACW: negate y then swap."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; about another centre",
      "question": "Rotate (5, 3) by 180&deg; about (2, 1).",
      "steps": [
        "Translate to origin: (5&minus;2, 3&minus;1) = (3, 2)",
        "Apply 180&deg;: (&minus;3, &minus;2)",
        "Translate back: (&minus;3+2, &minus;2+1) = (&minus;1, &minus;1)"
      ],
      "answer": "(&minus;1, &minus;1)",
      "explanation": "Subtract centre, rotate, then add centre back."
    }
  ],
