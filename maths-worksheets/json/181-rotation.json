{
  "title": "TRANSFORMATIONS,\n(ROTATION)",
  "objective": "LO: I can rotate shapes about a given centre by 90, 180, or 270 degrees.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Rotation",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">rotation</span> turns a shape around a fixed point called the <span class=\"ul-k\">centre of rotation</span>. You need to know the centre, angle, and direction (clockwise or anticlockwise)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Key rules:</span> 90° clockwise: (x,y)&rarr;(y,-x). 90° anticlockwise: (x,y)&rarr;(-y,x). 180°: (x,y)&rarr;(-x,-y) about the origin."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "(3, 1) rotated 90° clockwise about origin = (1, -3)",
          "desc": "(x,y)&rarr;(y,-x)"
        },
        {
          "correct": true,
          "expr": "(3, 1) rotated 180° about origin = (-3, -1)",
          "desc": "negate both"
        },
        {
          "correct": true,
          "expr": "Rotation preserves shape and size",
          "desc": "congruent image"
        },
        {
          "correct": false,
          "expr": "90° clockwise is the same as 90° anticlockwise",
          "desc": "they are opposite directions"
        },
        {
          "correct": false,
          "expr": "Rotation changes the size of the shape",
          "desc": "size is preserved"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "To describe a rotation, state: centre, angle, and direction. The shape does not change size.",
      "equation": "90° CW about O: <span class=\"ov\">(x, y)</span> &rarr; <span class=\"ovr\">(y, -x)</span>",
      "caption": "180°: (x, y) &rarr; (-x, -y)"
    }
  },
