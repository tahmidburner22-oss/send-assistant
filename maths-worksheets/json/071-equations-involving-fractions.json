{
  "title": "ALGEBRAIC FRACTIONS,\n(EQUATIONS INVOLVING FRACTIONS)",
  "objective": "LO: I can solve equations that contain algebraic fractions.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Solving equations with fractions",
      "content": [
        {
          "type": "paragraph",
          "text": "An <span class=\"ul-b\">equation involving fractions</span> has the unknown in a fraction. The key strategy is to <span class=\"ul-k\">multiply through by the LCD</span> to eliminate denominators."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Find the LCD of all fractions, multiply every term by it, then solve the resulting equation."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&frac{x}{3} = 5 &rArr; x = 15",
          "desc": "multiply both sides by 3"
        },
        {
          "correct": true,
          "expr": "&frac{x}{2} + &frac{x}{3} = 5 &rArr; 5x = 30",
          "desc": "LCD = 6"
        },
        {
          "correct": true,
          "expr": "&frac{2}{x} = &frac{1}{3} &rArr; x = 6",
          "desc": "cross-multiply"
        },
        {
          "correct": false,
          "expr": "&frac{x}{2} + &frac{x}{3} = &frac{2x}{5}",
          "desc": "cannot add denominators"
        },
        {
          "correct": false,
          "expr": "&frac{x+1}{3} = 5 &rArr; x = 14",
          "desc": "should be x + 1 = 15, x = 14 (correct!)"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiply every term by the LCD to clear fractions, then solve the equation as normal.",
      "equation": "&frac{x}{2} + &frac{x}{3} = 5 &rArr; <span class=\"ov\">3x + 2x</span> = <span class=\"ovr\">30</span>",
      "caption": "Multiply all terms by LCD = 6"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; single fraction",
      "question": "Solve &frac{x}{4} = 7",
      "steps": [
        "Multiply both sides by 4",
        "x = 4 &times; 7",
        "x = 28"
      ],
      "answer": "x = 28",
      "explanation": "Multiply by the denominator to isolate x."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; two fractions",
      "question": "Solve &frac{x}{2} + &frac{x}{5} = 7",
      "steps": [
        "LCD = 10; multiply all terms by 10",
        "5x + 2x = 70",
        "7x = 70, so x = 10"
      ],
      "answer": "x = 10",
      "explanation": "After clearing fractions, collect terms and solve."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; x in denominator",
      "question": "Solve &frac{6}{x} = 3",
      "steps": [
        "Multiply both sides by x",
        "6 = 3x",
        "x = 2"
      ],
      "answer": "x = 2",
      "explanation": "When x is in the denominator, multiply both sides by x."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; cross-multiplication",
      "question": "Solve &frac{x+1}{3} = &frac{x&minus;2}{2}",
      "steps": [
        "Cross-multiply: 2(x+1) = 3(x&minus;2)",
        "2x + 2 = 3x &minus; 6",
        "2 + 6 = 3x &minus; 2x, so x = 8"
      ],
      "answer": "x = 8",
      "explanation": "Cross-multiply when you have a fraction equal to a fraction."
    }
  ],
