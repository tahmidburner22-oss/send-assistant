{
  "title": "TRANSFORMATIONS,\n(REFLECTION)",
  "objective": "LO: I can reflect shapes in mirror lines including the axes and the lines y = x and y = -x.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Reflection",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">reflection</span> flips a shape across a <span class=\"ul-k\">mirror line</span>. Each point and its image are the same distance from the mirror line."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Common mirror lines:</span> x-axis (y = 0), y-axis (x = 0), y = x (diagonal), y = -x, and vertical/horizontal lines like x = 2."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "Reflect (3, 2) in y-axis gives (-3, 2)",
          "desc": "x changes sign"
        },
        {
          "correct": true,
          "expr": "Reflect (3, 2) in x-axis gives (3, -2)",
          "desc": "y changes sign"
        },
        {
          "correct": true,
          "expr": "Reflect (3, 2) in y = x gives (2, 3)",
          "desc": "swap x and y"
        },
        {
          "correct": false,
          "expr": "Reflect (3, 2) in y-axis gives (3, -2)",
          "desc": "that is reflection in x-axis"
        },
        {
          "correct": false,
          "expr": "Reflection changes the size of the shape",
          "desc": "size stays the same"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Each point is the same perpendicular distance from the mirror line as its image, on the opposite side.",
      "equation": "<span class=\"ov\">(a, b)</span> in y-axis &rarr; <span class=\"ovr\">(-a, b)</span>",
      "caption": "Reflecting in the y-axis negates the x-coordinate"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; reflection in y-axis",
      "question": "Reflect (4, 3) in the y-axis.",
      "steps": [
        "Mirror line is x = 0 (y-axis)",
        "x-coordinate changes sign: 4 becomes -4",
        "y-coordinate stays the same: 3"
      ],
      "answer": "(-4, 3)",
      "explanation": "Reflection in y-axis: (x, y) becomes (-x, y)."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; reflection in x-axis",
      "question": "Reflect (-2, 5) in the x-axis.",
      "steps": [
        "Mirror line is y = 0 (x-axis)",
        "x-coordinate stays: -2",
        "y-coordinate changes sign: 5 becomes -5"
      ],
      "answer": "(-2, -5)",
      "explanation": "Reflection in x-axis: (x, y) becomes (x, -y)."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; reflection in y = x",
      "question": "Reflect (1, 4) in the line y = x.",
      "steps": [
        "The line y = x is the diagonal",
        "Swap x and y coordinates",
        "(1, 4) becomes (4, 1)"
      ],
      "answer": "(4, 1)",
      "explanation": "Reflection in y = x swaps the coordinates."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; reflection in x = 2",
      "question": "Reflect (5, 3) in the line x = 2.",
      "steps": [
        "Distance from x = 2: 5 - 2 = 3",
        "Image is 3 to the left of x = 2",
        "Image x = 2 - 3 = -1; y stays at 3"
      ],
      "answer": "(-1, 3)",
      "explanation": "Find distance to mirror line, go same distance on other side."
    }
  ],
