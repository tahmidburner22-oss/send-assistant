{
  "title": "TRANSFORMATIONS,\n(REFLECTION)",
  "objective": "LO: I can reflect shapes in given mirror lines and describe reflections.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Reflection",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">reflection</span> flips a shape over a <span class=\"ul-k\">mirror line</span>. Each point and its image are the same perpendicular distance from the mirror line."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Common mirror lines:</span> x-axis (y = 0), y-axis (x = 0), y = x, y = &minus;x, or lines like x = 2."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "(3, 2) reflected in y-axis &rarr; (&minus;3, 2)",
          "desc": "x changes sign"
        },
        {
          "correct": true,
          "expr": "(3, 2) reflected in x-axis &rarr; (3, &minus;2)",
          "desc": "y changes sign"
        },
        {
          "correct": true,
          "expr": "(3, 2) reflected in y = x &rarr; (2, 3)",
          "desc": "swap x and y"
        },
        {
          "correct": false,
          "expr": "Reflection in y-axis changes the y-coordinate",
          "desc": "it changes x"
        },
        {
          "correct": false,
          "expr": "Reflected shapes change size",
          "desc": "size stays the same"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Every point is the same distance from the mirror line as its image, measured perpendicularly.",
      "equation": "y-axis: (x, y) &rarr; (<span class=\"ov\">&minus;x</span>, y) | x-axis: (x, y) &rarr; (x, <span class=\"ovr\">&minus;y</span>)",
      "caption": "The mirror line is the perpendicular bisector of each point and its image"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; in y-axis",
      "question": "Reflect (4, 3) in the y-axis.",
      "steps": [
        "The y-axis is x = 0",
        "x-coordinate changes sign: 4 &rarr; &minus;4",
        "y stays the same: (−4, 3)"
      ],
      "answer": "(&minus;4, 3)",
      "explanation": "Reflecting in the y-axis negates the x-coordinate."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; in x-axis",
      "question": "Reflect (&minus;2, 5) in the x-axis.",
      "steps": [
        "The x-axis is y = 0",
        "y-coordinate changes sign: 5 &rarr; &minus;5",
        "x stays: (&minus;2, &minus;5)"
      ],
      "answer": "(&minus;2, &minus;5)",
      "explanation": "Reflecting in the x-axis negates the y-coordinate."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; in y = x",
      "question": "Reflect (1, 4) in the line y = x.",
      "steps": [
        "For y = x, swap the coordinates",
        "x becomes y and y becomes x",
        "(1, 4) &rarr; (4, 1)"
      ],
      "answer": "(4, 1)",
      "explanation": "Reflecting in y = x swaps the x and y coordinates."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; in vertical line",
      "question": "Reflect (5, 3) in the line x = 2.",
      "steps": [
        "Distance from x = 2: 5 &minus; 2 = 3 units right",
        "Image is 3 units left of x = 2: 2 &minus; 3 = &minus;1",
        "(&minus;1, 3)"
      ],
      "answer": "(&minus;1, 3)",
      "explanation": "Count the perpendicular distance and go the same distance the other side."
    }
  ],
