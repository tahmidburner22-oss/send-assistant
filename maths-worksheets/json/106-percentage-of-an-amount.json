{
  "title": "PERCENTAGES,\n(PERCENTAGE OF AN AMOUNT)",
  "objective": "LO: I can find a percentage of an amount using mental and written methods.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Finding a percentage of an amount",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Percentage</span> means 'out of 100'. To find a percentage of an amount, convert the percentage to a <span class=\"ul-k\">decimal or fraction</span> and multiply."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Mental shortcuts:</span> 10% = divide by 10; 5% = half of 10%; 1% = divide by 100. Build other percentages from these."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "10% of &pound;60 = &pound;6",
          "desc": "divide by 10"
        },
        {
          "correct": true,
          "expr": "25% of &pound;80 = &pound;20",
          "desc": "divide by 4"
        },
        {
          "correct": true,
          "expr": "15% of &pound;40 = &pound;6",
          "desc": "10% + 5% = 4 + 2 = 6"
        },
        {
          "correct": false,
          "expr": "10% of &pound;60 = &pound;60",
          "desc": "should divide by 10"
        },
        {
          "correct": false,
          "expr": "50% of 30 = 60",
          "desc": "50% means half, so answer is 15"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Percentage of amount = (percentage &divide; 100) &times; amount. Build complex percentages from 10%, 5%, and 1%.",
      "equation": "<span class=\"ov\">15%</span> of 80 = <span class=\"ovr\">10% + 5%</span> = 8 + 4 = 12",
      "caption": "Break percentages into easy parts"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; using division by 10",
      "question": "Find 10% of &pound;250.",
      "steps": [
        "10% means divide by 10",
        "250 &divide; 10",
        "= &pound;25"
      ],
      "answer": "&pound;25",
      "explanation": "10% always means one tenth of the amount."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; building from 10%",
      "question": "Find 35% of &pound;80.",
      "steps": [
        "10% of 80 = 8",
        "30% = 3 &times; 8 = 24; 5% = 8 &divide; 2 = 4",
        "35% = 24 + 4 = &pound;28"
      ],
      "answer": "&pound;28",
      "explanation": "Build up from 10% and 5% for efficient mental methods."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; using a decimal",
      "question": "Find 17.5% of &pound;240.",
      "steps": [
        "Convert: 17.5% = 0.175",
        "240 &times; 0.175",
        "= &pound;42"
      ],
      "answer": "&pound;42",
      "explanation": "For awkward percentages, convert to a decimal and multiply."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; percentage as a fraction",
      "question": "Find 75% of 360.",
      "steps": [
        "75% = &frac{3}{4}",
        "360 &divide; 4 = 90",
        "90 &times; 3 = 270"
      ],
      "answer": "270",
      "explanation": "75% = three-quarters. Divide by 4 then multiply by 3."
    }
  ],
