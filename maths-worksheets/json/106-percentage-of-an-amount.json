{
  "title": "PERCENTAGES,\n(PERCENTAGE OF AN AMOUNT)",
  "objective": "LO: I can calculate a percentage of an amount using mental and written methods.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Finding a percentage of an amount",
      "content": [
        {
          "type": "paragraph",
          "text": "To find a <span class=\"\u0001\">percentage of an amount</span>, divide by 100 to find 1%, then multiply by the percentage needed. Or use the <span class=\"\u0001\">multiplier</span> method."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Multiplier:</span> 35% of 80 = 0.35 &times; 80 = 28. The percentage as a decimal IS the multiplier."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "10% of 70 = 7",
          "desc": "divide by 10"
        },
        {
          "correct": true,
          "expr": "25% of 60 = 15",
          "desc": "divide by 4"
        },
        {
          "correct": true,
          "expr": "15% of 80 = 12",
          "desc": "10% + 5% = 8 + 4"
        },
        {
          "correct": false,
          "expr": "10% of 70 = 70",
          "desc": "that is 100%"
        },
        {
          "correct": false,
          "expr": "25% of 60 = 20",
          "desc": "divided by 3 not 4"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Percentage means per hundred. Divide by 100 to find 1%, then scale up.",
      "equation": "<span class=\"\u0001\">P%</span> of A = <span class=\"\u0001\">&frac{P}{100}</span> &times; A",
      "caption": "Convert percentage to decimal, then multiply"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; using 10%",
      "question": "Find 30% of 90",
      "steps": [
        "10% of 90 = 9",
        "30% = 3 &times; 10%",
        "3 &times; 9 = 27"
      ],
      "answer": "= 27",
      "explanation": "Find 10% first, then multiply by 3 for 30%."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; using the multiplier",
      "question": "Find 45% of 200",
      "steps": [
        "45% as a decimal = 0.45",
        "0.45 &times; 200",
        "= 90"
      ],
      "answer": "= 90",
      "explanation": "The multiplier method works for any percentage."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; building percentages",
      "question": "Find 17.5% of 60",
      "steps": [
        "10% = 6, 5% = 3, 2.5% = 1.5",
        "17.5% = 10% + 5% + 2.5%",
        "= 6 + 3 + 1.5 = 10.5"
      ],
      "answer": "= 10.5",
      "explanation": "Break awkward percentages into easier parts."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; percentage of money",
      "question": "Find 12% of &pound;350",
      "steps": [
        "1% of 350 = 3.50",
        "12% = 12 &times; 3.50",
        "= &pound;42"
      ],
      "answer": "= &pound;42",
      "explanation": "Find 1% by dividing by 100, then multiply up."
    }
  ],
