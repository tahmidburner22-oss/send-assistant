{
  "title": "SEQUENCES,\n(FIBONACCI-TYPE SEQUENCES)",
  "objective": "LO: I can generate and analyse Fibonacci-type sequences where each term is the sum of the two preceding terms.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What are Fibonacci-type sequences?",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">Fibonacci-type sequence</span> is one where each term equals the <span class=\"ul-k\">sum of the two previous terms</span>. The classic Fibonacci sequence starts 1, 1, 2, 3, 5, 8, 13, ..."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> To continue: add the last two terms. To work backwards: subtract. Different starting values give different Fibonacci-type sequences."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "1, 1, 2, 3, 5, 8, 13, 21, ...",
          "desc": "classic Fibonacci"
        },
        {
          "correct": true,
          "expr": "2, 5, 7, 12, 19, 31, ...",
          "desc": "Fibonacci-type (starts 2, 5)"
        },
        {
          "correct": true,
          "expr": "Each term = sum of previous two terms",
          "desc": "the rule"
        },
        {
          "correct": false,
          "expr": "1, 1, 2, 3, 5, 9, ...",
          "desc": "5 + 3 = 8, not 9"
        },
        {
          "correct": false,
          "expr": "Fibonacci sequences always start with 1, 1",
          "desc": "can start with any pair"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Each term is the sum of the previous two: u<sub>n</sub> = u<sub>n&minus;1</sub> + u<sub>n&minus;2</sub>.",
      "equation": "u<sub>n</sub> = <span class=\"ov\">u<sub>n&minus;1</sub></span> + <span class=\"ovr\">u<sub>n&minus;2</sub></span>",
      "caption": "Add the two previous terms to get the next"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; continuing a sequence",
      "question": "Continue the sequence 3, 7, 10, 17, ... for two more terms.",
      "steps": [
        "Next term: 10 + 17 = 27",
        "Then: 17 + 27 = 44",
        "Sequence: 3, 7, 10, 17, 27, 44"
      ],
      "answer": "27, 44",
      "explanation": "Each term is the sum of the two before it."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; finding a missing term",
      "question": "In the sequence _, _, 5, 8, 13, find the two missing terms.",
      "steps": [
        "Third term (5) = first + second",
        "8 = second + 5, so second = 3",
        "5 = first + 3, so first = 2. Sequence: 2, 3, 5, 8, 13"
      ],
      "answer": "2, 3",
      "explanation": "Work backwards by subtracting: previous = current &minus; the one before."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; given starting values",
      "question": "Write the first 6 terms of a Fibonacci-type sequence starting 4, 1.",
      "steps": [
        "Term 3: 4 + 1 = 5",
        "Term 4: 1 + 5 = 6; Term 5: 5 + 6 = 11",
        "Term 6: 6 + 11 = 17"
      ],
      "answer": "4, 1, 5, 6, 11, 17",
      "explanation": "Any two starting values generate a unique Fibonacci-type sequence."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; with negative terms",
      "question": "Write the first 6 terms starting 2, &minus;1.",
      "steps": [
        "Term 3: 2 + (&minus;1) = 1",
        "Term 4: &minus;1 + 1 = 0; Term 5: 1 + 0 = 1",
        "Term 6: 0 + 1 = 1"
      ],
      "answer": "2, &minus;1, 1, 0, 1, 1",
      "explanation": "Negative starting values are allowed; the sequence still follows the same rule."
    }
  ],
