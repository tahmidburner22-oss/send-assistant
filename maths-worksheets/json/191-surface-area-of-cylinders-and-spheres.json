{
  "title": "VOLUME AND SURFACE AREA,\n(SURFACE AREA OF CYLINDERS AND SPHERES)",
  "objective": "LO: I can calculate the surface area of cylinders and spheres.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Surface area formulae",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">surface area</span> of a <span class=\"ul-k\">cylinder</span> = 2&pi;r&sup2; + 2&pi;rh (two circles + curved surface). The surface area of a <span class=\"ul-k\">sphere</span> = 4&pi;r&sup2;."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Units:</span> Surface area is measured in square units (cm&sup2;, m&sup2;)."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key formulae",
      "examples": [
        {
          "correct": true,
          "expr": "Cylinder SA = 2&pi;r&sup2; + 2&pi;rh",
          "desc": "two circles + rectangle"
        },
        {
          "correct": true,
          "expr": "Sphere SA = 4&pi;r&sup2;",
          "desc": "four times pi r squared"
        },
        {
          "correct": true,
          "expr": "Hemisphere SA = 3&pi;r&sup2;",
          "desc": "half sphere + circle base"
        },
        {
          "correct": false,
          "expr": "Cylinder SA = &pi;r&sup2;h",
          "desc": "that is volume"
        },
        {
          "correct": false,
          "expr": "Sphere SA = 2&pi;r&sup2;",
          "desc": "must be 4&pi;r&sup2;"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Cylinder: unwrap to get rectangle (2&pi;rh) plus two circles (2&pi;r&sup2;). Sphere: 4&pi;r&sup2;.",
      "equation": "Cylinder: <span class=\"ov\">2&pi;r(r + h)</span> | Sphere: <span class=\"ovr\">4&pi;r&sup2;</span>",
      "caption": "Remember: surface area uses squared units"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; cylinder SA",
      "question": "Find the SA of a cylinder with r = 3, h = 10.",
      "steps": [
        "SA = 2&pi;r&sup2; + 2&pi;rh",
        "= 2&pi;(9) + 2&pi;(3)(10)",
        "= 18&pi; + 60&pi; = 78&pi; = 245.0 cm&sup2;"
      ],
      "answer": "245.0 cm&sup2;",
      "explanation": "Add the areas of two circles and the curved surface."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; sphere SA",
      "question": "Find the SA of a sphere with radius 5 cm.",
      "steps": [
        "SA = 4&pi;r&sup2;",
        "= 4&pi;(25)",
        "= 100&pi; = 314.2 cm&sup2;"
      ],
      "answer": "314.2 cm&sup2;",
      "explanation": "Substitute into 4&pi;r&sup2;."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; hemisphere",
      "question": "Find the total SA of a hemisphere with radius 4 cm.",
      "steps": [
        "Curved surface = 2&pi;r&sup2; = 2&pi;(16) = 32&pi;",
        "Flat circle = &pi;r&sup2; = 16&pi;",
        "Total = 48&pi; = 150.8 cm&sup2;"
      ],
      "answer": "150.8 cm&sup2;",
      "explanation": "Hemisphere = half sphere surface + flat circular base."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; open cylinder",
      "question": "A cylindrical can (no lid) has r = 4, h = 8. Find SA.",
      "steps": [
        "Base circle: &pi;r&sup2; = 16&pi;",
        "Curved surface: 2&pi;rh = 64&pi;",
        "Total = 80&pi; = 251.3 cm&sup2;"
      ],
      "answer": "251.3 cm&sup2;",
      "explanation": "Open cylinder: one circle + curved surface."
    }
  ],
