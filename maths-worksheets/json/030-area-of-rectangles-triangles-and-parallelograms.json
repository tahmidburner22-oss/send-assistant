{
  "title": "AREA AND PERIMETER,\n(AREA OF RECTANGLES, TRIANGLES AND PARALLELOGRAMS)",
  "objective": "LO: I can calculate the area of rectangles, triangles and parallelograms.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Area formulae",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Area</span> is the amount of space inside a 2D shape, measured in <span class=\"ul-k\">square units</span> (cm&sup2;, m&sup2;)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Formulae:</span> Rectangle: A = l &times; w. Triangle: A = &frac{1}{2} &times; b &times; h. Parallelogram: A = b &times; h (perpendicular height)."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key facts",
      "examples": [
        {
          "correct": true,
          "expr": "Rectangle: A = length &times; width",
          "desc": "l &times; w"
        },
        {
          "correct": true,
          "expr": "Triangle: A = &frac{1}{2} &times; base &times; height",
          "desc": "half of rectangle"
        },
        {
          "correct": true,
          "expr": "Parallelogram: A = base &times; height",
          "desc": "perpendicular h"
        },
        {
          "correct": false,
          "expr": "Triangle: A = base &times; height",
          "desc": "forgot &frac{1}{2}"
        },
        {
          "correct": false,
          "expr": "Parallelogram: use slant height",
          "desc": "must be perpendicular"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Always use the PERPENDICULAR height (not the slant). Triangle is half of the enclosing rectangle.",
      "equation": "A = <span class=\"ov\">&frac{1}{2}</span> &times; <span class=\"ov\">b</span> &times; <span class=\"ovr\">h</span>",
      "caption": "Triangle: half base times height"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; rectangle",
      "question": "Find the area of a rectangle 8 cm by 5 cm.",
      "steps": [
        "A = l &times; w",
        "A = 8 &times; 5",
        "A = 40 cm&sup2;"
      ],
      "answer": "= 40 cm&sup2;",
      "explanation": "Multiply length by width."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; triangle",
      "question": "Find the area of a triangle with base 10 cm and height 6 cm.",
      "steps": [
        "A = &frac{1}{2} &times; b &times; h",
        "A = &frac{1}{2} &times; 10 &times; 6",
        "A = 30 cm&sup2;"
      ],
      "answer": "= 30 cm&sup2;",
      "explanation": "Half of base times height."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; parallelogram",
      "question": "A parallelogram has base 12 cm and perpendicular height 7 cm. Find its area.",
      "steps": [
        "A = b &times; h",
        "A = 12 &times; 7",
        "A = 84 cm&sup2;"
      ],
      "answer": "= 84 cm&sup2;",
      "explanation": "Use the perpendicular height, not the slant side."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; working backwards",
      "question": "A triangle has area 24 cm&sup2; and base 8 cm. Find the height.",
      "steps": [
        "A = &frac{1}{2} &times; b &times; h",
        "24 = &frac{1}{2} &times; 8 &times; h &rarr; 24 = 4h",
        "h = 6 cm"
      ],
      "answer": "h = 6 cm",
      "explanation": "Rearrange the formula: h = 2A &divide; b."
    }
  ],
