{
  "title": "PERCENTAGES,\n(PERCENTAGE INCREASE AND DECREASE)",
  "objective": "LO: I can increase and decrease amounts by a given percentage using multipliers.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Percentage change",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"ul-b\">increase</span> by a percentage, multiply by <span class=\"ul-k\">1 + (percentage as decimal)</span>. For example, increase by 20% means multiply by 1.20."
        },
        {
          "type": "paragraph",
          "text": "To <span class=\"ul-b\">decrease</span> by a percentage, multiply by <span class=\"ul-k\">1 &minus; (percentage as decimal)</span>. For example, decrease by 15% means multiply by 0.85."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&pound;80 increased by 25% = 80 &times; 1.25 = &pound;100",
          "desc": "multiply by 1.25"
        },
        {
          "correct": true,
          "expr": "&pound;60 decreased by 10% = 60 &times; 0.9 = &pound;54",
          "desc": "multiply by 0.90"
        },
        {
          "correct": true,
          "expr": "VAT at 20%: &pound;50 &times; 1.20 = &pound;60",
          "desc": "add 20%"
        },
        {
          "correct": false,
          "expr": "&pound;80 + 25% = &pound;105",
          "desc": "25% of 80 is 20, not 25"
        },
        {
          "correct": false,
          "expr": "Decrease by 50% then increase by 50% gives original",
          "desc": "it gives 75% of original"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Use a single multiplier for efficiency. Increase: multiplier > 1. Decrease: multiplier < 1.",
      "equation": "New amount = Original &times; <span class=\"ov\">multiplier</span>",
      "caption": "e.g. +30% &rarr; &times;1.30, &minus;30% &rarr; &times;0.70"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; percentage increase",
      "question": "Increase &pound;450 by 12%.",
      "steps": [
        "Multiplier = 1 + 0.12 = 1.12",
        "450 &times; 1.12",
        "= &pound;504"
      ],
      "answer": "&pound;504",
      "explanation": "Add the percentage rate as a decimal to 1."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; percentage decrease",
      "question": "A &pound;85 jacket has 20% off in a sale. Find the sale price.",
      "steps": [
        "Multiplier = 1 &minus; 0.20 = 0.80",
        "85 &times; 0.80",
        "= &pound;68"
      ],
      "answer": "&pound;68",
      "explanation": "Subtract the decimal from 1 for a decrease."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; finding percentage change",
      "question": "A house was bought for &pound;200,000 and sold for &pound;230,000. Find the percentage increase.",
      "steps": [
        "Change = 230,000 &minus; 200,000 = 30,000",
        "Percentage = (30,000 &divide; 200,000) &times; 100",
        "= 15%"
      ],
      "answer": "15% increase",
      "explanation": "Divide the change by the original, then multiply by 100."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; reverse percentage",
      "question": "After a 20% increase, a price is &pound;96. Find the original price.",
      "steps": [
        "&pound;96 = original &times; 1.20",
        "Original = 96 &divide; 1.20",
        "= &pound;80"
      ],
      "answer": "&pound;80",
      "explanation": "Divide by the multiplier to reverse a percentage change."
    }
  ],
