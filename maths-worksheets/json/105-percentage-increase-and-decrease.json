{
  "title": "PERCENTAGES,\n(PERCENTAGE INCREASE AND DECREASE)",
  "objective": "LO: I can increase or decrease an amount by a given percentage using a multiplier.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Percentage increase and decrease",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"\u0001\">percentage increase</span> makes an amount larger. A <span class=\"\u0001\">percentage decrease</span> makes it smaller. Use a single multiplier for efficiency."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Multiplier method:</span> Increase by 15% means &times; 1.15. Decrease by 15% means &times; 0.85."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "Increase &pound;80 by 25%: 80 &times; 1.25 = &pound;100",
          "desc": "multiplier 1.25"
        },
        {
          "correct": true,
          "expr": "Decrease &pound;60 by 10%: 60 &times; 0.90 = &pound;54",
          "desc": "multiplier 0.90"
        },
        {
          "correct": true,
          "expr": "VAT at 20%: multiply by 1.20",
          "desc": "adding 20%"
        },
        {
          "correct": false,
          "expr": "Increase by 25% then decrease by 25% = original",
          "desc": "does not return to original"
        },
        {
          "correct": false,
          "expr": "Decrease by 10%: multiply by 0.10",
          "desc": "that finds 10%, not 90%"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "To increase, add the percentage to 100% to get the multiplier. To decrease, subtract from 100%.",
      "equation": "New = Original &times; <span class=\"\u0001\">multiplier</span>",
      "caption": "Increase: 1 + &frac{%}{100}. Decrease: 1 - <span class=\"\u0001\">&frac{%}{100}</span>"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; percentage increase",
      "question": "Increase &pound;240 by 15%",
      "steps": [
        "Multiplier = 1 + 0.15 = 1.15",
        "240 &times; 1.15",
        "= &pound;276"
      ],
      "answer": "= &pound;276",
      "explanation": "The multiplier 1.15 means 100% + 15% = 115% of original."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; percentage decrease",
      "question": "Decrease &pound;350 by 20%",
      "steps": [
        "Multiplier = 1 - 0.20 = 0.80",
        "350 &times; 0.80",
        "= &pound;280"
      ],
      "answer": "= &pound;280",
      "explanation": "0.80 means keeping 80% (removing 20%)."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; VAT calculation",
      "question": "A TV costs &pound;450 before VAT at 20%. Find the price including VAT.",
      "steps": [
        "Multiplier = 1.20",
        "450 &times; 1.20",
        "= &pound;540"
      ],
      "answer": "= &pound;540",
      "explanation": "VAT is a percentage increase on the original price."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; reverse percentage",
      "question": "After a 20% increase, a price is &pound;360. Find the original.",
      "steps": [
        "&pound;360 = original &times; 1.20",
        "Original = 360 &divide; 1.20",
        "= &pound;300"
      ],
      "answer": "= &pound;300",
      "explanation": "Divide by the multiplier to reverse a percentage change."
    }
  ],
