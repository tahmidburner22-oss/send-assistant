{
  "title": "AREA AND PERIMETER,\n(AREA OF TRAPEZIUMS AND COMPOSITE SHAPES)",
  "objective": "LO: I can calculate the area of trapeziums and composite shapes by splitting into simpler shapes.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Trapezium and composite area",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">trapezium</span> has one pair of parallel sides (a and b). Its area is <span class=\"ul-k\">&frac{1}{2}(a + b) &times; h</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Composite shapes:</span> Split the shape into rectangles, triangles, and/or trapeziums. Find each area, then add (or subtract) them."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key facts",
      "examples": [
        {
          "correct": true,
          "expr": "Trapezium: A = &frac{1}{2}(a + b)h",
          "desc": "parallel sides a, b"
        },
        {
          "correct": true,
          "expr": "Composite: split into known shapes",
          "desc": "then add areas"
        },
        {
          "correct": true,
          "expr": "a = 5, b = 9, h = 4 &rarr; A = 28",
          "desc": "&frac{1}{2}(14)&times;4"
        },
        {
          "correct": false,
          "expr": "Trapezium: A = a &times; b &times; h",
          "desc": "wrong formula"
        },
        {
          "correct": false,
          "expr": "Composite: just add all lengths",
          "desc": "that gives perimeter"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Trapezium: average the parallel sides, then multiply by the height.",
      "equation": "A = <span class=\"ov\">&frac{1}{2}(a + b)</span> &times; <span class=\"ovr\">h</span>",
      "caption": "Average of parallel sides times height"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; basic trapezium",
      "question": "A trapezium has parallel sides 6 cm and 10 cm, height 4 cm. Find the area.",
      "steps": [
        "A = &frac{1}{2}(a + b) &times; h",
        "A = &frac{1}{2}(6 + 10) &times; 4 = &frac{1}{2} &times; 16 &times; 4",
        "A = 32 cm&sup2;"
      ],
      "answer": "= 32 cm&sup2;",
      "explanation": "Add the parallel sides, halve, then multiply by height."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; finding height",
      "question": "A trapezium has area 30 cm&sup2;, parallel sides 4 cm and 8 cm. Find h.",
      "steps": [
        "30 = &frac{1}{2}(4 + 8) &times; h",
        "30 = 6h",
        "h = 5 cm"
      ],
      "answer": "h = 5 cm",
      "explanation": "Rearrange: h = A &divide; &frac{1}{2}(a + b)."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; L-shaped composite",
      "question": "An L-shape: outer 8 cm &times; 6 cm, cut-out 3 cm &times; 4 cm. Find area.",
      "steps": [
        "Full rectangle: 8 &times; 6 = 48 cm&sup2;",
        "Cut-out: 3 &times; 4 = 12 cm&sup2;",
        "Area = 48 &minus; 12 = 36 cm&sup2;"
      ],
      "answer": "= 36 cm&sup2;",
      "explanation": "Subtract the cut-out from the full rectangle."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; T-shaped composite",
      "question": "A T-shape: top rectangle 10 cm &times; 2 cm, stem 3 cm &times; 6 cm.",
      "steps": [
        "Top: 10 &times; 2 = 20 cm&sup2;",
        "Stem: 3 &times; 6 = 18 cm&sup2;",
        "Total = 20 + 18 = 38 cm&sup2;"
      ],
      "answer": "= 38 cm&sup2;",
      "explanation": "Split into two rectangles and add."
    }
  ],
