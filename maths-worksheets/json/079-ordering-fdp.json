{
  "title": "FRACTIONS, DECIMALS AND PERCENTAGES\n(ORDERING FDP)",
  "objective": "LO: I can order fractions, decimals and percentages by converting to a common form.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What does ordering FDP mean?",
      "content": [
        {"type": "paragraph", "text": "<span class=\"ul-b\">Ordering FDP</span> means arranging fractions, decimals and percentages from <span class=\"ul-k\">SMALLEST</span> to largest (ascending) or largest to smallest (descending)."},
        {"type": "paragraph", "text": "<span class=\"rb\">Strategy:</span> Convert ALL values to the SAME form (usually decimals) before comparing. Then rewrite in original form for your final answer."}
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Converting to compare",
      "examples": [
        {"correct": true, "expr": "&frac12;, 0.6, 55% &rarr; 0.5, 0.6, 0.55", "desc": "convert to decimals"},
        {"correct": true, "expr": "Order: 0.5, 0.55, 0.6", "desc": "ascending"},
        {"correct": true, "expr": "Answer: &frac12;, 55%, 0.6", "desc": "rewrite in original form"},
        {"correct": false, "expr": "&frac13; &gt; &frac14; because 3 &lt; 4", "desc": "wrong reasoning"},
        {"correct": false, "expr": "0.9 &lt; 0.12 because 12 &gt; 9", "desc": "ignoring place value"}
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Convert everything to decimals. Compare digit by digit from left to right. Write your final answer in the ORIGINAL forms given in the question.",
      "equation": "<span class=\"ov\">30%</span>, <span class=\"ov\">&frac38;</span>, <span class=\"ov\">0.34</span> &rarr; 0.30, 0.375, 0.34",
      "caption": "Ascending: 30%, 0.34, &frac38;"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; two values",
      "question": "Which is larger: &frac35; or 55%?",
      "steps": ["&frac35; = 3 &divide; 5 = 0.6", "55% = 0.55", "0.6 &gt; 0.55"],
      "answer": "&frac35; is larger",
      "explanation": "Convert both to decimals: 0.6 &gt; 0.55, so &frac35; is larger."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; three values ascending",
      "question": "Order: 0.7, &frac34;, 72%",
      "steps": ["0.7, 0.75, 0.72", "Smallest first: 0.7", "0.7, 72%, &frac34;"],
      "answer": "0.7, 72%, &frac34;",
      "explanation": "All as decimals: 0.7, 0.75, 0.72. Ascending: 0.7, 0.72, 0.75."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; tricky decimals",
      "question": "Order: 0.3, &frac13;, 30%",
      "steps": ["0.3, 0.333..., 0.30", "0.30 = 0.3 &lt; 0.333...", "30% = 0.3, then &frac13;"],
      "answer": "0.3 = 30%, then &frac13;",
      "explanation": "&frac13; = 0.333... which is greater than 0.3. Note: 0.3 and 30% are equal."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; descending order",
      "question": "Order descending: 85%, &frac45;, 0.9",
      "steps": ["0.85, 0.8, 0.9", "Largest first: 0.9", "0.9, 85%, &frac45;"],
      "answer": "0.9, 85%, &frac45;",
      "explanation": "Convert: 85%=0.85, &frac45;=0.8, 0.9. Descending: 0.9, 0.85, 0.8."
    }
