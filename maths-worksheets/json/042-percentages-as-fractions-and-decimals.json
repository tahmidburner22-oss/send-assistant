  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Three forms of the same value",
      "content": [
        {
          "type": "paragraph",
          "text": "Every <span class=\"ul-b\">percentage</span> can be written as a <span class=\"ul-k\">fraction</span> (over 100, then simplify) or a <span class=\"ul-k\">decimal</span> (divide by 100)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Tip:</span> Learn key equivalents: &frac{1}{2} = 50% = 0.5, &frac{1}{4} = 25% = 0.25, &frac{1}{5} = 20% = 0.2, &frac{1}{10} = 10% = 0.1."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key equivalents",
      "examples": [
        {
          "correct": true,
          "expr": "50% = &frac{1}{2} = 0.5",
          "desc": "half"
        },
        {
          "correct": true,
          "expr": "20% = &frac{1}{5} = 0.2",
          "desc": "fifth"
        },
        {
          "correct": true,
          "expr": "125% = &frac{5}{4} = 1.25",
          "desc": "more than 100%"
        },
        {
          "correct": false,
          "expr": "33% = &frac{1}{3}",
          "desc": "&frac{1}{3} = 33.3...%"
        },
        {
          "correct": false,
          "expr": "0.5% = &frac{1}{2}",
          "desc": "0.5% = &frac{1}{200}"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "% to fraction: put over 100, simplify. % to decimal: divide by 100. Reverse to go back.",
      "equation": "<span class=\"ov\">45%</span> = &frac{45}{100} = &frac{9}{20} = <span class=\"ovr\">0.45</span>",
      "caption": "Percentage means per hundred"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; percentage to fraction",
      "question": "Convert 60% to a fraction in simplest form.",
      "steps": [
        "Write as &frac{60}{100}",
        "HCF of 60 and 100 is 20",
        "&frac{60}{100} = &frac{3}{5}"
      ],
      "answer": "= &frac{3}{5}",
      "explanation": "Divide numerator and denominator by the HCF."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; percentage to decimal",
      "question": "Convert 37.5% to a decimal.",
      "steps": [
        "Divide by 100",
        "37.5 &divide; 100 = 0.375",
        "= 0.375"
      ],
      "answer": "= 0.375",
      "explanation": "Move the decimal point two places left."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; fraction to percentage",
      "question": "Convert &frac{7}{20} to a percentage.",
      "steps": [
        "Divide: 7 &divide; 20 = 0.35",
        "Multiply by 100: 0.35 &times; 100 = 35",
        "= 35%"
      ],
      "answer": "= 35%",
      "explanation": "Or multiply top and bottom to get denominator 100."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; decimal to percentage",
      "question": "Convert 0.065 to a percentage.",
      "steps": [
        "Multiply by 100",
        "0.065 &times; 100 = 6.5",
        "= 6.5%"
      ],
      "answer": "= 6.5%",
      "explanation": "Move decimal point two places right."
    }
  ],
