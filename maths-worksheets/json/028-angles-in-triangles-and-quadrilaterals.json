  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Angle sums",
      "content": [
        {
          "type": "paragraph",
          "text": "The angles in a <span class=\"ul-b\">triangle</span> always add up to <span class=\"ul-k\">180&deg;</span>. The angles in a quadrilateral always add up to 360&deg;."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Types of triangle:</span> Equilateral (all 60&deg;), isosceles (two equal), scalene (all different), right-angled (one 90&deg;)."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key facts",
      "examples": [
        {
          "correct": true,
          "expr": "Triangle angles sum to 180&deg;",
          "desc": "always"
        },
        {
          "correct": true,
          "expr": "Quadrilateral angles sum to 360&deg;",
          "desc": "always"
        },
        {
          "correct": true,
          "expr": "Isosceles: two angles are equal",
          "desc": "base angles"
        },
        {
          "correct": false,
          "expr": "Triangle angles sum to 360&deg;",
          "desc": "that is a quadrilateral"
        },
        {
          "correct": false,
          "expr": "All triangles have a right angle",
          "desc": "only right-angled ones"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Triangle = 180&deg;. Quadrilateral = 360&deg;. Subtract known angles to find the missing one.",
      "equation": "<span class=\"ov\">a + b + c</span> = <span class=\"ovr\">180&deg;</span> (triangle)",
      "caption": "Sum of angles in a triangle"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; triangle missing angle",
      "question": "A triangle has angles 50&deg; and 70&deg;. Find the third angle.",
      "steps": [
        "Angles sum to 180&deg;",
        "50 + 70 = 120",
        "180 &minus; 120 = 60&deg;"
      ],
      "answer": "= 60&deg;",
      "explanation": "Always subtract the sum of known angles from 180&deg;."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; isosceles triangle",
      "question": "An isosceles triangle has a top angle of 40&deg;. Find the base angles.",
      "steps": [
        "Base angles are equal; call them x",
        "40 + x + x = 180 &rarr; 40 + 2x = 180",
        "2x = 140 &rarr; x = 70&deg;"
      ],
      "answer": "= 70&deg; each",
      "explanation": "In isosceles triangles, the two base angles are always equal."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; quadrilateral missing angle",
      "question": "A quadrilateral has angles 85&deg;, 110&deg;, 90&deg; and x. Find x.",
      "steps": [
        "Angles sum to 360&deg;",
        "85 + 110 + 90 = 285",
        "x = 360 &minus; 285 = 75&deg;"
      ],
      "answer": "x = 75&deg;",
      "explanation": "Quadrilateral angle sum is 360&deg;."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; algebraic",
      "question": "A triangle has angles x, 2x and 3x. Find x.",
      "steps": [
        "x + 2x + 3x = 180",
        "6x = 180",
        "x = 30&deg;"
      ],
      "answer": "x = 30&deg;",
      "explanation": "Form an equation and solve. Angles are 30&deg;, 60&deg;, 90&deg;."
    }
  ],
