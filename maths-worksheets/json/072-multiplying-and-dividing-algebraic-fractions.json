{
  "title": "ALGEBRAIC FRACTIONS,\n(MULTIPLYING AND DIVIDING ALGEBRAIC FRACTIONS)",
  "objective": "LO: I can multiply and divide algebraic fractions and simplify the result.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Multiplying and dividing algebraic fractions",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"ul-b\">multiply</span> algebraic fractions, multiply numerators together and denominators together. To <span class=\"ul-k\">divide</span>, flip the second fraction and multiply."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Factorise first where possible, cancel common factors, then multiply what remains."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&frac{2}{x} &times; &frac{x}{3} = &frac{2}{3}",
          "desc": "cancel x"
        },
        {
          "correct": true,
          "expr": "&frac{x}{3} &divide; &frac{x}{6} = &frac{x}{3} &times; &frac{6}{x} = 2",
          "desc": "flip and multiply"
        },
        {
          "correct": true,
          "expr": "&frac{x+1}{x} &times; &frac{x}{x+2} = &frac{x+1}{x+2}",
          "desc": "cancel x"
        },
        {
          "correct": false,
          "expr": "&frac{2}{x} &times; &frac{3}{x} = &frac{6}{x}",
          "desc": "must multiply denominators too"
        },
        {
          "correct": false,
          "expr": "&frac{a}{b} &divide; &frac{c}{d} = &frac{a}{b} &times; &frac{c}{d}",
          "desc": "must flip second fraction"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiply: top &times; top, bottom &times; bottom. Divide: flip the second fraction then multiply. Always cancel common factors.",
      "equation": "&frac{a}{b} &divide; &frac{c}{d} = &frac{a}{b} &times; <span class=\"ov\">&frac{d}{c}</span> = <span class=\"ovr\">&frac{ad}{bc}</span>",
      "caption": "KFC: Keep, Flip, Change"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; simple multiplication",
      "question": "Simplify &frac{3}{x} &times; &frac{x}{5}",
      "steps": [
        "Multiply numerators: 3 &times; x = 3x",
        "Multiply denominators: x &times; 5 = 5x",
        "Cancel x: &frac{3x}{5x} = &frac{3}{5}"
      ],
      "answer": "&frac{3}{5}",
      "explanation": "Cancel any common factors between numerator and denominator."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; division",
      "question": "Simplify &frac{4}{x} &divide; &frac{2}{x}",
      "steps": [
        "Flip second fraction: &frac{4}{x} &times; &frac{x}{2}",
        "Multiply: &frac{4x}{2x}",
        "Cancel: &frac{4x}{2x} = 2"
      ],
      "answer": "= 2",
      "explanation": "Keep the first, flip the second, then multiply."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; factorising first",
      "question": "Simplify &frac{x&sup2;+x}{x+1} &times; &frac{2}{x}",
      "steps": [
        "Factorise: x&sup2;+x = x(x+1)",
        "Rewrite: &frac{x(x+1)}{x+1} &times; &frac{2}{x}",
        "Cancel (x+1) and x: = 2"
      ],
      "answer": "= 2",
      "explanation": "Always factorise before cancelling to spot common factors."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; harder division",
      "question": "Simplify &frac{x+3}{x&minus;1} &divide; &frac{x+3}{x+2}",
      "steps": [
        "Flip: &frac{x+3}{x&minus;1} &times; &frac{x+2}{x+3}",
        "Cancel (x+3)",
        "&frac{x+2}{x&minus;1}"
      ],
      "answer": "&frac{x+2}{x&minus;1}",
      "explanation": "After flipping, cancel the common factor (x+3)."
    }
  ],
