{
  "title": "FRACTIONS, DECIMALS AND PERCENTAGES,\n(PERCENTAGE INCREASE AND DECREASE)",
  "objective": "LO: I can increase or decrease an amount by a given percentage.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Increasing and decreasing by a %",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">percentage increase</span> means adding that percentage of the original. A <span class=\"ul-k\">percentage decrease</span> means subtracting it."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Multiplier method:</span> Increase by 20% &rarr; multiply by 1.20. Decrease by 15% &rarr; multiply by 0.85."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key methods",
      "examples": [
        {
          "correct": true,
          "expr": "Increase &pound;200 by 10% = &pound;220",
          "desc": "&times; 1.10"
        },
        {
          "correct": true,
          "expr": "Decrease &pound;80 by 25% = &pound;60",
          "desc": "&times; 0.75"
        },
        {
          "correct": true,
          "expr": "Multiplier for +30% is 1.30",
          "desc": "1 + 0.30"
        },
        {
          "correct": false,
          "expr": "Increase by 20% means &times; 20",
          "desc": "should be &times; 1.20"
        },
        {
          "correct": false,
          "expr": "Decrease by 10% &rarr; &times; 0.10",
          "desc": "should be &times; 0.90"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Increase: multiply by (1 + rate). Decrease: multiply by (1 &minus; rate).",
      "equation": "New = Original &times; <span class=\"ov\">multiplier</span>; e.g. +20% &rarr; &times;<span class=\"ovr\">1.20</span>",
      "caption": "Multiplier = 1 &plusmn; percentage as decimal"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; percentage increase",
      "question": "Increase &pound;250 by 20%.",
      "steps": [
        "20% of 250 = 50",
        "250 + 50 = 300",
        "Or: 250 &times; 1.20 = &pound;300"
      ],
      "answer": "= &pound;300",
      "explanation": "Add the percentage to the original."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; percentage decrease",
      "question": "Decrease &pound;180 by 15%.",
      "steps": [
        "15% of 180 = 27",
        "180 &minus; 27 = 153",
        "Or: 180 &times; 0.85 = &pound;153"
      ],
      "answer": "= &pound;153",
      "explanation": "Subtract the percentage from the original."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; multiplier method",
      "question": "A house worth &pound;200,000 increases by 5%. Find new value.",
      "steps": [
        "Multiplier = 1 + 0.05 = 1.05",
        "200000 &times; 1.05 = 210000",
        "New value = &pound;210,000"
      ],
      "answer": "= &pound;210,000",
      "explanation": "The multiplier method does it in one step."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; sale price",
      "question": "A jacket costs &pound;85. It is reduced by 40% in a sale. Find the sale price.",
      "steps": [
        "Multiplier = 1 &minus; 0.40 = 0.60",
        "85 &times; 0.60 = 51",
        "Sale price = &pound;51"
      ],
      "answer": "= &pound;51",
      "explanation": "Multiply by 0.60 because you pay 60% of the original."
    }
  ],
