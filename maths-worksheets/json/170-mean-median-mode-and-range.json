{
  "title": "STATISTICS,\n(MEAN, MEDIAN, MODE AND RANGE)",
  "objective": "LO: I can calculate the mean, median, mode and range from a set of data.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Averages and range",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">mean</span> is the sum of values divided by the count. The <span class=\"ul-k\">median</span> is the middle value when data is ordered. The <span class=\"ul-b\">mode</span> is the most frequent value."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Range</span> = highest value minus lowest value. It measures the spread of the data."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "Mean of 2, 4, 6 = 12 &divide; 3 = 4",
          "desc": "sum &divide; count"
        },
        {
          "correct": true,
          "expr": "Median of 3, 5, 7, 9, 11 = 7",
          "desc": "middle value"
        },
        {
          "correct": true,
          "expr": "Mode of 2, 3, 3, 5, 7 = 3",
          "desc": "most frequent"
        },
        {
          "correct": false,
          "expr": "Median of 2, 4, 6, 8 = 6",
          "desc": "should be (4+6)&divide;2 = 5"
        },
        {
          "correct": false,
          "expr": "Range of 3, 7, 10, 2 = 10",
          "desc": "range = 10 - 2 = 8"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Mean = total &divide; number of values. Median = middle value (or mean of two middle values for even counts).",
      "equation": "<span class=\"ov\">Mean</span> = <span class=\"ovr\">&sum;x &divide; n</span>",
      "caption": "Sum all values and divide by how many there are"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; finding the mean",
      "question": "Find the mean of 5, 8, 3, 12, 7.",
      "steps": [
        "Sum = 5 + 8 + 3 + 12 + 7 = 35",
        "Count = 5",
        "Mean = 35 &divide; 5 = 7"
      ],
      "answer": "Mean = 7",
      "explanation": "Add all values then divide by how many there are."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; finding the median",
      "question": "Find the median of 9, 3, 7, 1, 5, 8, 2.",
      "steps": [
        "Order: 1, 2, 3, 5, 7, 8, 9",
        "7 values, middle is the 4th",
        "Median = 5"
      ],
      "answer": "Median = 5",
      "explanation": "Always put the data in order first."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; even number of values",
      "question": "Find the median of 4, 7, 10, 13.",
      "steps": [
        "Data is already ordered",
        "Two middle values: 7 and 10",
        "Median = (7 + 10) &divide; 2 = 8.5"
      ],
      "answer": "Median = 8.5",
      "explanation": "For an even count, average the two middle values."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; from a frequency table",
      "question": "Scores: 1(freq 2), 2(freq 5), 3(freq 8), 4(freq 3), 5(freq 2). Find the mean.",
      "steps": [
        "Total = 1&times;2 + 2&times;5 + 3&times;8 + 4&times;3 + 5&times;2 = 2+10+24+12+10 = 58",
        "Total freq = 2+5+8+3+2 = 20",
        "Mean = 58 &divide; 20 = 2.9"
      ],
      "answer": "Mean = 2.9",
      "explanation": "Multiply each value by its frequency, then divide by total frequency."
    }
  ],
