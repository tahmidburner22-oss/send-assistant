{
  "title": "STATISTICS,\n(MEAN, MEDIAN, MODE AND RANGE)",
  "objective": "LO: I can calculate and interpret the mean, median, mode and range for a data set.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Averages and range",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">mean</span> = total of values &divide; number of values. The <span class=\"ul-b\">median</span> = middle value when ordered. The <span class=\"ul-b\">mode</span> = most common value."
        },
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">range</span> = highest value &minus; lowest value. It measures the <span class=\"ul-k\">spread</span> of the data."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "Mean of 2, 4, 6, 8 = 20 &divide; 4 = 5",
          "desc": "sum &divide; count"
        },
        {
          "correct": true,
          "expr": "Median of 1, 3, 5, 7, 9 = 5",
          "desc": "middle value"
        },
        {
          "correct": true,
          "expr": "Mode of 2, 3, 3, 4, 5 = 3",
          "desc": "most frequent"
        },
        {
          "correct": false,
          "expr": "Median of 2, 4, 6, 8 = 6",
          "desc": "mean of 4 and 6 = 5"
        },
        {
          "correct": false,
          "expr": "Range of 3, 7, 1, 9 = 9",
          "desc": "range = 9 &minus; 1 = 8"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Mean = sum &divide; n. Median = middle value (order first). Mode = most common. Range = max &minus; min.",
      "equation": "Mean = <span class=\"ov\">&Sigma;x</span> &divide; <span class=\"ovr\">n</span>",
      "caption": "Sum of all values divided by the count"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; calculating the mean",
      "question": "Find the mean of 5, 8, 3, 12, 7.",
      "steps": [
        "Sum = 5 + 8 + 3 + 12 + 7 = 35",
        "Count = 5",
        "Mean = 35 &divide; 5 = 7"
      ],
      "answer": "Mean = 7",
      "explanation": "Add all values then divide by how many there are."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; finding the median",
      "question": "Find the median of 9, 3, 7, 1, 5, 8, 2.",
      "steps": [
        "Order: 1, 2, 3, 5, 7, 8, 9",
        "7 values, middle is the 4th",
        "Median = 5"
      ],
      "answer": "Median = 5",
      "explanation": "With an odd number of values, pick the middle one."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; even number of values",
      "question": "Find the median of 4, 7, 2, 9, 6, 8.",
      "steps": [
        "Order: 2, 4, 6, 7, 8, 9",
        "6 values: middle is between 3rd and 4th",
        "Median = (6 + 7) &divide; 2 = 6.5"
      ],
      "answer": "Median = 6.5",
      "explanation": "With an even number, average the two middle values."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; from frequency table",
      "question": "Scores: 1(f=3), 2(f=5), 3(f=7), 4(f=4), 5(f=1). Find the mean.",
      "steps": [
        "Sum = 1&times;3 + 2&times;5 + 3&times;7 + 4&times;4 + 5&times;1 = 3+10+21+16+5 = 55",
        "Total frequency = 20",
        "Mean = 55 &divide; 20 = 2.75"
      ],
      "answer": "Mean = 2.75",
      "explanation": "Multiply each value by its frequency, sum, then divide by total frequency."
    }
  ],
