    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Find the value of 1 unit first (divide), then scale up to the amount needed (multiply).",
      "equation": "For 1: <span class=\"ov\">total &divide; n</span> | For m: <span class=\"ovr\">&times; m</span>",
      "caption": "Unitary method: divide then multiply"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; scaling a recipe",
      "question": "A recipe for 6 people needs 300 g flour. How much for 10 people?",
      "steps": [
        "For 1 person: 300 &divide; 6 = 50 g",
        "For 10 people: 50 &times; 10",
        "= 500 g"
      ],
      "answer": "500 g",
      "explanation": "Find the amount per person, then multiply by the new number."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; map scales",
      "question": "A map has scale 1:25,000. Two towns are 8 cm apart on the map. Find the real distance.",
      "steps": [
        "1 cm = 25,000 cm",
        "8 cm = 8 &times; 25,000 = 200,000 cm",
        "200,000 cm = 2000 m = 2 km"
      ],
      "answer": "2 km",
      "explanation": "Multiply the map distance by the scale factor, then convert units."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; currency conversion",
      "question": "&pound;1 = &euro;1.12. Convert &pound;65 to euros.",
      "steps": [
        "&pound;1 = &euro;1.12",
        "&pound;65 = 65 &times; 1.12",
        "= &euro;72.80"
      ],
      "answer": "&euro;72.80",
      "explanation": "Multiply the amount by the exchange rate."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; best buy",
      "question": "Pack A: 500 g for &pound;1.80. Pack B: 750 g for &pound;2.55. Which is better value?",
      "steps": [
        "A: &pound;1.80 &divide; 500 = 0.36p per gram",
        "B: &pound;2.55 &divide; 750 = 0.34p per gram",
        "Pack B is cheaper per gram"
      ],
      "answer": "Pack B is better value",
      "explanation": "Compare price per unit (per gram or per ml)."
    }
  ],
