{
  "title": "DECIMALS,\n(ADDING AND SUBTRACTING DECIMALS)",
  "objective": "LO: I can add and subtract decimals using column methods, lining up the decimal points.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Adding and subtracting decimals",
      "content": [
        {
          "type": "paragraph",
          "text": "When adding or subtracting <span class=\"ul-b\">decimals</span>, line up the <span class=\"ul-k\">decimal points</span> so that digits with the same place value are in the same column."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Tip:</span> Use trailing zeros as placeholders so all numbers have the same number of decimal places."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key points",
      "examples": [
        {
          "correct": true,
          "expr": "3.5 + 2.7 = 6.2",
          "desc": "line up points"
        },
        {
          "correct": true,
          "expr": "5.0 &minus; 1.3 = 3.7",
          "desc": "use placeholder 0"
        },
        {
          "correct": true,
          "expr": "12.45 + 3.6 = 16.05",
          "desc": "3.6 = 3.60"
        },
        {
          "correct": false,
          "expr": "3.5 + 2.7 = 5.12",
          "desc": "not place value error"
        },
        {
          "correct": false,
          "expr": "1.3 + 2.45 lined up without point",
          "desc": "must align decimals"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Line up the decimal points. Fill empty places with zeros. Then add or subtract as normal.",
      "equation": "<span class=\"ov\">12.45</span> + <span class=\"ov\">3.60</span> = <span class=\"ovr\">16.05</span>",
      "caption": "Pad with zeros to match decimal places"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; adding",
      "question": "Calculate 4.3 + 2.8",
      "steps": [
        "Line up: 4.3 + 2.8",
        "3 + 8 = 11, write 1 carry 1",
        "4 + 2 + 1 = 7 &rarr; 7.1"
      ],
      "answer": "= 7.1",
      "explanation": "Carry works exactly the same as with whole numbers."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; different decimal places",
      "question": "Calculate 5.6 + 3.45",
      "steps": [
        "Write as 5.60 + 3.45",
        "0 + 5 = 5; 6 + 4 = 10, write 0 carry 1",
        "5 + 3 + 1 = 9 &rarr; 9.05"
      ],
      "answer": "= 9.05",
      "explanation": "Pad 5.6 with a zero to make 5.60."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; subtraction",
      "question": "Calculate 8.2 &minus; 3.7",
      "steps": [
        "Line up: 8.2 &minus; 3.7",
        "2 &minus; 7: borrow, 12 &minus; 7 = 5",
        "7 &minus; 3 = 4 &rarr; 4.5"
      ],
      "answer": "= 4.5",
      "explanation": "Borrow from the next column just like whole numbers."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; from a whole number",
      "question": "Calculate 10 &minus; 3.46",
      "steps": [
        "Write as 10.00 &minus; 3.46",
        "0 &minus; 6: borrow through &rarr; 10 &minus; 6 = 4",
        "Continue borrowing: 9 &minus; 4 = 5, 9 &minus; 3 = 6 &rarr; 6.54"
      ],
      "answer": "= 6.54",
      "explanation": "Write 10 as 10.00 to subtract easily."
    }
  ],
