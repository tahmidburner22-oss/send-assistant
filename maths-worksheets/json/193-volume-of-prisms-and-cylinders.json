{
  "title": "VOLUME AND SURFACE AREA,\n(VOLUME OF PRISMS AND CYLINDERS)",
  "objective": "LO: I can calculate the volume of prisms and cylinders.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Volume of prisms",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">volume</span> of a prism = <span class=\"ul-k\">cross-section area &times; length</span>. For a cylinder, V = &pi;r&sup2;h."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Units:</span> Volume is measured in cubic units (cm&sup3;, m&sup3;)."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key formulae",
      "examples": [
        {
          "correct": true,
          "expr": "Prism: V = area &times; length",
          "desc": "cross-section &times; depth"
        },
        {
          "correct": true,
          "expr": "Cylinder: V = &pi;r&sup2;h",
          "desc": "circle area &times; height"
        },
        {
          "correct": true,
          "expr": "Cuboid: V = lwh",
          "desc": "special case of prism"
        },
        {
          "correct": false,
          "expr": "V = 2&pi;rh",
          "desc": "that is curved surface area"
        },
        {
          "correct": false,
          "expr": "Cylinder V = &pi;rh",
          "desc": "must square the radius"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Volume = cross-section area &times; length (or height for vertical prisms).",
      "equation": "V = <span class=\"ov\">A</span> &times; <span class=\"ovr\">l</span>",
      "caption": "A = area of cross-section, l = length/height"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; cuboid",
      "question": "Find the volume of a cuboid 8 &times; 5 &times; 3 cm.",
      "steps": [
        "V = l &times; w &times; h",
        "= 8 &times; 5 &times; 3",
        "= 120 cm&sup3;"
      ],
      "answer": "120 cm&sup3;",
      "explanation": "Multiply length &times; width &times; height."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; cylinder",
      "question": "Find the volume of a cylinder r=4, h=10.",
      "steps": [
        "V = &pi;r&sup2;h",
        "= &pi; &times; 16 &times; 10",
        "= 160&pi; = 502.7 cm&sup3;"
      ],
      "answer": "502.7 cm&sup3;",
      "explanation": "Square the radius, then multiply by &pi; and height."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; triangular prism",
      "question": "Triangle: base 6, height 4. Prism length 10. Volume?",
      "steps": [
        "Cross-section = &frac{1}{2} &times; 6 &times; 4 = 12 cm&sup2;",
        "V = 12 &times; 10",
        "= 120 cm&sup3;"
      ],
      "answer": "120 cm&sup3;",
      "explanation": "Find the triangle area first, then multiply by length."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; finding height",
      "question": "Cylinder V=300&pi;, r=5. Find h.",
      "steps": [
        "300&pi; = &pi; &times; 25 &times; h",
        "300 = 25h",
        "h = 12 cm"
      ],
      "answer": "h = 12 cm",
      "explanation": "Rearrange: h = V/(&pi;r&sup2;)."
    }
  ],
