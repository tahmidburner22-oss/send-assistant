{
  "title": "SURDS,\n(SIMPLIFYING SURDS)",
  "objective": "LO: I can simplify surds by finding the largest square factor.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Simplifying surds",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"ul-b\">simplify a surd</span>, find the largest <span class=\"ul-k\">perfect square factor</span> of the number under the root sign and take its square root outside."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Method:</span> &radic;n = &radic;(a² &times; b) = a&radic;b. Choose the largest perfect square factor for efficiency."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&radic;12 = &radic;(4 &times; 3) = 2&radic;3",
          "desc": "4 is the square factor"
        },
        {
          "correct": true,
          "expr": "&radic;50 = &radic;(25 &times; 2) = 5&radic;2",
          "desc": "25 is the largest square factor"
        },
        {
          "correct": true,
          "expr": "&radic;72 = &radic;(36 &times; 2) = 6&radic;2",
          "desc": "36 is the largest square factor"
        },
        {
          "correct": false,
          "expr": "&radic;12 = &radic;6 &times; &radic;2",
          "desc": "not simplified; need square factors"
        },
        {
          "correct": false,
          "expr": "&radic;50 = &radic;(10 &times; 5) = &radic;10&radic;5",
          "desc": "neither factor is a perfect square"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Find the largest perfect square that divides the number. Take its root outside the radical.",
      "equation": "&radic;n = <span class=\"ov\">a</span>&radic;<span class=\"ovr\">b</span> where n = a² &times; b",
      "caption": "b should have no perfect square factors left"
    }
  },
