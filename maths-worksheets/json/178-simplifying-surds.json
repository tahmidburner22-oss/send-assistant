{
  "title": "SURDS,\n(SIMPLIFYING SURDS)",
  "objective": "LO: I can simplify surds by finding the largest square factor.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Simplifying surds",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"ul-b\">simplify a surd</span>, find the largest <span class=\"ul-k\">perfect square factor</span> of the number under the root. Use &radic;(ab) = &radic;a &times; &radic;b."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Method:</span> Find the largest square number that divides into the radicand: 4, 9, 16, 25, 36, 49, 64, 81, 100..."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&radic;12 = &radic;(4&times;3) = 2&radic;3",
          "desc": "largest square factor 4"
        },
        {
          "correct": true,
          "expr": "&radic;50 = &radic;(25&times;2) = 5&radic;2",
          "desc": "largest square factor 25"
        },
        {
          "correct": true,
          "expr": "&radic;72 = &radic;(36&times;2) = 6&radic;2",
          "desc": "largest square factor 36"
        },
        {
          "correct": false,
          "expr": "&radic;12 = &radic;6 &times; &radic;2",
          "desc": "not simplified: use &radic;4"
        },
        {
          "correct": false,
          "expr": "&radic;50 = &radic;10 &times; &radic;5",
          "desc": "need a square factor"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Find the LARGEST perfect square that divides the number, then take its root outside.",
      "equation": "&radic;n = &radic;(a&sup2; &times; b) = <span class=\"ov\">a</span><span class=\"ovr\">&radic;b</span>",
      "caption": "a&sup2; is the largest square factor of n"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; basic simplification",
      "question": "Simplify &radic;18.",
      "steps": [
        "Largest square factor of 18: 9",
        "&radic;18 = &radic;(9 &times; 2)",
        "= 3&radic;2"
      ],
      "answer": "3&radic;2",
      "explanation": "9 is the largest perfect square that divides 18."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; larger number",
      "question": "Simplify &radic;200.",
      "steps": [
        "Largest square factor: 100",
        "&radic;200 = &radic;(100 &times; 2)",
        "= 10&radic;2"
      ],
      "answer": "10&radic;2",
      "explanation": "100 divides into 200, and &radic;100 = 10."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; with coefficient",
      "question": "Simplify 3&radic;32.",
      "steps": [
        "&radic;32 = &radic;(16 &times; 2) = 4&radic;2",
        "3 &times; 4&radic;2",
        "= 12&radic;2"
      ],
      "answer": "12&radic;2",
      "explanation": "Simplify the surd first, then multiply by the coefficient."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; checking if simplified",
      "question": "Is 5&radic;6 fully simplified?",
      "steps": [
        "Check factors of 6: 1, 2, 3, 6",
        "No perfect square factors (other than 1)",
        "Yes, 5&radic;6 is fully simplified"
      ],
      "answer": "Yes, fully simplified",
      "explanation": "A surd is simplified when no perfect square divides the radicand."
    }
  ],
