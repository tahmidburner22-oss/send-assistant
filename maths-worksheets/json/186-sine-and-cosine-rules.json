{
  "title": "TRIGONOMETRY,\n(SINE AND COSINE RULES)",
  "objective": "LO: I can use the sine and cosine rules to find sides and angles in non-right-angled triangles.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Sine and cosine rules",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">sine rule</span>: a/sin A = b/sin B = c/sin C. Used when you know a side and its opposite angle. The <span class=\"ul-b\">cosine rule</span>: a&sup2; = b&sup2; + c&sup2; &minus; 2bc cos A."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">When to use:</span> Sine rule for ASA/AAS. Cosine rule for SAS (find side) or SSS (find angle)."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "When to use each",
      "examples": [
        {
          "correct": true,
          "expr": "Sine rule: know a side-angle pair",
          "desc": "a/sin A = b/sin B"
        },
        {
          "correct": true,
          "expr": "Cosine rule: know SAS or SSS",
          "desc": "a&sup2; = b&sup2; + c&sup2; &minus; 2bc cos A"
        },
        {
          "correct": true,
          "expr": "Area = &frac{1}{2}ab sin C",
          "desc": "area formula"
        },
        {
          "correct": false,
          "expr": "SOH CAH TOA works in all triangles",
          "desc": "only right-angled"
        },
        {
          "correct": false,
          "expr": "Cosine rule only finds sides",
          "desc": "can find angles too"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Sine rule: a/sin A = b/sin B. Cosine rule: a&sup2; = b&sup2; + c&sup2; &minus; 2bc cos A.",
      "equation": "<span class=\"ov\">a/sin A = b/sin B</span> | a&sup2; = b&sup2; + c&sup2; &minus; <span class=\"ovr\">2bc cos A</span>",
      "caption": "Choose based on what you know"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; sine rule - side",
      "question": "A = 40&deg;, B = 70&deg;, a = 8. Find b.",
      "steps": [
        "a/sin A = b/sin B",
        "8/sin 40&deg; = b/sin 70&deg;",
        "b = 8 sin 70&deg;/sin 40&deg; = 11.7"
      ],
      "answer": "b = 11.7",
      "explanation": "Cross-multiply to find the unknown."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; sine rule - angle",
      "question": "a = 10, b = 7, A = 50&deg;. Find B.",
      "steps": [
        "sin B/b = sin A/a",
        "sin B = 7 sin 50&deg;/10 = 0.536",
        "B = sin&minus;&sup1;(0.536) = 32.4&deg;"
      ],
      "answer": "B = 32.4&deg;",
      "explanation": "Rearrange to find sin B, then use inverse."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; cosine rule - side",
      "question": "b = 8, c = 6, A = 55&deg;. Find a.",
      "steps": [
        "a&sup2; = 64 + 36 &minus; 2(8)(6)cos 55&deg;",
        "= 100 &minus; 55.1 = 44.9",
        "a = &radic;44.9 = 6.7"
      ],
      "answer": "a = 6.7",
      "explanation": "Substitute into cosine rule and simplify."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; cosine rule - angle",
      "question": "a = 7, b = 9, c = 5. Find A.",
      "steps": [
        "cos A = (81 + 25 &minus; 49)/(2 &times; 9 &times; 5)",
        "= 57/90 = 0.633",
        "A = cos&minus;&sup1;(0.633) = 50.7&deg;"
      ],
      "answer": "A = 50.7&deg;",
      "explanation": "Rearrange cosine rule to find cos A."
    }
  ],
