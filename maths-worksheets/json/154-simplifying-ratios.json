{
  "title": "RATIO,\n(SIMPLIFYING RATIOS)",
  "objective": "LO: I can simplify ratios by finding common factors, including ratios with decimals and fractions.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Simplifying ratios",
      "content": [
        {
          "type": "paragraph",
          "text": "A ratio is in its <span class=\"ul-b\">simplest form</span> when both sides share no common factor other than 1. Divide both sides by the <span class=\"ul-k\">highest common factor (HCF)</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Tip:</span> For decimals, multiply to make whole numbers first. For fractions, find a common denominator or multiply by LCM."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "12:8 = 3:2",
          "desc": "divide both by HCF 4"
        },
        {
          "correct": true,
          "expr": "0.5:1.5 = 1:3",
          "desc": "multiply both by 2"
        },
        {
          "correct": true,
          "expr": "&frac{1}{2}:&frac{3}{4} = 2:3",
          "desc": "multiply by 4"
        },
        {
          "correct": false,
          "expr": "12:8 = 6:3",
          "desc": "6:4 then 3:2"
        },
        {
          "correct": false,
          "expr": "0.5:1 = 5:1",
          "desc": "should be 1:2"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Divide both sides by the HCF. For decimals or fractions, make whole numbers first.",
      "equation": "12:18 &divide; <span class=\"ov\">HCF(6)</span> = <span class=\"ovr\">2:3</span>",
      "caption": "Always express in simplest integer form"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; integers",
      "question": "Simplify 24:36.",
      "steps": [
        "HCF of 24 and 36 = 12",
        "24 &divide; 12 = 2",
        "36 &divide; 12 = 3"
      ],
      "answer": "2:3",
      "explanation": "Divide both numbers by their HCF."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; decimals",
      "question": "Simplify 0.6:1.5.",
      "steps": [
        "Multiply both by 10: 6:15",
        "HCF of 6 and 15 = 3",
        "6 &divide; 3 = 2, 15 &divide; 3 = 5"
      ],
      "answer": "2:5",
      "explanation": "Remove decimals first, then simplify."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; fractions",
      "question": "Simplify &frac{1}{3}:&frac{1}{2}.",
      "steps": [
        "Common denominator = 6",
        "Multiply both by 6: 2:3",
        "Already in simplest form"
      ],
      "answer": "2:3",
      "explanation": "Multiply both fractions by the LCM of denominators."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; units",
      "question": "Write 20 minutes : 1 hour as a simple ratio.",
      "steps": [
        "Convert to same units: 20 min : 60 min",
        "HCF of 20 and 60 = 20",
        "20 &divide; 20 = 1, 60 &divide; 20 = 3"
      ],
      "answer": "1:3",
      "explanation": "Always convert to the same units before simplifying."
    }
  ],
