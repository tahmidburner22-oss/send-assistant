{
  "title": "RATIO,\n(SIMPLIFYING RATIOS)",
  "objective": "LO: I can simplify ratios by dividing both sides by their highest common factor.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Simplifying ratios",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"ul-b\">simplify a ratio</span>, divide all parts by their <span class=\"ul-k\">highest common factor (HCF)</span>. A ratio is in its simplest form when the parts share no common factor other than 1."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Remember:</span> Ratios can include units. Convert to the same unit first, then simplify."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "12 : 18 = 2 : 3",
          "desc": "divide both by HCF 6"
        },
        {
          "correct": true,
          "expr": "1.5 : 2.5 = 3 : 5",
          "desc": "multiply by 2 first to remove decimals"
        },
        {
          "correct": true,
          "expr": "40 cm : 1 m = 40 : 100 = 2 : 5",
          "desc": "convert to same unit"
        },
        {
          "correct": false,
          "expr": "12 : 18 = 6 : 9",
          "desc": "not fully simplified"
        },
        {
          "correct": false,
          "expr": "40 cm : 1 m = 40 : 1",
          "desc": "units not converted"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Divide every part of the ratio by the highest common factor to simplify.",
      "equation": "<span class=\"ov\">a : b</span> = <span class=\"ovr\">&frac{a}{HCF} : &frac{b}{HCF}</span>",
      "caption": "Keep dividing until no common factor remains"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; whole numbers",
      "question": "Simplify 24 : 36",
      "steps": [
        "Find HCF of 24 and 36 = 12",
        "24 &divide; 12 = 2",
        "36 &divide; 12 = 3"
      ],
      "answer": "2 : 3",
      "explanation": "Always find the largest factor that divides both numbers."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; three-part ratio",
      "question": "Simplify 10 : 15 : 25",
      "steps": [
        "Find HCF of 10, 15, and 25 = 5",
        "Divide each: 10 &divide; 5 = 2, 15 &divide; 5 = 3, 25 &divide; 5 = 5",
        "Simplified ratio: 2 : 3 : 5"
      ],
      "answer": "2 : 3 : 5",
      "explanation": "The same method works for three-part ratios."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; decimals",
      "question": "Simplify 0.6 : 1.4",
      "steps": [
        "Multiply both by 10: 6 : 14",
        "HCF of 6 and 14 = 2",
        "6 &divide; 2 = 3, 14 &divide; 2 = 7"
      ],
      "answer": "3 : 7",
      "explanation": "Remove decimals first by multiplying by 10, 100, etc."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; different units",
      "question": "Simplify 500 g : 2 kg",
      "steps": [
        "Convert to same unit: 500 g : 2000 g",
        "HCF of 500 and 2000 = 500",
        "500 &divide; 500 = 1, 2000 &divide; 500 = 4"
      ],
      "answer": "1 : 4",
      "explanation": "Always convert to the same unit before simplifying."
    }
  ],
