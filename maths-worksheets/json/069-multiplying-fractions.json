{
  "title": "FRACTIONS ALL OPERATIONS,\n(MULTIPLYING FRACTIONS)",
  "objective": "LO: I can multiply fractions and mixed numbers by multiplying numerators and denominators.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Multiplying fractions",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"\u0001\">multiply fractions</span>, multiply the <span class=\"\u0001\">numerators</span> together and multiply the <span class=\"\u0001\">denominators</span> together. Simplify if possible."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Tip:</span> You can cross-cancel before multiplying to keep numbers small."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&frac{2}{3} &times; &frac{4}{5} = &frac{8}{15}",
          "desc": "multiply tops, multiply bottoms"
        },
        {
          "correct": true,
          "expr": "&frac{3}{4} &times; &frac{2}{9} = &frac{1}{6}",
          "desc": "cross-cancel 3 and 9"
        },
        {
          "correct": true,
          "expr": "&frac{1}{2} &times; &frac{1}{3} = &frac{1}{6}",
          "desc": "unit fractions"
        },
        {
          "correct": false,
          "expr": "&frac{2}{3} &times; &frac{4}{5} = &frac{6}{8}",
          "desc": "added instead of multiplied"
        },
        {
          "correct": false,
          "expr": "&frac{3}{4} &times; &frac{2}{9} = &frac{6}{36}",
          "desc": "correct but not simplified"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiply the numerators together and the denominators together. Simplify the result.",
      "equation": "<span class=\"\u0001\">&frac{a}{b}</span> &times; <span class=\"\u0001\">&frac{c}{d}</span> = &frac{a &times; c}{b &times; d}",
      "caption": "Top times top, bottom times bottom"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; simple multiplication",
      "question": "Calculate &frac{2}{5} &times; &frac{3}{4}",
      "steps": [
        "Multiply numerators: 2 &times; 3 = 6",
        "Multiply denominators: 5 &times; 4 = 20",
        "&frac{6}{20} = &frac{3}{10}"
      ],
      "answer": "= &frac{3}{10}",
      "explanation": "Always simplify your final answer."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; cross-cancelling",
      "question": "Calculate &frac{3}{8} &times; &frac{4}{9}",
      "steps": [
        "Cancel 3 and 9 (common factor 3): &frac{1}{8} &times; &frac{4}{3}",
        "Cancel 4 and 8 (common factor 4): &frac{1}{2} &times; &frac{1}{3}",
        "= &frac{1}{6}"
      ],
      "answer": "= &frac{1}{6}",
      "explanation": "Cross-cancelling makes the multiplication simpler."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; multiplying by a whole number",
      "question": "Calculate &frac{3}{7} &times; 5",
      "steps": [
        "Write 5 as &frac{5}{1}",
        "&frac{3}{7} &times; &frac{5}{1} = &frac{15}{7}",
        "= 2&frac{1}{7}"
      ],
      "answer": "= 2&frac{1}{7}",
      "explanation": "Write whole numbers as fractions with denominator 1."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; mixed numbers",
      "question": "Calculate 1&frac{1}{3} &times; 2&frac{1}{4}",
      "steps": [
        "Convert: &frac{4}{3} &times; &frac{9}{4}",
        "Cancel 4s: &frac{1}{3} &times; &frac{9}{1}",
        "Cancel 3 and 9: &frac{1}{1} &times; &frac{3}{1} = 3"
      ],
      "answer": "= 3",
      "explanation": "Convert to improper fractions, then cross-cancel."
    }
  ],
