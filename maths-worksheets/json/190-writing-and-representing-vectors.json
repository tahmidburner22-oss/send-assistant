{
  "title": "VECTORS,\n(WRITING AND REPRESENTING VECTORS)",
  "objective": "LO: I can write vectors in column form and represent them on a grid.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Representing vectors",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">vector</span> represents a movement with both <span class=\"ul-k\">magnitude</span> (size) and <span class=\"ul-k\">direction</span>. Written as a column vector (x, y) or using letters like <strong>a</strong> or AB with an arrow."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">On a grid:</span> The top number is horizontal movement (+ right, &minus; left). The bottom is vertical (+ up, &minus; down)."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "Right 3, up 4 = (3, 4)",
          "desc": "positive both"
        },
        {
          "correct": true,
          "expr": "Left 2, down 5 = (&minus;2, &minus;5)",
          "desc": "negative both"
        },
        {
          "correct": true,
          "expr": "|a| = &radic;(x&sup2; + y&sup2;)",
          "desc": "magnitude formula"
        },
        {
          "correct": false,
          "expr": "Left 3 = (3, 0)",
          "desc": "left is negative: (&minus;3, 0)"
        },
        {
          "correct": false,
          "expr": "Vectors must start at the origin",
          "desc": "can start anywhere"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Column vector (x, y): x = horizontal, y = vertical. Magnitude = &radic;(x&sup2; + y&sup2;).",
      "equation": "|<span class=\"ov\">(x, y)</span>| = <span class=\"ovr\">&radic;(x&sup2; + y&sup2;)</span>",
      "caption": "Use Pythagoras to find the magnitude"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; writing from grid",
      "question": "A point moves right 4 and up 3. Write as a column vector.",
      "steps": [
        "Horizontal: +4 (right)",
        "Vertical: +3 (up)",
        "Vector = (4, 3)"
      ],
      "answer": "(4, 3)",
      "explanation": "Right and up are positive."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; negative components",
      "question": "A point moves left 2 and down 6. Write as a column vector.",
      "steps": [
        "Horizontal: &minus;2 (left)",
        "Vertical: &minus;6 (down)",
        "Vector = (&minus;2, &minus;6)"
      ],
      "answer": "(&minus;2, &minus;6)",
      "explanation": "Left and down are negative."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; finding magnitude",
      "question": "Find the magnitude of (3, 4).",
      "steps": [
        "|a| = &radic;(3&sup2; + 4&sup2;)",
        "= &radic;(9 + 16)",
        "= &radic;25 = 5"
      ],
      "answer": "|a| = 5",
      "explanation": "Use Pythagoras: &radic;(x&sup2; + y&sup2;)."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; from coordinates",
      "question": "A = (1, 2), B = (5, 5). Find vector AB.",
      "steps": [
        "AB = B &minus; A",
        "= (5&minus;1, 5&minus;2)",
        "= (4, 3)"
      ],
      "answer": "AB = (4, 3)",
      "explanation": "Subtract start from end."
    }
  ],
