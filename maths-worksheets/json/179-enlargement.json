{
  "title": "TRANSFORMATIONS,\n(ENLARGEMENT)",
  "objective": "LO: I can enlarge a shape by a given scale factor from a centre of enlargement.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Enlargement",
      "content": [
        {
          "type": "paragraph",
          "text": "An <span class=\"ul-b\">enlargement</span> changes the size of a shape using a <span class=\"ul-k\">scale factor</span> and a <span class=\"ul-k\">centre of enlargement</span>. Multiply each distance from the centre by the scale factor."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Note:</span> SF > 1 makes bigger. 0 < SF < 1 makes smaller. Negative SF gives enlargement on the other side."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "SF 2 from centre: all distances doubled",
          "desc": "basic enlargement"
        },
        {
          "correct": true,
          "expr": "SF &frac{1}{2}: shape becomes half the size",
          "desc": "fractional SF"
        },
        {
          "correct": true,
          "expr": "SF &minus;1: same size, rotated 180&deg;",
          "desc": "negative SF"
        },
        {
          "correct": false,
          "expr": "Enlargement only makes shapes bigger",
          "desc": "fractional SF makes smaller"
        },
        {
          "correct": false,
          "expr": "SF 3 means add 3 to coordinates",
          "desc": "multiply distances, not add"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "New distance from centre = original distance &times; scale factor. Count from centre to each vertex.",
      "equation": "New position = Centre + SF &times; <span class=\"ov\">(Point &minus; Centre)</span>",
      "caption": "Multiply the vector from centre to point by SF"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; SF 2 from origin",
      "question": "Enlarge triangle with vertices (1,1), (3,1), (1,3) by SF 2, centre (0,0).",
      "steps": [
        "Multiply each coordinate by 2",
        "(1,1)&rarr;(2,2), (3,1)&rarr;(6,2), (1,3)&rarr;(2,6)",
        "New triangle: (2,2), (6,2), (2,6)"
      ],
      "answer": "(2,2), (6,2), (2,6)",
      "explanation": "When centre is origin, just multiply all coordinates by SF."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; SF 3 from a point",
      "question": "Enlarge point (2,1) by SF 3, centre (1,0).",
      "steps": [
        "Vector from centre to point: (2&minus;1, 1&minus;0) = (1, 1)",
        "Multiply by 3: (3, 3)",
        "New position: (1+3, 0+3) = (4, 3)"
      ],
      "answer": "(4, 3)",
      "explanation": "Find vector from centre, multiply by SF, add back to centre."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; fractional SF",
      "question": "Enlarge point (6,4) by SF &frac{1}{2}, centre (0,0).",
      "steps": [
        "Multiply coordinates by &frac{1}{2}",
        "(6 &times; &frac{1}{2}, 4 &times; &frac{1}{2})",
        "= (3, 2)"
      ],
      "answer": "(3, 2)",
      "explanation": "A scale factor less than 1 reduces the shape."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; finding the SF",
      "question": "A shape has vertex at (2,3). After enlargement from (0,0) it moves to (6,9). Find SF.",
      "steps": [
        "SF = new distance / original distance",
        "6/2 = 3 or 9/3 = 3",
        "Scale factor = 3"
      ],
      "answer": "SF = 3",
      "explanation": "Divide the new coordinate by the original."
    }
  ],
