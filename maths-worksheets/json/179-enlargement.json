{
  "title": "TRANSFORMATIONS,\n(ENLARGEMENT)",
  "objective": "LO: I can enlarge a shape by a given scale factor from a centre of enlargement.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Enlargement",
      "content": [
        {
          "type": "paragraph",
          "text": "An <span class=\"ul-b\">enlargement</span> changes the size of a shape by a <span class=\"ul-k\">scale factor</span> from a fixed point called the centre of enlargement."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Key fact:</span> Scale factor > 1 makes the shape bigger. Scale factor between 0 and 1 makes it smaller. Negative scale factor also inverts the image."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "SF 2 from centre: all distances from centre doubled",
          "desc": "shape is twice as big"
        },
        {
          "correct": true,
          "expr": "SF &frac{1}{2}: image is half the size",
          "desc": "reduction"
        },
        {
          "correct": true,
          "expr": "SF -1: image inverted through the centre",
          "desc": "rotated 180°"
        },
        {
          "correct": false,
          "expr": "Enlargement changes angles",
          "desc": "angles stay the same"
        },
        {
          "correct": false,
          "expr": "SF 3 triples the area",
          "desc": "area scales by SF² = 9"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiply the distance from the centre to each vertex by the scale factor to find the image vertices.",
      "equation": "<span class=\"ov\">image distance</span> = <span class=\"ovr\">SF &times; object distance</span> from centre",
      "caption": "Measure distances from the centre of enlargement"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; scale factor 2 from origin",
      "question": "Enlarge triangle (1,1), (3,1), (1,3) by SF 2 from (0,0).",
      "steps": [
        "Multiply each coordinate by 2",
        "(1,1)&rarr;(2,2), (3,1)&rarr;(6,2), (1,3)&rarr;(2,6)",
        "Image is twice the size"
      ],
      "answer": "(2,2), (6,2), (2,6)",
      "explanation": "From the origin, just multiply all coordinates by the SF."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; scale factor 3 from a point",
      "question": "Enlarge point (2,1) by SF 3 from centre (1,0).",
      "steps": [
        "Vector from centre to point: (2-1, 1-0) = (1, 1)",
        "Multiply by 3: (3, 3)",
        "Image = centre + (3,3) = (4, 3)"
      ],
      "answer": "(4, 3)",
      "explanation": "Find the vector from centre to point, multiply by SF, add back to centre."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; fractional scale factor",
      "question": "Enlarge (6,4) by SF &frac{1}{2} from centre (0,0).",
      "steps": [
        "Multiply each coordinate by &frac{1}{2}",
        "(6 &times; &frac{1}{2}, 4 &times; &frac{1}{2})",
        "= (3, 2)"
      ],
      "answer": "(3, 2)",
      "explanation": "Fractional scale factors reduce the shape."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; negative scale factor",
      "question": "Enlarge (3,1) by SF -2 from centre (1,1).",
      "steps": [
        "Vector from centre: (3-1, 1-1) = (2, 0)",
        "Multiply by -2: (-4, 0)",
        "Image = (1,1) + (-4,0) = (-3, 1)"
      ],
      "answer": "(-3, 1)",
      "explanation": "Negative SF puts the image on the opposite side of the centre."
    }
  ],
