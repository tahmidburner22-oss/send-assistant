{
  "title": "FRACTIONS ALL OPERATIONS,\n(DIVIDING FRACTIONS)",
  "objective": "LO: I can divide fractions by flipping the second fraction and multiplying.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Dividing fractions",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"\u0001\">divide</span> by a fraction, we <span class=\"\u0001\">keep, change, flip</span>: keep the first fraction, change division to multiplication, and flip (find the reciprocal of) the second fraction."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Remember:</span> The reciprocal of &frac{a}{b} is &frac{b}{a}. Dividing by a fraction makes the answer bigger."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&frac{2}{3} &divide; &frac{1}{4} = &frac{8}{3}",
          "desc": "flip and multiply"
        },
        {
          "correct": true,
          "expr": "&frac{3}{5} &divide; &frac{2}{7} = &frac{21}{10}",
          "desc": "keep, change, flip"
        },
        {
          "correct": true,
          "expr": "&frac{1}{2} &divide; 3 = &frac{1}{6}",
          "desc": "3 = &frac{3}{1}, flip to &frac{1}{3}"
        },
        {
          "correct": false,
          "expr": "&frac{2}{3} &divide; &frac{1}{4} = &frac{2}{12}",
          "desc": "multiplied without flipping"
        },
        {
          "correct": false,
          "expr": "&frac{3}{5} &divide; &frac{2}{7} = &frac{6}{35}",
          "desc": "did not flip second fraction"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Keep the first fraction, change the operation to multiplication, flip the second fraction.",
      "equation": "<span class=\"\u0001\">&frac{a}{b}</span> &divide; <span class=\"\u0001\">&frac{c}{d}</span> = &frac{a}{b} &times; &frac{d}{c}",
      "caption": "Keep, Change, Flip"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; simple division",
      "question": "Calculate &frac{2}{3} &divide; &frac{1}{4}",
      "steps": [
        "Keep &frac{2}{3}, change to &times;, flip &frac{1}{4} to &frac{4}{1}",
        "&frac{2}{3} &times; &frac{4}{1} = &frac{8}{3}",
        "= 2&frac{2}{3}"
      ],
      "answer": "= 2&frac{2}{3}",
      "explanation": "Flip the second fraction then multiply across."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; both non-unit",
      "question": "Calculate &frac{3}{5} &divide; &frac{2}{7}",
      "steps": [
        "Keep &frac{3}{5}, change to &times;, flip &frac{2}{7} to &frac{7}{2}",
        "&frac{3}{5} &times; &frac{7}{2} = &frac{21}{10}",
        "= 2&frac{1}{10}"
      ],
      "answer": "= 2&frac{1}{10}",
      "explanation": "Multiply numerators and denominators separately."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; dividing by a whole number",
      "question": "Calculate &frac{4}{5} &divide; 2",
      "steps": [
        "Write 2 as &frac{2}{1}",
        "Keep &frac{4}{5}, change to &times;, flip to &frac{1}{2}",
        "&frac{4}{5} &times; &frac{1}{2} = &frac{4}{10} = &frac{2}{5}"
      ],
      "answer": "= &frac{2}{5}",
      "explanation": "A whole number is just a fraction with denominator 1."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; mixed numbers",
      "question": "Calculate 1&frac{1}{2} &divide; &frac{3}{4}",
      "steps": [
        "Convert: &frac{3}{2} &divide; &frac{3}{4}",
        "Keep &frac{3}{2}, change to &times;, flip to &frac{4}{3}",
        "&frac{3}{2} &times; &frac{4}{3} = &frac{12}{6} = 2"
      ],
      "answer": "= 2",
      "explanation": "Convert mixed numbers to improper fractions first."
    }
  ],
