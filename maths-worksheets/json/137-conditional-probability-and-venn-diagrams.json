{
  "title": "PROBABILITY,\n(CONDITIONAL PROBABILITY AND VENN DIAGRAMS)",
  "objective": "LO: I can use Venn diagrams to find probabilities including conditional probability.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Conditional probability",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Conditional probability</span> is the probability of an event given that another event has already occurred. <span class=\"\u0001\">Venn diagrams</span> help us visualise overlapping groups."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Notation:</span> P(A|B) means the probability of A given B. P(A|B) = P(A and B) &divide; P(B)."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "P(A|B) = P(A&cap;B) &divide; P(B)",
          "desc": "conditional formula"
        },
        {
          "correct": true,
          "expr": "A Venn diagram shows overlapping sets",
          "desc": "intersection"
        },
        {
          "correct": true,
          "expr": "P(A&cup;B) = P(A) + P(B) - P(A&cap;B)",
          "desc": "addition rule"
        },
        {
          "correct": false,
          "expr": "P(A|B) = P(A) always",
          "desc": "only if independent"
        },
        {
          "correct": false,
          "expr": "P(A&cup;B) = P(A) + P(B)",
          "desc": "must subtract overlap"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "In a Venn diagram, the overlap shows items in BOTH sets. Conditional probability restricts to a subset.",
      "equation": "P(A|B) = <span class=\"\u0001\">&frac{n(A&cap;B)}{n(B)}</span>",
      "caption": "<span class=\"\u0001\">Given B</span>, only look at members of B"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; reading a Venn diagram",
      "question": "In a class of 30: 18 like football, 12 like tennis, 5 like both. Find P(football only).",
      "steps": [
        "Football only = 18 - 5 = 13",
        "Total = 30",
        "P(football only) = &frac{13}{30}"
      ],
      "answer": "= &frac{13}{30}",
      "explanation": "Subtract the overlap to find the football-only region."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; conditional probability",
      "question": "Using the same data: find P(tennis | likes football).",
      "steps": [
        "Given they like football: 18 students",
        "Of these, 5 also like tennis",
        "P(tennis|football) = &frac{5}{18}"
      ],
      "answer": "= &frac{5}{18}",
      "explanation": "Restrict to the football group, then find those who also like tennis."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; finding the total",
      "question": "A Venn diagram shows: A only = 8, B only = 12, A&cap;B = 4, neither = 6. Find P(A&cup;B).",
      "steps": [
        "Total = 8 + 12 + 4 + 6 = 30",
        "A&cup;B = 8 + 4 + 12 = 24",
        "P(A&cup;B) = &frac{24}{30} = &frac{4}{5}"
      ],
      "answer": "= &frac{4}{5}",
      "explanation": "A union B includes everything inside at least one circle."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; completing a Venn diagram",
      "question": "60 students: 35 study French, 25 study Spanish, 10 study both. How many study neither?",
      "steps": [
        "French only = 35 - 10 = 25, Spanish only = 25 - 10 = 15",
        "Total in circles = 25 + 10 + 15 = 50",
        "Neither = 60 - 50 = 10"
      ],
      "answer": "= 10 students",
      "explanation": "Add all regions and subtract from total."
    }
  ],
