{
  "title": "PYTHAGORAS,\n(FINDING THE HYPOTENUSE)",
  "objective": "LO: I can use Pythagoras' theorem to find the hypotenuse of a right-angled triangle.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Finding the hypotenuse",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">hypotenuse</span> is the longest side of a right-angled triangle, opposite the right angle. Use <span class=\"ul-k\">c&sup2; = a&sup2; + b&sup2;</span> then square root."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Square both shorter sides, add them together, then take the square root to find c."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "a = 3, b = 4: c = &radic;(9 + 16) = &radic;25 = 5",
          "desc": "3-4-5 triple"
        },
        {
          "correct": true,
          "expr": "a = 5, b = 12: c = &radic;(25 + 144) = &radic;169 = 13",
          "desc": "5-12-13 triple"
        },
        {
          "correct": true,
          "expr": "a = 6, b = 8: c = &radic;(36 + 64) = &radic;100 = 10",
          "desc": "6-8-10 triple"
        },
        {
          "correct": false,
          "expr": "c = a + b = 3 + 4 = 7",
          "desc": "must square, add, then root"
        },
        {
          "correct": false,
          "expr": "c = &radic;(a + b) = &radic;7",
          "desc": "must square a and b first"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Square both shorter sides, add them, then square root to find the hypotenuse.",
      "equation": "c = &radic;(<span class=\"ov\">a&sup2;</span> + <span class=\"ovr\">b&sup2;</span>)",
      "caption": "Hypotenuse = &radic;(sum of squares of shorter sides)"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; Pythagorean triple",
      "question": "Find the hypotenuse when a = 6 and b = 8.",
      "steps": [
        "c&sup2; = 6&sup2; + 8&sup2; = 36 + 64 = 100",
        "c = &radic;100",
        "c = 10"
      ],
      "answer": "c = 10",
      "explanation": "6, 8, 10 is a Pythagorean triple (multiple of 3, 4, 5)."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; non-integer answer",
      "question": "Find the hypotenuse when a = 5 and b = 7.",
      "steps": [
        "c&sup2; = 5&sup2; + 7&sup2; = 25 + 49 = 74",
        "c = &radic;74",
        "c = 8.60 (2 d.p.)"
      ],
      "answer": "c = 8.60",
      "explanation": "Leave as &radic;74 for exact form, or round for decimal."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; in context",
      "question": "A field has sides 40 m and 30 m at right angles. Find the diagonal.",
      "steps": [
        "c&sup2; = 40&sup2; + 30&sup2; = 1600 + 900 = 2500",
        "c = &radic;2500",
        "c = 50 m"
      ],
      "answer": "50 m",
      "explanation": "The diagonal of a right-angled arrangement is the hypotenuse."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; with decimals",
      "question": "Find the hypotenuse when a = 2.5 and b = 6.",
      "steps": [
        "c&sup2; = 2.5&sup2; + 6&sup2; = 6.25 + 36 = 42.25",
        "c = &radic;42.25",
        "c = 6.5"
      ],
      "answer": "c = 6.5",
      "explanation": "Decimal inputs follow the same process: square, add, root."
    }
  ],
