{
  "title": "ANGLES AND GEOMETRY,\n(ANGLES IN PARALLEL LINES)",
  "objective": "LO: I can identify and calculate alternate, corresponding and co-interior angles in parallel lines.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Angle relationships in parallel lines",
      "content": [
        {
          "type": "paragraph",
          "text": "When a <span class=\"ul-b\">transversal</span> crosses two <span class=\"ul-k\">parallel lines</span>, special angle pairs are formed: alternate, corresponding, and co-interior angles."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Remember:</span> Alternate angles are equal (Z-shape). Corresponding angles are equal (F-shape). Co-interior angles add up to 180&deg;."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Angle facts",
      "examples": [
        {
          "correct": true,
          "expr": "Alternate angles are equal",
          "desc": "Z-angles"
        },
        {
          "correct": true,
          "expr": "Corresponding angles are equal",
          "desc": "F-angles"
        },
        {
          "correct": true,
          "expr": "Co-interior angles sum to 180&deg;",
          "desc": "C/U-angles"
        },
        {
          "correct": false,
          "expr": "Co-interior angles are equal",
          "desc": "they sum to 180&deg;"
        },
        {
          "correct": false,
          "expr": "Alternate angles add to 180&deg;",
          "desc": "they are equal"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Look for the Z, F, or C/U shape to identify the angle relationship. Then use equal or sum to 180&deg;.",
      "equation": "<span class=\"ov\">Alternate</span> = equal; <span class=\"ovr\">Co-interior</span> = 180&deg;",
      "caption": "Z = equal, F = equal, C = 180&deg;"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; alternate angles",
      "question": "Two parallel lines are cut by a transversal. One angle is 65&deg;. Find the alternate angle.",
      "steps": [
        "Identify the Z-shape",
        "Alternate angles are equal",
        "The angle = 65&deg;"
      ],
      "answer": "= 65&deg;",
      "explanation": "Alternate angles are always equal when lines are parallel."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; corresponding angles",
      "question": "A transversal crosses parallel lines. One angle is 110&deg;. Find the corresponding angle.",
      "steps": [
        "Identify the F-shape",
        "Corresponding angles are equal",
        "The angle = 110&deg;"
      ],
      "answer": "= 110&deg;",
      "explanation": "Corresponding angles are in the same position at each intersection."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; co-interior angles",
      "question": "Two parallel lines are cut by a transversal. One co-interior angle is 72&deg;. Find the other.",
      "steps": [
        "Co-interior angles sum to 180&deg;",
        "180 &minus; 72 = 108",
        "The other angle = 108&deg;"
      ],
      "answer": "= 108&deg;",
      "explanation": "Co-interior (allied) angles always add up to 180&deg;."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; finding unknown",
      "question": "In parallel lines, angle x and 3x are co-interior. Find x.",
      "steps": [
        "Co-interior angles sum to 180&deg;",
        "x + 3x = 180 &rarr; 4x = 180",
        "x = 45&deg;"
      ],
      "answer": "x = 45&deg;",
      "explanation": "Form an equation using the angle fact, then solve."
    }
  ],
