{
  "title": "FRACTIONS (SECONDARY),\n(ALGEBRAIC FRACTIONS)",
  "objective": "LO: I can simplify, add, subtract, multiply and divide algebraic fractions.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What are algebraic fractions?",
      "content": [
        {
          "type": "paragraph",
          "text": "An <span class=\"ul-b\">algebraic fraction</span> has <span class=\"ul-k\">expressions with letters</span> in the numerator, denominator, or both (e.g. &frac{x+2}{3} or &frac{2x}{x&minus;1})."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Same rules:</span> All fraction rules still apply. To add/subtract, find common denominator. To simplify, cancel common factors."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Key operations",
      "examples": [
        {
          "correct": true,
          "expr": "&frac{6x}{3} = 2x",
          "desc": "simplify by cancelling"
        },
        {
          "correct": true,
          "expr": "&frac{x}{3} + &frac{x}{4} = &frac{7x}{12}",
          "desc": "common denominator 12"
        },
        {
          "correct": true,
          "expr": "&frac{x+2}{x+2} = 1",
          "desc": "cancel identical factors"
        },
        {
          "correct": false,
          "expr": "&frac{x+2}{x} = 2",
          "desc": "cannot cancel part of a sum"
        },
        {
          "correct": false,
          "expr": "&frac{x}{3} + &frac{x}{4} = &frac{2x}{7}",
          "desc": "cannot add denominators"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Treat algebraic fractions like number fractions. Factorise first, then cancel common factors.",
      "equation": "<span class=\"ov\">&frac{2x + 4}{2}</span> = &frac{2(x + 2)}{2} = <span class=\"ovr\">x + 2</span>",
      "caption": "Factorise numerator, then cancel"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; simplifying",
      "question": "Simplify &frac{8x}{4}",
      "steps": [
        "Divide numerator and denominator by 4",
        "8x &divide; 4 = 2x; 4 &divide; 4 = 1",
        "= 2x"
      ],
      "answer": "= 2x",
      "explanation": "Cancel the common factor of 4."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; adding",
      "question": "Simplify &frac{x}{3} + &frac{x}{4}",
      "steps": [
        "Common denominator = 12",
        "&frac{4x}{12} + &frac{3x}{12}",
        "= &frac{7x}{12}"
      ],
      "answer": "= &frac{7x}{12}",
      "explanation": "Multiply each fraction to get denominator 12."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; subtracting",
      "question": "Simplify &frac{2x}{5} &minus; &frac{x}{3}",
      "steps": [
        "Common denominator = 15",
        "&frac{6x}{15} &minus; &frac{5x}{15}",
        "= &frac{x}{15}"
      ],
      "answer": "= &frac{x}{15}",
      "explanation": "Multiply tops and bottoms to get a common denominator."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; factorising to simplify",
      "question": "Simplify &frac{x&sup2; + 3x}{x}",
      "steps": [
        "Factorise numerator: x(x + 3)",
        "&frac{x(x + 3)}{x}",
        "Cancel x: = x + 3"
      ],
      "answer": "= x + 3",
      "explanation": "Factorise first, then cancel the common factor."
    }
  ],
