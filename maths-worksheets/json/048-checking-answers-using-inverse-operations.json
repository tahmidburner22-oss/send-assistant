{
  "title": "NUMBER OPERATIONS,\n(CHECKING ANSWERS USING INVERSE OPERATIONS)",
  "objective": "LO: I can use inverse operations to check calculations and verify my answers.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What are inverse operations?",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Inverse operations</span> are operations that <span class=\"ul-k\">undo</span> each other. Addition undoes subtraction. Multiplication undoes division."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Checking:</span> After solving a calculation, use the inverse to check. If 45 + 32 = 77, then 77 &minus; 32 should = 45."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Inverse pairs",
      "examples": [
        {
          "correct": true,
          "expr": "+ and &minus; are inverses",
          "desc": "undo each other"
        },
        {
          "correct": true,
          "expr": "&times; and &divide; are inverses",
          "desc": "undo each other"
        },
        {
          "correct": true,
          "expr": "If 7 &times; 8 = 56, then 56 &divide; 8 = 7",
          "desc": "check"
        },
        {
          "correct": false,
          "expr": "+ and &times; are inverses",
          "desc": "wrong pairing"
        },
        {
          "correct": false,
          "expr": "Inverse of squaring is halving",
          "desc": "it is square-rooting"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Use the inverse operation on your answer to get back to the starting number. If you do, your answer is correct.",
      "equation": "<span class=\"ov\">45 + 32 = 77</span> &harr; check: <span class=\"ovr\">77 &minus; 32 = 45</span> &check;",
      "caption": "Inverse undoes the operation"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; checking addition",
      "question": "Check: 156 + 89 = 245",
      "steps": [
        "Use inverse: 245 &minus; 89",
        "245 &minus; 89 = 156",
        "156 matches &rarr; correct &check;"
      ],
      "answer": "Correct &check;",
      "explanation": "Subtract one addend from the sum; you should get the other."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; checking multiplication",
      "question": "Check: 23 &times; 15 = 345",
      "steps": [
        "Use inverse: 345 &divide; 15",
        "345 &divide; 15 = 23",
        "23 matches &rarr; correct &check;"
      ],
      "answer": "Correct &check;",
      "explanation": "Divide the product by one factor; you should get the other."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; finding an error",
      "question": "Check: 64 &divide; 8 = 9",
      "steps": [
        "Use inverse: 9 &times; 8 = 72",
        "72 &ne; 64",
        "The answer should be 8, not 9"
      ],
      "answer": "Incorrect &cross;",
      "explanation": "The inverse check reveals the error: 64 &divide; 8 = 8."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; checking subtraction",
      "question": "Check: 500 &minus; 237 = 263",
      "steps": [
        "Use inverse: 263 + 237",
        "263 + 237 = 500",
        "500 matches &rarr; correct &check;"
      ],
      "answer": "Correct &check;",
      "explanation": "Add the result to the subtracted number; you should get the original."
    }
  ],
