  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Adding and subtracting fractions",
      "content": [
        {
          "type": "paragraph",
          "text": "To add or subtract fractions with <span class=\"\u0001\">different denominators</span>, we must first find a <span class=\"\u0001\">common denominator</span> so that both fractions have the same-sized parts."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Remember:</span> Find the lowest common multiple (LCM) of the denominators, convert both fractions, then add or subtract the numerators."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&frac{1}{3} + &frac{1}{4} = &frac{7}{12}",
          "desc": "LCM of 3 and 4 is 12"
        },
        {
          "correct": true,
          "expr": "&frac{3}{5} - &frac{1}{3} = &frac{4}{15}",
          "desc": "LCM of 5 and 3 is 15"
        },
        {
          "correct": true,
          "expr": "&frac{2}{3} + &frac{1}{6} = &frac{5}{6}",
          "desc": "LCM of 3 and 6 is 6"
        },
        {
          "correct": false,
          "expr": "&frac{1}{3} + &frac{1}{4} = &frac{2}{7}",
          "desc": "cannot add numerators and denominators"
        },
        {
          "correct": false,
          "expr": "&frac{3}{5} - &frac{1}{3} = &frac{2}{2}",
          "desc": "subtracted both top and bottom"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Find the LCM of the denominators, convert each fraction to equivalent fractions, then add or subtract numerators.",
      "equation": "<span class=\"\u0001\">&frac{a}{b}</span> + <span class=\"\u0001\">&frac{c}{d}</span> = &frac{ad + bc}{bd}",
      "caption": "Cross-multiply to find equivalent numerators"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; adding unit fractions",
      "question": "Calculate &frac{1}{3} + &frac{1}{4}",
      "steps": [
        "LCM of 3 and 4 = 12",
        "&frac{1}{3} = &frac{4}{12} and &frac{1}{4} = &frac{3}{12}",
        "&frac{4}{12} + &frac{3}{12} = &frac{7}{12}"
      ],
      "answer": "= &frac{7}{12}",
      "explanation": "Convert both fractions to twelfths, then add numerators."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; subtracting fractions",
      "question": "Calculate &frac{3}{4} - &frac{2}{5}",
      "steps": [
        "LCM of 4 and 5 = 20",
        "&frac{3}{4} = &frac{15}{20} and &frac{2}{5} = &frac{8}{20}",
        "&frac{15}{20} - &frac{8}{20} = &frac{7}{20}"
      ],
      "answer": "= &frac{7}{20}",
      "explanation": "Same process: find common denominator, then subtract."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; adding with simplifying",
      "question": "Calculate &frac{2}{3} + &frac{1}{6}",
      "steps": [
        "LCM of 3 and 6 = 6",
        "&frac{2}{3} = &frac{4}{6}",
        "&frac{4}{6} + &frac{1}{6} = &frac{5}{6}"
      ],
      "answer": "= &frac{5}{6}",
      "explanation": "When one denominator is a factor of the other, only convert one fraction."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; mixed numbers",
      "question": "Calculate 1&frac{1}{3} + 2&frac{1}{4}",
      "steps": [
        "Convert: &frac{4}{3} + &frac{9}{4}",
        "LCM = 12: &frac{16}{12} + &frac{27}{12}",
        "= &frac{43}{12} = 3&frac{7}{12}"
      ],
      "answer": "= 3&frac{7}{12}",
      "explanation": "Convert mixed numbers to improper fractions first."
    }
  ],
