      "title": "What is a formula?",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">formula</span> is a mathematical rule written with <span class=\"ul-k\">letters and numbers</span> that shows the relationship between quantities."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Remember:</span> The subject of a formula is the single letter on its own, usually on the left side of the equals sign."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "P = 2l + 2w",
          "desc": "perimeter of a rectangle"
        },
        {
          "correct": true,
          "expr": "A = l &times; w",
          "desc": "area of a rectangle"
        },
        {
          "correct": true,
          "expr": "C = 5n + 10",
          "desc": "cost formula"
        },
        {
          "correct": false,
