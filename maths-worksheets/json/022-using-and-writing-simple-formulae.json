  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; using a formula",
      "question": "Use P = 2l + 2w to find the perimeter when l = 8 and w = 5.",
      "steps": [
        "Substitute: P = 2 &times; 8 + 2 &times; 5",
        "Calculate: P = 16 + 10",
        "P = 26"
      ],
      "answer": "P = 26 cm",
      "explanation": "Replace each letter with its value, then follow BIDMAS."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; writing a formula",
      "question": "A taxi charges &pound;3 fixed plus &pound;2 per mile. Write a formula for cost C for m miles.",
      "steps": [
        "Fixed charge = 3",
        "Cost per mile = 2m",
        "Combine: C = 2m + 3"
      ],
      "answer": "C = 2m + 3",
      "explanation": "Identify the fixed part and the variable part."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; evaluating",
      "question": "If C = 2m + 3, find C when m = 7.",
      "steps": [
        "Substitute m = 7: C = 2 &times; 7 + 3",
        "C = 14 + 3",
        "C = 17"
      ],
      "answer": "C = &pound;17",
      "explanation": "Multiply before adding (BIDMAS)."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; two-variable formula",
      "question": "The area of a triangle is A = &frac{1}{2} &times; b &times; h. Find A when b = 10 and h = 6.",
      "steps": [
        "Substitute: A = &frac{1}{2} &times; 10 &times; 6",
        "A = &frac{1}{2} &times; 60",
        "A = 30"
      ],
      "answer": "A = 30 cm&sup2;",
      "explanation": "Multiply base by height first, then halve."
    }
  ],
