      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; single multiplication",
      "question": "Calculate 6 &times; 5",
      "steps": [
        "6 groups of 5",
        "5 + 5 + 5 + 5  ...",
        "= 30"
      ],
      "answer": "= 30",
      "explanation": "Skip-count in 5s 6 times to reach 30."
    },
