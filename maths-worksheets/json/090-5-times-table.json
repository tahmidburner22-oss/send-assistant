      "steps": [
        "How many 5s in 20?",
        "Count up: 5, 10, 15, ...",
        "= 4"
      ],
      "answer": "= 4",
      "explanation": "Divide: 20 &divide; 5 = 4."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; division by sharing",
      "question": "Calculate 35 &divide; 5",
      "steps": [
        "How many groups of 5 fit in 35?",
        "5 &times; ___ = 35",
        "= 7"
      ],
      "answer": "= 7",
      "explanation": "Division is the inverse of multiplication."
    },
