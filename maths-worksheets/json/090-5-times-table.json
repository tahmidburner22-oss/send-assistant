{
  "title": "MULTIPLICATION,\n(FIVE TIMES TABLE)",
  "objective": "LO: I can recall and use the 5 times table to multiply and divide.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What is the 5 times table?",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">5 times table</span> is a list of <span class=\"ul-k\">multiples</span> of 5: numbers we get when we count in 5s. Numbers in the 5 times table always end in 0 or 5."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Skip-count in 5s on your fingers, or use a number line. Each jump adds 5."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Multiples of 5",
      "examples": [
        {
          "correct": true,
          "expr": "1 &times; 5 = 5",
          "desc": "starting point"
        },
        {
          "correct": true,
          "expr": "2 &times; 5 = 10",
          "desc": "double"
        },
        {
          "correct": true,
          "expr": "5 &times; 5 = 25",
          "desc": "halfway to 10"
        },
        {
          "correct": false,
          "expr": "3 &times; 5 = 16",
          "desc": "wrong"
        },
        {
          "correct": false,
          "expr": "5 &times; 0 = 5",
          "desc": "any &times; 0 = 0"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiplication is repeated addition. 5 &times; 4 means &lsquo;4 groups of 5&rsquo;. You can also think of it as &lsquo;5 groups of 4&rsquo; — the answer is the same.",
      "equation": "<span class=\"ov\">5</span> + <span class=\"ov\">5</span> + <span class=\"ov\">5</span> + <span class=\"ov\">5</span> = <span class=\"ovr\">5&times;4 = 20</span>",
      "caption": "Four groups of 5"
    }
  },
  "modelled_examples": [
