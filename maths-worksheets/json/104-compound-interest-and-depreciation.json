{
  "title": "PERCENTAGES,\n(COMPOUND INTEREST AND DEPRECIATION)",
  "objective": "LO: I can calculate compound interest and depreciation using repeated percentage change.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Compound interest and depreciation",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Compound interest</span> is earned on the original amount AND on previous interest. <span class=\"\u0001\">Depreciation</span> is when a value decreases by a fixed percentage each year."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Formula:</span> Final value = Original &times; (multiplier)&lt;sup&gt;n&lt;/sup&gt;, where n is the number of years."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "5% increase: multiply by 1.05",
          "desc": "compound growth multiplier"
        },
        {
          "correct": true,
          "expr": "10% depreciation: multiply by 0.90",
          "desc": "depreciation multiplier"
        },
        {
          "correct": true,
          "expr": "&pound;1000 at 3% for 2 years = 1000 &times; 1.03&sup2;",
          "desc": "compound formula"
        },
        {
          "correct": false,
          "expr": "5% for 3 years = 15% total",
          "desc": "that is simple interest"
        },
        {
          "correct": false,
          "expr": "10% depreciation for 10 years = worthless",
          "desc": "it never reaches zero"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Use the multiplier raised to the power of years. Growth: 1 + r. Depreciation: 1 - r.",
      "equation": "A = P &times; <span class=\"\u0001\">(1 + r)</span><span class=\"\u0001\"><sup>n</sup></span>",
      "caption": "P = principal, r = rate as decimal, n = years"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; compound interest",
      "question": "&pound;2000 is invested at 4% compound interest for 3 years. Find the final amount.",
      "steps": [
        "Multiplier = 1 + 0.04 = 1.04",
        "A = 2000 &times; 1.04&sup3;",
        "A = 2000 &times; 1.124864 = &pound;2249.73"
      ],
      "answer": "= &pound;2249.73",
      "explanation": "Multiply by the growth multiplier for each year."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; finding interest earned",
      "question": "&pound;5000 at 3% compound interest for 2 years. How much interest is earned?",
      "steps": [
        "A = 5000 &times; 1.03&sup2; = 5000 &times; 1.0609",
        "A = &pound;5304.50",
        "Interest = 5304.50 - 5000 = &pound;304.50"
      ],
      "answer": "= &pound;304.50 interest",
      "explanation": "Subtract the original to find just the interest."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; depreciation",
      "question": "A car worth &pound;12000 depreciates by 15% per year. Find its value after 4 years.",
      "steps": [
        "Multiplier = 1 - 0.15 = 0.85",
        "V = 12000 &times; 0.85&sup4;",
        "V = 12000 &times; 0.52200625 = &pound;6264.08"
      ],
      "answer": "= &pound;6264.08",
      "explanation": "Depreciation uses a multiplier less than 1."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; finding the rate",
      "question": "A painting increases from &pound;500 to &pound;605 in 2 years compound. Find the annual rate.",
      "steps": [
        "605 = 500 &times; r&sup2;, so r&sup2; = 1.21",
        "r = &radic;1.21 = 1.1",
        "Rate = 10% per year"
      ],
      "answer": "= 10% per year",
      "explanation": "Divide by the original, then take the nth root."
    }
  ],
