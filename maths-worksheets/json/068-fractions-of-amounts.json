{
  "title": "FRACTIONS ALL OPERATIONS,\n(FRACTIONS OF AMOUNTS)",
  "objective": "LO: I can find a fraction of a given amount by dividing and multiplying.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Finding a fraction of an amount",
      "content": [
        {
          "type": "paragraph",
          "text": "To find a <span class=\"\u0001\">fraction of an amount</span>, divide the amount by the <span class=\"\u0001\">denominator</span> then multiply by the numerator."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Method:</span> &frac{a}{b} of n = n &divide; b &times; a. Always divide first to keep numbers small."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&frac{1}{4} of 60 = 15",
          "desc": "60 &divide; 4 = 15"
        },
        {
          "correct": true,
          "expr": "&frac{2}{5} of 30 = 12",
          "desc": "30 &divide; 5 = 6, then 6 &times; 2"
        },
        {
          "correct": true,
          "expr": "&frac{3}{4} of 80 = 60",
          "desc": "80 &divide; 4 = 20, then 20 &times; 3"
        },
        {
          "correct": false,
          "expr": "&frac{2}{5} of 30 = 6",
          "desc": "forgot to multiply by numerator"
        },
        {
          "correct": false,
          "expr": "&frac{3}{4} of 80 = 240",
          "desc": "multiplied by both 3 and 4"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Divide by the denominator first to find one part, then multiply by the numerator to find the required number of parts.",
      "equation": "<span class=\"\u0001\">&frac{a}{b}</span> of n = n &divide; <span class=\"\u0001\">b</span> &times; a",
      "caption": "Divide by bottom, multiply by top"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; unit fraction",
      "question": "Find &frac{1}{5} of 45",
      "steps": [
        "Divide by the denominator: 45 &divide; 5",
        "= 9",
        "&frac{1}{5} of 45 = 9"
      ],
      "answer": "= 9",
      "explanation": "For unit fractions, just divide by the denominator."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; non-unit fraction",
      "question": "Find &frac{3}{4} of 60",
      "steps": [
        "Divide by 4: 60 &divide; 4 = 15",
        "Multiply by 3: 15 &times; 3 = 45",
        "&frac{3}{4} of 60 = 45"
      ],
      "answer": "= 45",
      "explanation": "Divide by the bottom number, multiply by the top number."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; fraction of money",
      "question": "Find &frac{2}{3} of &pound;18",
      "steps": [
        "Divide by 3: 18 &divide; 3 = 6",
        "Multiply by 2: 6 &times; 2 = 12",
        "&frac{2}{3} of &pound;18 = &pound;12"
      ],
      "answer": "= &pound;12",
      "explanation": "Same method works for money and measurements."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; finding the whole",
      "question": "&frac{3}{5} of a number is 24. Find the number.",
      "steps": [
        "If &frac{3}{5} = 24, find &frac{1}{5}: 24 &divide; 3 = 8",
        "Find the whole: 8 &times; 5 = 40",
        "The number is 40"
      ],
      "answer": "= 40",
      "explanation": "Divide by the numerator to find one part, then multiply by the denominator."
    }
  ],
