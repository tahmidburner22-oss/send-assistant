{
  "title": "FRACTIONS, DECIMALS AND PERCENTAGES,\n(COMPARING FRACTIONS, DECIMALS AND PERCENTAGES)",
  "objective": "LO: I can convert between fractions, decimals and percentages and compare their values.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Converting between forms",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Fractions</span>, <span class=\"ul-k\">decimals</span> and <span class=\"ul-k\">percentages</span> are three ways to express the same value. Convert to the same form to compare."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Key conversions:</span> Fraction &rarr; decimal: divide top by bottom. Decimal &rarr; %: multiply by 100. % &rarr; fraction: put over 100 and simplify."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Equivalents",
      "examples": [
        {
          "correct": true,
          "expr": "&frac{1}{2} = 0.5 = 50%",
          "desc": "half"
        },
        {
          "correct": true,
          "expr": "&frac{1}{4} = 0.25 = 25%",
          "desc": "quarter"
        },
        {
          "correct": true,
          "expr": "&frac{3}{10} = 0.3 = 30%",
          "desc": "three tenths"
        },
        {
          "correct": false,
          "expr": "&frac{1}{3} = 0.3 = 30%",
          "desc": "0.3 repeating, not 30%"
        },
        {
          "correct": false,
          "expr": "0.2 = 20 (not %)",
          "desc": "must write 20%"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "To compare, convert all values to the same form (usually decimals or percentages).",
      "equation": "<span class=\"ov\">Fraction</span> &rarr; &divide; &rarr; <span class=\"ov\">Decimal</span> &rarr; &times;100 &rarr; <span class=\"ovr\">%</span>",
      "caption": "Divide then multiply to convert right"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; fraction to decimal",
      "question": "Convert &frac{3}{8} to a decimal.",
      "steps": [
        "Divide numerator by denominator: 3 &divide; 8",
        "= 0.375",
        "So &frac{3}{8} = 0.375"
      ],
      "answer": "= 0.375",
      "explanation": "Fraction means numerator divided by denominator."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; decimal to percentage",
      "question": "Convert 0.45 to a percentage.",
      "steps": [
        "Multiply by 100",
        "0.45 &times; 100 = 45",
        "= 45%"
      ],
      "answer": "= 45%",
      "explanation": "Move the decimal point two places right."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; percentage to fraction",
      "question": "Convert 35% to a fraction in simplest form.",
      "steps": [
        "Write as &frac{35}{100}",
        "HCF of 35 and 100 is 5",
        "&frac{35}{100} = &frac{7}{20}"
      ],
      "answer": "= &frac{7}{20}",
      "explanation": "Always simplify by dividing by the HCF."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; ordering",
      "question": "Put in order: 0.6, &frac{5}{8}, 62%",
      "steps": [
        "Convert all to decimals: 0.6, 5&divide;8 = 0.625, 62% = 0.62",
        "Order: 0.6, 0.62, 0.625",
        "= 0.6, 62%, &frac{5}{8}"
      ],
      "answer": "0.6 &lt; 62% &lt; &frac{5}{8}",
      "explanation": "Converting to the same form makes comparison easy."
    }
  ],
