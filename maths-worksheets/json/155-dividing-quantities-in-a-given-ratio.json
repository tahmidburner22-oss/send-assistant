{
  "title": "RATIO AND PROPORTION,\n(DIVIDING QUANTITIES IN A GIVEN RATIO)",
  "objective": "LO: I can divide quantities in a given ratio and solve related problems.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Dividing quantities",
      "content": [
        {
          "type": "paragraph",
          "text": "To <span class=\"ul-b\">divide a quantity</span> in a ratio, add the parts to find the <span class=\"ul-k\">total number of shares</span>. Divide the quantity by this total to find <span class=\"ul-k\">one share</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Then:</span> Multiply each ratio number by the value of one share to find each portion."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "&pound;120 in 3:5 &rarr; shares = 8, one share = 15",
          "desc": "120 &divide; 8 = 15"
        },
        {
          "correct": true,
          "expr": "Result: &pound;45 and &pound;75",
          "desc": "3&times;15 and 5&times;15"
        },
        {
          "correct": true,
          "expr": "Check: 45 + 75 = 120 &check;",
          "desc": "always verify"
        },
        {
          "correct": false,
          "expr": "&pound;120 in 3:5 gives &pound;40 each",
          "desc": "not equal sharing"
        },
        {
          "correct": false,
          "expr": "Total shares for 3:5 is 15",
          "desc": "total shares = 3 + 5 = 8"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Total shares = sum of ratio. One share = quantity &divide; total shares. Each portion = ratio number &times; one share.",
      "equation": "<span class=\"ov\">Quantity</span> &divide; (a + b) = one share; portions = a &times; share, b &times; share",
      "caption": "Always check the portions add to the original"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; basic division",
      "question": "Divide 200 ml in the ratio 3:7.",
      "steps": [
        "Total shares = 3 + 7 = 10",
        "One share = 200 &divide; 10 = 20 ml",
        "3 shares = 60 ml, 7 shares = 140 ml"
      ],
      "answer": "60 ml and 140 ml",
      "explanation": "Check: 60 + 140 = 200 ml."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; money sharing",
      "question": "&pound;240 is shared between Amy and Bella in ratio 5:3. How much does each get?",
      "steps": [
        "Total shares = 5 + 3 = 8",
        "One share = 240 &divide; 8 = &pound;30",
        "Amy: 5 &times; 30 = &pound;150, Bella: 3 &times; 30 = &pound;90"
      ],
      "answer": "Amy &pound;150, Bella &pound;90",
      "explanation": "Check: 150 + 90 = 240."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; finding total from one part",
      "question": "Jo and Kim share sweets in ratio 2:5. Kim gets 35 sweets. How many in total?",
      "steps": [
        "Kim's 5 shares = 35",
        "One share = 35 &divide; 5 = 7",
        "Total = (2 + 5) &times; 7 = 49"
      ],
      "answer": "49 sweets total",
      "explanation": "Work backwards: divide the known amount by its share number."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; three-way split",
      "question": "Split 450 g into the ratio 2:3:4.",
      "steps": [
        "Total shares = 2 + 3 + 4 = 9",
        "One share = 450 &divide; 9 = 50 g",
        "Portions: 100 g, 150 g, 200 g"
      ],
      "answer": "100 g, 150 g, 200 g",
      "explanation": "Check: 100 + 150 + 200 = 450."
    }
  ],
