{
  "title": "RATIO AND PROPORTION,\n(DIVIDING QUANTITIES IN A GIVEN RATIO)",
  "objective": "LO: I can divide a quantity into two or more parts using a given ratio.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Dividing in a ratio",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Dividing in a ratio</span> means splitting a total into parts whose sizes follow the given <span class=\"ul-k\">ratio</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Steps:</span> Add the ratio parts to get the total number of shares. Divide the quantity by this total to get one share. Multiply each part of the ratio by the value of one share."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "£50 in ratio 2 : 3 = £20 and £30",
          "desc": "5 parts, £10 each"
        },
        {
          "correct": true,
          "expr": "120 in ratio 1 : 2 : 3 = 20, 40, 60",
          "desc": "6 parts, 20 each"
        },
        {
          "correct": true,
          "expr": "Check: shares must add to original total",
          "desc": "20 + 30 = 50 ✓"
        },
        {
          "correct": false,
          "expr": "£50 in ratio 2 : 3 = £25 and £25",
          "desc": "that is halving, not using the ratio"
        },
        {
          "correct": false,
          "expr": "£50 in ratio 2 : 3 = £2 and £3",
          "desc": "must multiply by value of one share"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Total shares = sum of ratio parts. Value of one share = quantity divided by total shares.",
      "equation": "<span class=\"ov\">one share</span> = quantity &divide; <span class=\"ovr\">(a + b)</span>",
      "caption": "Then multiply: a shares and b shares"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; two-part ratio",
      "question": "Divide £80 in the ratio 3 : 5",
      "steps": [
        "Total parts = 3 + 5 = 8",
        "One part = £80 &divide; 8 = £10",
        "3 parts = £30, 5 parts = £50"
      ],
      "answer": "£30 and £50",
      "explanation": "Check: £30 + £50 = £80."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; three-part ratio",
      "question": "Divide 180 cm in the ratio 2 : 3 : 4",
      "steps": [
        "Total parts = 2 + 3 + 4 = 9",
        "One part = 180 &divide; 9 = 20 cm",
        "Shares: 40 cm, 60 cm, 80 cm"
      ],
      "answer": "40 cm, 60 cm, 80 cm",
      "explanation": "Check: 40 + 60 + 80 = 180."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; working backwards",
      "question": "Two amounts in ratio 3 : 7 differ by £20. Find each amount.",
      "steps": [
        "Difference in parts = 7 - 3 = 4 parts",
        "4 parts = £20, so 1 part = £5",
        "3 parts = £15, 7 parts = £35"
      ],
      "answer": "£15 and £35",
      "explanation": "Use the difference when the total is not given."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; problem in context",
      "question": "Mortar is cement and sand in ratio 1 : 5. A builder needs 42 kg of mortar. Find the amounts.",
      "steps": [
        "Total parts = 1 + 5 = 6",
        "One part = 42 &divide; 6 = 7 kg",
        "Cement = 7 kg, Sand = 35 kg"
      ],
      "answer": "7 kg cement and 35 kg sand",
      "explanation": "Real-world ratios work exactly the same way."
    }
  ],
