{
  "title": "FRACTIONS, DECIMALS AND PERCENTAGES,\n(PERCENTAGE CHANGE)",
  "objective": "LO: I can calculate percentage increase, decrease and percentage change.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What is percentage change?",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Percentage change</span> measures how much a value has <span class=\"ul-k\">increased or decreased</span> as a percentage of the original."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Formula:</span> % change = (change &divide; original) &times; 100. Always divide by the ORIGINAL amount, not the new amount."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Examples",
      "examples": [
        {
          "correct": true,
          "expr": "£20 &rarr; £25 = +25%",
          "desc": "increase"
        },
        {
          "correct": true,
          "expr": "£40 &rarr; £30 = &minus;25%",
          "desc": "decrease"
        },
        {
          "correct": true,
          "expr": "10 &rarr; 12 = +20%",
          "desc": "(2&divide;10)&times;100"
        },
        {
          "correct": false,
          "expr": "£20 &rarr; £30 = +33%",
          "desc": "should be +50%"
        },
        {
          "correct": false,
          "expr": "Divide by NEW value",
          "desc": "always divide by ORIGINAL"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "% change = (new &minus; old) &divide; old &times; 100. Positive = increase, negative = decrease.",
      "equation": "<span class=\"ov\">change</span> &divide; <span class=\"ov\">original</span> &times; 100 = <span class=\"ovr\">% change</span>",
      "caption": "Always divide by ORIGINAL"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; increase",
      "question": "Price rises from £40 to £50. Find the % increase.",
      "steps": [
        "Change = 50 &minus; 40 = 10",
        "10 &divide; 40 = 0.25",
        "0.25 &times; 100 = 25%"
      ],
      "answer": "= 25% increase",
      "explanation": "Always divide the change by the ORIGINAL price (£40)."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; decrease",
      "question": "Population drops from 800 to 600. Find the % decrease.",
      "steps": [
        "Change = 800 &minus; 600 = 200",
        "200 &divide; 800 = 0.25",
        "0.25 &times; 100 = 25%"
      ],
      "answer": "= 25% decrease",
      "explanation": "The change is always positive; the &lsquo;decrease&rsquo; describes the direction."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; from amounts",
      "question": "A coat costs £80 in a sale. The original price was £100. % change?",
      "steps": [
        "Change = 80 &minus; 100 = &minus;20",
        "&minus;20 &divide; 100 = &minus;0.20",
        "&minus;0.20 &times; 100 = &minus;20%"
      ],
      "answer": "= 20% decrease",
      "explanation": "Negative answer means a decrease."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; growth",
      "question": "Plant grows from 12 cm to 18 cm. % growth?",
      "steps": [
        "Change = 18 &minus; 12 = 6",
        "6 &divide; 12 = 0.5",
        "0.5 &times; 100 = 50%"
      ],
      "answer": "= 50% growth",
      "explanation": "Divide the increase by the original (12 cm)."
    }
  ],
