{
  "title": "STATISTICS,\n(HISTOGRAMS)",
  "objective": "LO: I can draw and interpret histograms with unequal class widths using frequency density.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Histograms",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">histogram</span> displays continuous data using bars where the <span class=\"ul-k\">area</span> of each bar represents frequency. The y-axis shows <span class=\"ul-k\">frequency density</span>, not frequency."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Formula:</span> Frequency density = frequency &divide; class width. Frequency = frequency density &times; class width."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "FD = frequency &divide; class width",
          "desc": "frequency density formula"
        },
        {
          "correct": true,
          "expr": "Frequency = FD &times; class width",
          "desc": "reverse calculation"
        },
        {
          "correct": true,
          "expr": "Area of bar = frequency",
          "desc": "area represents count"
        },
        {
          "correct": false,
          "expr": "Height of bar = frequency",
          "desc": "height = frequency density"
        },
        {
          "correct": false,
          "expr": "All bars must be the same width",
          "desc": "widths can vary"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Frequency density = frequency &divide; class width. The AREA of each bar (not height) represents the frequency.",
      "equation": "FD = <span class=\"ov\">f</span> &divide; <span class=\"ovr\">w</span>",
      "caption": "f = frequency, w = class width"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; calculating frequency density",
      "question": "Class 10-20 has frequency 30. Find the frequency density.",
      "steps": [
        "Class width = 20 &minus; 10 = 10",
        "FD = frequency &divide; class width",
        "FD = 30 &divide; 10 = 3"
      ],
      "answer": "FD = 3",
      "explanation": "Divide frequency by class width."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; finding frequency from histogram",
      "question": "A bar has height (FD) 4 and width 5. Find the frequency.",
      "steps": [
        "Frequency = FD &times; width",
        "= 4 &times; 5",
        "= 20"
      ],
      "answer": "Frequency = 20",
      "explanation": "Multiply frequency density by class width to get frequency."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; completing a table",
      "question": "Class 0-10, frequency 15; class 10-30, frequency 40. Find FDs.",
      "steps": [
        "0-10: width = 10, FD = 15/10 = 1.5",
        "10-30: width = 20, FD = 40/20 = 2",
        "Draw bars at heights 1.5 and 2"
      ],
      "answer": "FD: 1.5 and 2",
      "explanation": "Different class widths give different frequency densities."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; estimating from histogram",
      "question": "A histogram bar covers 20-35 with FD = 2.4. Estimate the number in 20-25.",
      "steps": [
        "Total frequency for 20-35: 2.4 &times; 15 = 36",
        "Assume uniform: proportion in 20-25 = 5/15",
        "Estimate = 36 &times; 5/15 = 12"
      ],
      "answer": "Approximately 12",
      "explanation": "Assume data is evenly spread within each class for estimates."
    }
  ],
