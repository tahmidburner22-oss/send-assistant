{
  "title": "FUNCTIONS AND GRAPHS,\n(TRANSFORMATIONS OF GRAPHS)",
  "objective": "LO: I can describe and apply translations, reflections and stretches to graphs of functions.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Graph transformations",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"\u0001\">transformation</span> changes the position or shape of a graph. Key types: <span class=\"\u0001\">translations</span> (shifts), reflections (flips), and stretches (scaling)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"\u0001\">Notation:</span> f(x) + a shifts up, f(x + a) shifts left, -f(x) reflects in x-axis, f(-x) reflects in y-axis."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Transformation rules",
      "examples": [
        {
          "correct": true,
          "expr": "f(x) + 3 shifts the graph up 3",
          "desc": "vertical translation"
        },
        {
          "correct": true,
          "expr": "f(x - 2) shifts the graph right 2",
          "desc": "horizontal translation"
        },
        {
          "correct": true,
          "expr": "-f(x) reflects in the x-axis",
          "desc": "y-values change sign"
        },
        {
          "correct": false,
          "expr": "f(x + 2) shifts the graph right 2",
          "desc": "it shifts LEFT 2"
        },
        {
          "correct": false,
          "expr": "f(x) + 3 shifts the graph right 3",
          "desc": "it shifts UP 3"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Changes inside the bracket affect x (horizontal, opposite direction). Changes outside affect y (vertical, same direction).",
      "equation": "y = <span class=\"\u0001\">a</span>f(x + <span class=\"\u0001\">b</span>) + c",
      "caption": "a = vertical stretch, b = horizontal shift (opposite), c = vertical shift"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; vertical translation",
      "question": "Describe the transformation from y = x&sup2; to y = x&sup2; + 5",
      "steps": [
        "Compare: f(x) = x&sup2; and f(x) + 5",
        "The +5 is outside: vertical shift",
        "Translation 5 units up"
      ],
      "answer": "Translation by vector (0, 5)",
      "explanation": "Adding outside the function shifts the graph up."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; horizontal translation",
      "question": "Describe the transformation from y = x&sup2; to y = (x - 3)&sup2;",
      "steps": [
        "Compare: f(x) = x&sup2; and f(x - 3)",
        "The -3 is inside: horizontal shift",
        "Opposite direction: shift right 3"
      ],
      "answer": "Translation by vector (3, 0)",
      "explanation": "Inside the bracket, the shift is in the opposite direction."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; reflection in x-axis",
      "question": "Describe the transformation from y = x&sup3; to y = -x&sup3;",
      "steps": [
        "Compare: f(x) = x&sup3; and -f(x)",
        "The negative is outside: reflects in x-axis",
        "Every y-value changes sign"
      ],
      "answer": "Reflection in the x-axis",
      "explanation": "All positive y-values become negative and vice versa."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; vertical stretch",
      "question": "Describe the transformation from y = sin x to y = 3 sin x",
      "steps": [
        "Compare: f(x) = sin x and 3f(x)",
        "The 3 multiplies outside: vertical stretch",
        "Scale factor 3 in the y-direction"
      ],
      "answer": "Vertical stretch, scale factor 3",
      "explanation": "Every y-coordinate is multiplied by 3."
    }
  ],
