{
  "title": "FUNCTIONS AND GRAPHS,\n(TRANSFORMATIONS OF GRAPHS)",
  "objective": "LO: I can describe and apply translations and reflections to the graphs of functions.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Graph transformations",
      "content": [
        {
          "type": "paragraph",
          "text": "A <span class=\"ul-b\">translation</span> shifts a graph up, down, left or right. Adding a constant outside the function moves it <span class=\"ul-k\">vertically</span>; adding inside moves it <span class=\"ul-k\">horizontally</span> (in the opposite direction)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Reflections:</span> y = &minus;f(x) reflects in the x-axis; y = f(&minus;x) reflects in the y-axis."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Transformation rules",
      "examples": [
        {
          "correct": true,
          "expr": "y = f(x) + 3 shifts up 3",
          "desc": "vertical translation"
        },
        {
          "correct": true,
          "expr": "y = f(x &minus; 2) shifts right 2",
          "desc": "horizontal translation"
        },
        {
          "correct": true,
          "expr": "y = &minus;f(x) reflects in x-axis",
          "desc": "reflection"
        },
        {
          "correct": false,
          "expr": "y = f(x + 2) shifts right 2",
          "desc": "it shifts LEFT 2"
        },
        {
          "correct": false,
          "expr": "y = f(x) &minus; 3 shifts up 3",
          "desc": "it shifts DOWN 3"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Changes outside f(x) affect the y-values (vertical). Changes inside f(x) affect the x-values (horizontal, opposite direction).",
      "equation": "y = f(x <span class=\"ov\">&minus; a</span>) + <span class=\"ovr\">b</span>",
      "caption": "Shift right a, then up b"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; vertical translation",
      "question": "The graph of y = x&sup2; is translated up 5 units. Write the new equation.",
      "steps": [
        "Start with y = x&sup2;",
        "Add 5 outside: y = x&sup2; + 5",
        "Every point moves up 5"
      ],
      "answer": "y = x&sup2; + 5",
      "explanation": "Adding a constant outside shifts the graph vertically."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; horizontal translation",
      "question": "Describe the transformation from y = x&sup2; to y = (x &minus; 3)&sup2;.",
      "steps": [
        "Compare: x is replaced by (x &minus; 3)",
        "This is f(x &minus; 3) form",
        "Translation 3 units to the right"
      ],
      "answer": "Translation of 3 units to the right",
      "explanation": "Inside the bracket: subtract means move right."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; reflection in x-axis",
      "question": "Sketch y = &minus;x&sup2; given the graph of y = x&sup2;.",
      "steps": [
        "y = &minus;f(x) reflects in the x-axis",
        "Every y-value becomes its negative",
        "U-shape becomes an inverted U-shape"
      ],
      "answer": "Inverted parabola (reflected in x-axis)",
      "explanation": "All positive y-values become negative and vice versa."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; combined transformation",
      "question": "Describe the transformation from y = x&sup2; to y = (x + 1)&sup2; &minus; 4.",
      "steps": [
        "(x + 1) means shift left 1",
        "&minus; 4 means shift down 4",
        "Combined: translation (&minus;1, &minus;4)"
      ],
      "answer": "Translation of (&minus;1, &minus;4): left 1 and down 4",
      "explanation": "Apply horizontal shift first, then vertical shift."
    }
  ],
