  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Solving equations with brackets",
      "content": [
        {
          "type": "paragraph",
          "text": "When an equation contains <span class=\"ul-b\">brackets</span>, expand them first, then collect like terms and solve as normal. Remember to <span class=\"ul-k\">multiply every term inside</span> the bracket."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Expand all brackets, collect x terms on one side and numbers on the other, then divide."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "2(x + 3) = 10 &rArr; 2x + 6 = 10 &rArr; x = 2",
          "desc": "expand then solve"
        },
        {
          "correct": true,
          "expr": "3(2x &minus; 1) = 15 &rArr; 6x &minus; 3 = 15 &rArr; x = 3",
          "desc": "multiply both terms"
        },
        {
          "correct": true,
          "expr": "5(x + 2) = 3(x + 6) &rArr; 5x + 10 = 3x + 18 &rArr; x = 4",
          "desc": "brackets both sides"
        },
        {
          "correct": false,
          "expr": "2(x + 3) = 2x + 3",
          "desc": "must multiply both terms: 2x + 6"
        },
        {
          "correct": false,
          "expr": "3(2x &minus; 1) = 6x &minus; 1",
          "desc": "must multiply the &minus;1 too: 6x &minus; 3"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Expand all brackets first, then solve by collecting like terms.",
      "equation": "a(<span class=\"ov\">x + b</span>) = c &rArr; <span class=\"ovr\">ax + ab</span> = c",
      "caption": "Multiply every term inside by the number outside"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; single bracket",
      "question": "Solve 3(x + 4) = 21",
      "steps": [
        "Expand: 3x + 12 = 21",
        "Subtract 12: 3x = 9",
        "Divide by 3: x = 3"
      ],
      "answer": "x = 3",
      "explanation": "Expand first, then use inverse operations to isolate x."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; bracket with subtraction",
      "question": "Solve 4(2x &minus; 3) = 20",
      "steps": [
        "Expand: 8x &minus; 12 = 20",
        "Add 12: 8x = 32",
        "Divide by 8: x = 4"
      ],
      "answer": "x = 4",
      "explanation": "Remember to multiply the negative term too: 4 &times; (&minus;3) = &minus;12."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; brackets on both sides",
      "question": "Solve 5(x + 1) = 2(x + 7)",
      "steps": [
        "Expand both: 5x + 5 = 2x + 14",
        "Subtract 2x: 3x + 5 = 14",
        "Subtract 5: 3x = 9, x = 3"
      ],
      "answer": "x = 3",
      "explanation": "Expand both sides, then collect x terms together."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; negative outside bracket",
      "question": "Solve 10 &minus; 2(x + 3) = 0",
      "steps": [
        "Expand: 10 &minus; 2x &minus; 6 = 0",
        "Simplify: 4 &minus; 2x = 0",
        "2x = 4, x = 2"
      ],
      "answer": "x = 2",
      "explanation": "The negative sign multiplies both terms: &minus;2 &times; x = &minus;2x, &minus;2 &times; 3 = &minus;6."
    }
  ],
