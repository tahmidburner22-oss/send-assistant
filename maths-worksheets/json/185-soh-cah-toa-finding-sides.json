{
  "title": "TRIGONOMETRY,\n(SOH CAH TOA — FINDING SIDES)",
  "objective": "LO: I can use trigonometric ratios to find missing sides in right-angled triangles.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Finding sides",
      "content": [
        {
          "type": "paragraph",
          "text": "To find a missing <span class=\"ul-b\">side</span>, identify the angle and which sides are involved. Set up the equation using <span class=\"ul-k\">SOH CAH TOA</span> and solve."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Rearranging:</span> If the unknown is the numerator, multiply. If the denominator, divide."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "sin 40&deg; = x/10 &rarr; x = 10 sin 40&deg;",
          "desc": "opp = hyp &times; sin"
        },
        {
          "correct": true,
          "expr": "cos 35&deg; = x/8 &rarr; x = 8 cos 35&deg;",
          "desc": "adj = hyp &times; cos"
        },
        {
          "correct": true,
          "expr": "tan 50&deg; = 7/x &rarr; x = 7/tan 50&deg;",
          "desc": "adj = opp/tan"
        },
        {
          "correct": false,
          "expr": "sin 40&deg; = 10/x means x = 10 sin 40&deg;",
          "desc": "x = 10/sin 40"
        },
        {
          "correct": false,
          "expr": "Always multiply by the trig ratio",
          "desc": "divide if unknown is denominator"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Set up the ratio, then rearrange. Multiply if unknown is numerator, divide if denominator.",
      "equation": "O = H &times; <span class=\"ov\">sin &theta;</span> | A = H &times; <span class=\"ovr\">cos &theta;</span>",
      "caption": "SOH: O = H sin &theta; | CAH: A = H cos &theta; | TOA: O = A tan &theta;"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; finding opposite",
      "question": "Angle 35&deg;, hypotenuse = 12 cm. Find the opposite.",
      "steps": [
        "sin 35&deg; = x/12",
        "x = 12 &times; sin 35&deg;",
        "x = 12 &times; 0.574 = 6.9 cm"
      ],
      "answer": "x = 6.9 cm",
      "explanation": "Opposite = hypotenuse &times; sin(angle)."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; finding adjacent",
      "question": "Angle 42&deg;, hypotenuse = 15 cm. Find the adjacent.",
      "steps": [
        "cos 42&deg; = x/15",
        "x = 15 &times; cos 42&deg;",
        "x = 15 &times; 0.743 = 11.1 cm"
      ],
      "answer": "x = 11.1 cm",
      "explanation": "Adjacent = hypotenuse &times; cos(angle)."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; finding hypotenuse",
      "question": "Angle 30&deg;, opposite = 8 cm. Find the hypotenuse.",
      "steps": [
        "sin 30&deg; = 8/h",
        "h = 8/sin 30&deg;",
        "h = 8/0.5 = 16 cm"
      ],
      "answer": "h = 16 cm",
      "explanation": "When the unknown is the denominator, divide."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; using tan",
      "question": "Angle 55&deg;, adjacent = 6 cm. Find the opposite.",
      "steps": [
        "tan 55&deg; = x/6",
        "x = 6 &times; tan 55&deg;",
        "x = 6 &times; 1.428 = 8.6 cm"
      ],
      "answer": "x = 8.6 cm",
      "explanation": "Opposite = adjacent &times; tan(angle)."
    }
  ],
