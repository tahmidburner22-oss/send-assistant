{
  "title": "TRIGONOMETRY,\n(SOH CAH TOA FINDING SIDES)",
  "objective": "LO: I can use trigonometric ratios to find unknown side lengths in right-angled triangles.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Finding sides with trigonometry",
      "content": [
        {
          "type": "paragraph",
          "text": "To find an <span class=\"ul-b\">unknown side</span>, label the sides (O, A, H) relative to the given angle, then use the appropriate ratio: <span class=\"ul-k\">SOH, CAH, or TOA</span>."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Rearrange:</span> If the unknown is in the denominator, rearrange the formula or use the triangle method."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "hyp = 10, angle = 30°: opp = 10 sin 30° = 5",
          "desc": "multiply hyp by sin"
        },
        {
          "correct": true,
          "expr": "adj = 6, angle = 45°: opp = 6 tan 45° = 6",
          "desc": "multiply adj by tan"
        },
        {
          "correct": true,
          "expr": "opp = 8, angle = 30°: hyp = 8 &divide; sin 30° = 16",
          "desc": "divide by sin"
        },
        {
          "correct": false,
          "expr": "opp = hyp &divide; sinθ",
          "desc": "opp = hyp &times; sinθ"
        },
        {
          "correct": false,
          "expr": "sin 30° = adj/hyp",
          "desc": "sin = opp/hyp, cos = adj/hyp"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Label sides O, A, H. Choose the ratio involving the known side and the unknown side. Rearrange to find the unknown.",
      "equation": "opp = <span class=\"ov\">hyp</span> &times; <span class=\"ovr\">sin θ</span>",
      "caption": "Similarly: adj = hyp &times; cosθ, opp = adj &times; tanθ"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; finding the opposite",
      "question": "Angle = 30°, hypotenuse = 12. Find the opposite.",
      "steps": [
        "Need opp, have hyp and angle: use sin",
        "sin 30° = opp/12",
        "opp = 12 &times; sin 30° = 12 &times; 0.5 = 6"
      ],
      "answer": "opp = 6",
      "explanation": "Multiply the hypotenuse by sin of the angle."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; finding the adjacent",
      "question": "Angle = 60°, hypotenuse = 10. Find the adjacent.",
      "steps": [
        "Need adj, have hyp: use cos",
        "cos 60° = adj/10",
        "adj = 10 &times; cos 60° = 10 &times; 0.5 = 5"
      ],
      "answer": "adj = 5",
      "explanation": "Multiply hypotenuse by cos."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; finding the hypotenuse",
      "question": "Angle = 45°, opposite = 7. Find the hypotenuse.",
      "steps": [
        "sin 45° = 7/hyp",
        "hyp = 7 &divide; sin 45°",
        "hyp = 7 &divide; (&frac{&radic;2}{2}) = 7&radic;2 = 9.9 (1 dp)"
      ],
      "answer": "hyp = 7&radic;2 ≈ 9.9",
      "explanation": "When the unknown is the denominator, divide."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; using tan",
      "question": "Angle = 40°, adjacent = 8. Find the opposite (1 dp).",
      "steps": [
        "tan 40° = opp/8",
        "opp = 8 &times; tan 40°",
        "= 8 &times; 0.839 = 6.7"
      ],
      "answer": "opp = 6.7",
      "explanation": "Use tan when you have opposite and adjacent."
    }
  ],
