      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; single multiplication",
      "question": "Calculate 5 &times; 2",
      "steps": [
        "5 groups of 2",
        "2 + 2 + 2 + 2  ...",
        "= 10"
      ],
      "answer": "= 10",
      "explanation": "Skip-count in 2s 5 times to reach 10."
    },
