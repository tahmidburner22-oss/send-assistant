{
  "title": "MULTIPLICATION,\n(TWO TIMES TABLE)",
  "objective": "LO: I can recall and use the 2 times table to multiply and divide.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "What is the 2 times table?",
      "content": [
        {
          "type": "paragraph",
          "text": "The <span class=\"ul-b\">2 times table</span> is a list of <span class=\"ul-k\">multiples</span> of 2: numbers we get when we count in 2s. Numbers in the 2 times table are always even."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Skip-count in 2s on your fingers, or use a number line. Each jump adds 2."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Multiples of 2",
      "examples": [
        {
          "correct": true,
          "expr": "1 &times; 2 = 2",
          "desc": "starting point"
        },
        {
          "correct": true,
          "expr": "2 &times; 2 = 4",
          "desc": "double"
        },
        {
          "correct": true,
          "expr": "5 &times; 2 = 10",
          "desc": "halfway to 10"
        },
        {
          "correct": false,
          "expr": "3 &times; 2 = 7",
          "desc": "wrong"
        },
        {
          "correct": false,
          "expr": "2 &times; 0 = 2",
          "desc": "any &times; 0 = 0"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiplication is repeated addition. 2 &times; 4 means &lsquo;4 groups of 2&rsquo;. You can also think of it as &lsquo;2 groups of 4&rsquo; — the answer is the same.",
      "equation": "<span class=\"ov\">2</span> + <span class=\"ov\">2</span> + <span class=\"ov\">2</span> + <span class=\"ov\">2</span> = <span class=\"ovr\">2&times;4 = 8</span>",
      "caption": "Four groups of 2"
    }
  },
  "modelled_examples": [
