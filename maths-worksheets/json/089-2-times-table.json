      "steps": [
        "How many 2s in 8?",
        "Count up: 2, 4, 6, ...",
        "= 4"
      ],
      "answer": "= 4",
      "explanation": "Divide: 8 &divide; 2 = 4."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; division by sharing",
