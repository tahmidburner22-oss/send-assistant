{
  "title": "STANDARD FORM,\n(CALCULATIONS IN STANDARD FORM)",
  "objective": "LO: I can add, subtract, multiply and divide numbers in standard form.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Calculating with standard form",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Standard form</span> is written as A &times; 10<sup>n</sup> where 1 &le; A &lt; 10 and n is an integer. To <span class=\"ul-k\">multiply or divide</span>, use index laws on the powers of 10."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> For multiplication/division, deal with the A values and powers of 10 separately. For addition/subtraction, convert to the same power of 10 first."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "(3 &times; 10&sup2;) &times; (2 &times; 10&sup3;) = 6 &times; 10<sup>5</sup>",
          "desc": "multiply A values, add powers"
        },
        {
          "correct": true,
          "expr": "(8 &times; 10<sup>6</sup>) &divide; (4 &times; 10&sup2;) = 2 &times; 10<sup>4</sup>",
          "desc": "divide A values, subtract powers"
        },
        {
          "correct": true,
          "expr": "(4 &times; 10&sup3;) + (3 &times; 10&sup3;) = 7 &times; 10&sup3;",
          "desc": "same power, add A values"
        },
        {
          "correct": false,
          "expr": "(3 &times; 10&sup2;) &times; (2 &times; 10&sup3;) = 6 &times; 10<sup>6</sup>",
          "desc": "powers add, not multiply"
        },
        {
          "correct": false,
          "expr": "(4 &times; 10&sup3;) + (3 &times; 10&sup2;) = 7 &times; 10&sup3;",
          "desc": "must match powers first"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Multiply/divide: deal with A and 10^n separately. Add/subtract: match the powers of 10 first.",
      "equation": "(a &times; 10<sup>m</sup>) &times; (b &times; 10<sup>n</sup>) = <span class=\"ov\">ab</span> &times; <span class=\"ovr\">10<sup>m+n</sup></span>",
      "caption": "Multiply A values, add indices"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; multiplication",
      "question": "Calculate (4 &times; 10&sup3;) &times; (2 &times; 10<sup>5</sup>)",
      "steps": [
        "Multiply A values: 4 &times; 2 = 8",
        "Add powers: 3 + 5 = 8",
        "Answer: 8 &times; 10<sup>8</sup>"
      ],
      "answer": "8 &times; 10<sup>8</sup>",
      "explanation": "Multiply the numbers, add the indices."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; division",
      "question": "Calculate (9 &times; 10<sup>7</sup>) &divide; (3 &times; 10&sup3;)",
      "steps": [
        "Divide A values: 9 &divide; 3 = 3",
        "Subtract powers: 7 &minus; 3 = 4",
        "Answer: 3 &times; 10<sup>4</sup>"
      ],
      "answer": "3 &times; 10<sup>4</sup>",
      "explanation": "Divide the numbers, subtract the indices."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; adjusting after multiplication",
      "question": "Calculate (6 &times; 10<sup>4</sup>) &times; (5 &times; 10&sup3;)",
      "steps": [
        "Multiply A values: 6 &times; 5 = 30",
        "Add powers: 4 + 3 = 7, so 30 &times; 10<sup>7</sup>",
        "Adjust: 30 = 3 &times; 10, so 3 &times; 10<sup>8</sup>"
      ],
      "answer": "3 &times; 10<sup>8</sup>",
      "explanation": "If A &ge; 10, adjust by increasing the power of 10."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; addition",
      "question": "Calculate (5.2 &times; 10<sup>4</sup>) + (3.1 &times; 10&sup3;)",
      "steps": [
        "Convert: 3.1 &times; 10&sup3; = 0.31 &times; 10<sup>4</sup>",
        "Add: 5.2 + 0.31 = 5.51",
        "Answer: 5.51 &times; 10<sup>4</sup>"
      ],
      "answer": "5.51 &times; 10<sup>4</sup>",
      "explanation": "Match the powers of 10 before adding the A values."
    }
  ],
