{
  "title": "SIMULTANEOUS EQUATIONS,\n(NON-LINEAR SIMULTANEOUS EQUATIONS)",
  "objective": "LO: I can solve simultaneous equations where one equation is linear and one is quadratic.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Non-linear simultaneous equations",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Non-linear simultaneous equations</span> involve one linear equation and one equation with a <span class=\"ul-k\">squared term</span> (e.g. circle or quadratic). Use substitution to solve."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Strategy:</span> Rearrange the linear equation to make one variable the subject, substitute into the quadratic, then solve."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "y = x + 1 and x&sup2; + y&sup2; = 5: substitute y",
          "desc": "circle and line"
        },
        {
          "correct": true,
          "expr": "y = 2x and y = x&sup2; &minus; 3: set equal",
          "desc": "parabola and line"
        },
        {
          "correct": true,
          "expr": "Usually gives two pairs of solutions",
          "desc": "line crosses curve twice"
        },
        {
          "correct": false,
          "expr": "Use elimination for non-linear equations",
          "desc": "must use substitution"
        },
        {
          "correct": false,
          "expr": "Non-linear systems always have exactly 2 solutions",
          "desc": "can have 0, 1, or 2"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Substitute the linear equation into the quadratic to get a single equation in one variable. Then solve the resulting quadratic.",
      "equation": "y = x + 1; x&sup2; + <span class=\"ov\">y&sup2;</span> = 5 &rArr; x&sup2; + <span class=\"ovr\">(x+1)&sup2;</span> = 5",
      "caption": "Replace y with the linear expression, then solve"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; line and circle",
      "question": "Solve y = x + 1 and x&sup2; + y&sup2; = 5",
      "steps": [
        "Substitute: x&sup2; + (x+1)&sup2; = 5 &rArr; x&sup2; + x&sup2; + 2x + 1 = 5",
        "2x&sup2; + 2x &minus; 4 = 0 &rArr; x&sup2; + x &minus; 2 = 0 &rArr; (x+2)(x&minus;1) = 0",
        "x = &minus;2, y = &minus;1 or x = 1, y = 2"
      ],
      "answer": "(&minus;2, &minus;1) and (1, 2)",
      "explanation": "Find x values from the quadratic, then substitute back for y."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; line and parabola",
      "question": "Solve y = 2x + 1 and y = x&sup2; &minus; 2",
      "steps": [
        "Set equal: x&sup2; &minus; 2 = 2x + 1",
        "x&sup2; &minus; 2x &minus; 3 = 0 &rArr; (x&minus;3)(x+1) = 0",
        "x = 3, y = 7 or x = &minus;1, y = &minus;1"
      ],
      "answer": "(3, 7) and (&minus;1, &minus;1)",
      "explanation": "When both equations equal y, set the right-hand sides equal."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; substitution approach",
      "question": "Solve x + y = 5 and xy = 6",
      "steps": [
        "From linear: y = 5 &minus; x",
        "Substitute: x(5&minus;x) = 6 &rArr; 5x &minus; x&sup2; = 6 &rArr; x&sup2; &minus; 5x + 6 = 0",
        "(x&minus;2)(x&minus;3) = 0: x = 2, y = 3 or x = 3, y = 2"
      ],
      "answer": "(2, 3) and (3, 2)",
      "explanation": "Rearrange the linear equation for one variable, then substitute."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; one solution",
      "question": "Solve y = 2x &minus; 1 and y = x&sup2; &minus; 2x + 2",
      "steps": [
        "Set equal: x&sup2; &minus; 2x + 2 = 2x &minus; 1",
        "x&sup2; &minus; 4x + 3 = 0 &rArr; (x&minus;1)(x&minus;3) = 0",
        "x = 1, y = 1 or x = 3, y = 5"
      ],
      "answer": "(1, 1) and (3, 5)",
      "explanation": "Check each solution satisfies both original equations."
    }
  ],
