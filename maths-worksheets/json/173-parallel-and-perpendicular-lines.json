      "steps": [
        "Original gradient m = 4",
        "Negative reciprocal: -&frac{1}{4}",
        "Perpendicular gradient = -&frac{1}{4}"
      ],
      "answer": "m = -&frac{1}{4}",
      "explanation": "Flip the fraction and change the sign."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; equation of parallel line",
      "question": "Find the line parallel to y = 2x + 3 through (1, 5).",
      "steps": [
        "Parallel means same gradient: m = 2",
        "y = 2x + c, substitute (1, 5): 5 = 2(1) + c",
        "c = 3, equation: y = 2x + 3"
      ],
      "answer": "y = 2x + 3",
      "explanation": "Use the same gradient and find c from the given point."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; equation of perpendicular line",
      "question": "Find the line perpendicular to y = 3x - 1 through (6, 2).",
      "steps": [
        "Original gradient = 3, perpendicular = -&frac{1}{3}",
        "y = -&frac{1}{3}x + c, substitute (6, 2): 2 = -2 + c",
        "c = 4, equation: y = -&frac{1}{3}x + 4"
      ],
      "answer": "y = -&frac{1}{3}x + 4",
      "explanation": "Use the negative reciprocal gradient and substitute the point."
    }
  ],
