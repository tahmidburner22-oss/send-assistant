{
  "title": "STRAIGHT-LINE GRAPHS,\n(PARALLEL AND PERPENDICULAR LINES)",
  "objective": "LO: I can identify and find equations of parallel and perpendicular lines.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Parallel and perpendicular",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Parallel lines</span> have the <span class=\"ul-k\">same gradient</span>. They never meet. <span class=\"ul-b\">Perpendicular lines</span> meet at right angles (90&deg;)."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Key rule:</span> If one line has gradient m, a perpendicular line has gradient <span class=\"ul-k\">&minus;1/m</span> (negative reciprocal). The product of their gradients is &minus;1."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "y = 2x + 1 and y = 2x &minus; 3 are parallel",
          "desc": "same gradient"
        },
        {
          "correct": true,
          "expr": "m&sub1; &times; m&sub2; = &minus;1 for perpendicular",
          "desc": "product rule"
        },
        {
          "correct": true,
          "expr": "gradient 3 &rarr; perpendicular gradient &minus;&frac{1}{3}",
          "desc": "negative reciprocal"
        },
        {
          "correct": false,
          "expr": "y = 2x + 1 and y = &minus;2x + 3 are perpendicular",
          "desc": "2 &times; (&minus;2) = &minus;4 &ne; &minus;1"
        },
        {
          "correct": false,
          "expr": "Parallel lines have gradients that multiply to &minus;1",
          "desc": "that is perpendicular"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Parallel: same gradient. Perpendicular: gradients multiply to give &minus;1 (negative reciprocal).",
      "equation": "m&sub1; &times; m&sub2; = <span class=\"ov\">&minus;1</span> &rarr; m&sub2; = <span class=\"ovr\">&minus;1/m&sub1;</span>",
      "caption": "Perpendicular gradients are negative reciprocals"
    }
  },
  "modelled_examples": [
    {
      "id": "ex1",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 1 &ndash; parallel lines",
      "question": "Find the equation of the line parallel to y = 3x + 2 passing through (1, 7).",
      "steps": [
        "Parallel means same gradient: m = 3",
        "y = 3x + c; substitute (1, 7): 7 = 3 + c, c = 4",
        "Equation: y = 3x + 4"
      ],
      "answer": "y = 3x + 4",
      "explanation": "Parallel lines share the same gradient."
    },
    {
      "id": "ex2",
      "card_color": "#1F5FA6",
      "card_bg": "#EEF3FF",
      "label": "Example 2 &ndash; perpendicular gradient",
      "question": "A line has gradient 4. Find the gradient of a perpendicular line.",
      "steps": [
        "Perpendicular gradient = &minus;1/m",
        "&minus;1/4",
        "The perpendicular gradient is &minus;&frac{1}{4}"
      ],
      "answer": "Gradient = &minus;&frac{1}{4}",
      "explanation": "Flip the fraction and change the sign."
    },
    {
      "id": "ex3",
      "card_color": "#CC0000",
      "card_bg": "#FFF0F0",
      "label": "Example 3 &ndash; perpendicular equation",
      "question": "Find the equation perpendicular to y = 2x &minus; 5 through (4, 3).",
      "steps": [
        "Original gradient = 2; perpendicular = &minus;&frac{1}{2}",
        "y = &minus;&frac{1}{2}x + c; 3 = &minus;&frac{1}{2}(4) + c; 3 = &minus;2 + c; c = 5",
        "y = &minus;&frac{1}{2}x + 5"
      ],
      "answer": "y = &minus;&frac{1}{2}x + 5",
      "explanation": "Find the perpendicular gradient, then use the point to find c."
    },
    {
      "id": "ex4",
      "card_color": "#1E7D2E",
      "card_bg": "#EDFAEE",
      "label": "Example 4 &ndash; checking perpendicular",
      "question": "Are y = 3x + 1 and y = &minus;&frac{1}{3}x + 4 perpendicular?",
      "steps": [
        "m&sub1; = 3, m&sub2; = &minus;&frac{1}{3}",
        "Product = 3 &times; (&minus;&frac{1}{3}) = &minus;1",
        "Yes, they are perpendicular"
      ],
      "answer": "Yes (product of gradients = &minus;1)",
      "explanation": "If m&sub1; &times; m&sub2; = &minus;1, the lines are perpendicular."
    }
  ],
