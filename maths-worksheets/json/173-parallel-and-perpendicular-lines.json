{
  "title": "STRAIGHT-LINE GRAPHS,\n(PARALLEL AND PERPENDICULAR LINES)",
  "objective": "LO: I can identify and find equations of parallel and perpendicular lines.",
  "send_mode": false,
  "info_boxes": {
    "key_terms": {
      "id": "key_terms",
      "title": "Parallel and perpendicular lines",
      "content": [
        {
          "type": "paragraph",
          "text": "<span class=\"ul-b\">Parallel lines</span> have the same gradient (m₁ = m₂). <span class=\"ul-k\">Perpendicular lines</span> have gradients that multiply to give -1."
        },
        {
          "type": "paragraph",
          "text": "<span class=\"rb\">Key rule:</span> If one line has gradient m, a perpendicular line has gradient -&frac{1}{m} (the negative reciprocal)."
        }
      ]
    },
    "what_we_learn": {
      "id": "what_we_learn",
      "title": "Quick examples",
      "examples": [
        {
          "correct": true,
          "expr": "y = 2x + 1 and y = 2x - 3 are parallel",
          "desc": "same gradient m = 2"
        },
        {
          "correct": true,
          "expr": "y = 3x and y = -&frac{1}{3}x are perpendicular",
          "desc": "3 &times; -&frac{1}{3} = -1"
        },
        {
          "correct": true,
          "expr": "Negative reciprocal of 4 is -&frac{1}{4}",
          "desc": "flip and negate"
        },
        {
          "correct": false,
          "expr": "y = 2x + 1 and y = -2x + 3 are parallel",
          "desc": "gradients are 2 and -2, not equal"
        },
        {
          "correct": false,
          "expr": "Perpendicular to gradient 3 is &frac{1}{3}",
          "desc": "must be -&frac{1}{3}"
        }
      ]
    },
    "key_idea": {
      "id": "key_idea",
      "title": "Key idea",
      "text": "Parallel: same gradient. Perpendicular: gradients multiply to -1.",
      "equation": "m₁ &times; m₂ = <span class=\"ov\">-1</span> &rArr; m₂ = <span class=\"ovr\">-&frac{1}{m₁}</span>",
      "caption": "Negative reciprocal for perpendicular lines"
    }
  },
  "modelled_examples": [
