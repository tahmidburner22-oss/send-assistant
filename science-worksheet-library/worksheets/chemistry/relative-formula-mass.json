        { "wrong": "Mᵣ has units of grams.", "right": "Relative masses have no units." },
        { "wrong": "Ignore the number after a bracket.", "right": "Multiply everything in the bracket by it." },
        { "wrong": "Mᵣ = number of atoms.", "right": "Mᵣ = sum of the atomic masses." }
      ]
    },
    {
      "type": "worked-example",
      "title": "WORKED EXAMPLE: Ca(OH)₂",
      "workedSteps": [
        "Aᵣ: Ca = 40, O = 16, H = 1.",
        "Ca = 40; (OH)₂ = 2×(16+1).",
        "= 40 + 2×17",
        "!Mᵣ = 40 + 34 = 74"
      ]
    }
