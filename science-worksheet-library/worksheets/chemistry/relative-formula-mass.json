      "vocab": [
        { "term": "Relative atomic mass (Aᵣ)", "definition": "the average mass of an atom compared to ¹²C." },
        { "term": "Relative formula mass (Mᵣ)", "definition": "the sum of the Aᵣ of all atoms in a formula." },
        { "term": "Subscript", "definition": "the small number showing how many atoms." },
        { "term": "Bracket", "definition": "multiplies everything inside it by the number after it." }
      ]
    },
    {
