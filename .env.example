# SEND Assistant — Environment Variables
# Copy this to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
APP_URL=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite file path (relative to project root)
DB_PATH=./data/send-assistant.db

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave blank in development — emails will be logged to console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=SEND Assistant <noreply@yourdomain.com>

# ── Google OAuth (optional — for Google Sign-In) ──────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Frontend API base URL ─────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001


# ── LTI 1.3 (optional — for LMS integration) ─────────────────────────────────
# RSA key pair for signing/verifying LTI JWTs. Generate with:
#   openssl genpkey -algorithm RSA -out lti-private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in lti-private.pem -pubout -out lti-public.pem
# Paste the full PEM contents with \n for line breaks:
LTI_PRIVATE_KEY_PEM=
LTI_PUBLIC_KEY_PEM=
LTI_KEY_ID=adaptly-lti-1

# JSON array of platform configs, e.g.:
# [{"issuer":"https://canvas.instructure.com","clientId":"10000000000001","authEndpoint":"https://canvas.instructure.com/api/lti/authorize_redirect","jwksUri":"https://canvas.instructure.com/api/lti/security/jwks","tokenEndpoint":"https://canvas.instructure.com/login/oauth2/token"}]
LTI_PLATFORMS=
